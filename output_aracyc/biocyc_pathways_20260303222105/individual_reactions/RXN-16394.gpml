    </DataNode>
    <DataNode elementId="AT4G00360-MONOMER" textLabel="Cytochrome P450 86A2" type="Protein">
      <Xref identifier="AT4G00360-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">CYP86A2 is involved in cutin biosynthesis. The Arabidopsis CYP86A2 mutant plants had an altered leaf cuticle structure. Cutin content in inflorescence stems was reduced by 70% in the mutants, when compared to wild type plants |CITS: [15241470]|. Microsome fractions of insect cells expressing CYP86A2 was shown to hydroxylate oleate |CITS: [17427946]|. Palmitate was not tested as a substrate in the assay.</Comment>
      <Property key="UniqueID" value="AT4G00360-MONOMER" />
      <Property key="Synonym_1" value="ABERRANT INDUCTION OF TYPE THREE 1" />
      <Property key="Catalyzes" value="RXN-33843, RXN-12857" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT4G00360.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT4G00360" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_15241470" />
      <CitationRef elementRef="citation_PUB_17427946" />
    </DataNode>
