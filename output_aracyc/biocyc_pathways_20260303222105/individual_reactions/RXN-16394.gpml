      <CitationRef elementRef="citation_PUB_19700560" />
    </DataNode>
    <DataNode elementId="AT3G48520-MONOMER" textLabel="jasmonoyl-isoleucine-12-hydroxylase" type="Protein">
      <Xref identifier="Q9SMP5" dataSource="uniprot" />
      <Graphics centerX="450" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup, PMN, dreher">CYP94B3 is a jasmonoyl-isoleucine-12-hydroxylase that catalyzes the formation of |FRAME: CPD-13420 12-hydroxyjasmonoyl-isoleucine| (12-OH-JA-Ile) from |FRAME: Jasmonoyl-Isoleucines jasmonoyl-isoleucine| (JA-Ile). The enzymatic activity of this protein has been demonstrated by heterologous expression in yeast microsomes. Furthermore, a &lt;i&gt;cyp94b3-1&lt;/i&gt; Arabidopsis mutant accumulates elevated levels of |FRAME: Jasmonoyl-Isoleucines JA-Ile| and reduced levels of |FRAME: CPD-13420 12-OH-JA-Ile| |CITS: [21516464]|. By reducing the levels of this the biologically active phytohormone, CYP94B3 attenuates the jasmonic acid signaling cascade. Notably, CYP94B3 transcript levels rise in response to wounding suggesting that CYP94B3 might be part of a negative feedback control pathway. In accordance with this model, plants over-expressing CYP94B3 have several phenotypes indicative of reduced jasmonic acid levels, such as reduced pollen viability, aberrant flower and silique development, and increased susceptibility to a generalist insect (&lt;i&gt;Spodoptera exigua&lt;/i&gt;) |CITS: [21516464]|. However, |FRAME: CPD-13420 12-OH-JA-Ile| can still promote some binding of COI1 to JAZ repressor proteins, which should activate the JA signaling cascade. These findings indicate that |FRAME: CPD-13420 12-OH-JA-Ile| may play a complex role in mediating jasmonate-releated responses |CITS: [21516464]|.</Comment>
      <Property key="UniqueID" value="AT3G48520-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G48520.1" />
      <Property key="AlternativeId_Smr" value="Q9SMP5" />
      <Property key="AlternativeId_Prints" value="PR00385" />
      <Property key="AlternativeId_Pride" value="Q9SMP5" />
      <Property key="AlternativeId_Interpro" value="IPR036396" />
      <Property key="AlternativeId_Pfam" value="PF00067" />
      <Property key="AlternativeId_Phylomedb" value="Q9SMP5" />
      <Property key="AlternativeId_Uniprot" value="Q9SMP5" />
      <Property key="Synonym_1" value="jasmonoyl-isoleucine-12-hydroxylase" />
      <Property key="Synonym_2" value="CYP94B3" />
      <Property key="Synonym_3" value="JA-Ile-12-hydroxylase" />
      <Property key="Catalyzes" value="RXN-33826, RXN-25542, RXN-19234" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT3G48520.1" />
      <Property key="Gene" value="AT3G48520" />
