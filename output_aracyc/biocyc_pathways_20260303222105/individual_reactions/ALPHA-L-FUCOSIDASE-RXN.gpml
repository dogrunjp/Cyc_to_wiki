    <DataNode elementId="AT2G28100-MONOMER" textLabel="AT2G28100-MONOMER" type="Protein">
      <Xref identifier="Q8GW72" dataSource="uniprot" />
      <Graphics centerX="450" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;FUC1&lt;/i&gt; encodes a protein with &amp;alpha;-fucosidase activity. The protein was heterologously expressed in &lt;i&gt;Pichia pastoris&lt;/i&gt; where its activity was assessed on 2&apos;-fucosyl-lactitol. AtFUC1 was not able to act on XXFG substrates, at least when heterologously expressed in &lt;i&gt;Pichia pastoris&lt;/i&gt;. The enzyme has been postulated to act on fucosylated substrates other than xyloglucan oligosaccharides |CITS:[11788770]|.</Comment>
      <Property key="UniqueID" value="AT2G28100-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G28100.1" />
      <Property key="AlternativeId_Pid" value="NP_180377" />
      <Property key="AlternativeId_Uniprot" value="Q8GW72" />
      <Property key="Synonym_1" value="&amp;alpha;-L-fucosidase" />
      <Property key="Catalyzes" value="RXN-12218" />
      <Property key="Accession1" value="AT2G28100.1" />
      <Property key="Gene" value="AT2G28100" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Pi" value="5.2" />
      <CitationRef elementRef="citation_PUB_11788770" />
    </DataNode>
    <DataNode elementId="AT1G67830-MONOMER" textLabel="AT1G67830-MONOMER" type="Protein">
      <Xref identifier="Q9FXE5" dataSource="uniprot" />
      <Graphics centerX="600" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;FXG1&lt;/i&gt; encodes a protein with &amp;alpha;-fucosidase activity. The protein was heterologously expressed in &lt;i&gt;Pichia pastoris&lt;/i&gt; where its activity was assessed on 2&apos;-fucosyl-lactitol. AtFXG1 was able to remove the t-fucosyl residues of XXFG xyloglucan oligosaccharides |CITS:[11788770]|.</Comment>
      <Property key="UniqueID" value="AT1G67830-MONOMER" />
