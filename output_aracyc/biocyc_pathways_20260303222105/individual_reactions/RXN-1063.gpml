    <DataNode elementId="AT1G01600-MONOMER" textLabel="Cytochrome P450 86A4" type="Protein">
      <Xref identifier="AT1G01600-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="355" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">CYP86A4 is highly expressed in flowers and is involved in cutin biosynthesis in flower tissues. Flower cutin monomer content of mutant plants had a 45-58% reduction in 16-hydroxypalmitate, 10,16-dihydroxypalmitate, and 1,16-hexadecanedioic acid |CITS: [19959665]|. Microsome fractions of insect cells expressing CYP86A4 was shown to hydroxylate oleate |CITS: [17427946]|. Palmitate was not tested as a substrate in the assay.</Comment>
      <Property key="UniqueID" value="AT1G01600-MONOMER" />
      <Property key="Synonym_1" value="CYP86A4" />
      <Property key="Synonym_2" value="fatty acid (omega-1)-hydroxylase" />
      <Property key="Catalyzes" value="RXN-33584, RXN-12858" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT1G01600.1" />
