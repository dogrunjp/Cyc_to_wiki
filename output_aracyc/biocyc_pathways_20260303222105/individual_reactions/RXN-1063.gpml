      <Property key="AlternativeId_Phylomedb" value="Q9ZUX1" />
      <Property key="AlternativeId_Smr" value="Q9ZUX1" />
      <Property key="Catalyzes" value="RXN-33713, RXN-23604, RXN-15519, RXN-15518, RXN-15516" />
      <Property key="CatalyzesCount" value="5" />
      <Property key="Accession1" value="AT2G27690.1" />
