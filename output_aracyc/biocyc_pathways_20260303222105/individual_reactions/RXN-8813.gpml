      <CitationRef elementRef="citation_PUB_15784989" />
    </DataNode>
    <DataNode elementId="AT3G14550-MONOMER" textLabel="AT3G14550-MONOMER" type="Protein">
      <Xref identifier="Q8GY09" dataSource="uniprot" />
      <Graphics centerX="150" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;GGPS3&lt;/i&gt; when expressed in recombinant &lt;i&gt;E.coli&lt;/i&gt; was shown to encode for a protein catalyzing the condensation of farnesyl pyrophosphate (FPP) and isopentenyl pyrophosphate (IPP) to produce geranylgeranyl diphosphate (GGPP) |CITS:[10759500]|. &lt;i&gt;In planta&lt;/i&gt;, this geranylgeranyl pyrophosphate synthase was shown to be translocated into pea chloroplasts; a result that was confirmed by the detection of the GFP-fused protein in the chloroplasts of epidermal cells and leaf guard cells, and in the etioplasts of roots |CITS:[10759500]|.</Comment>
      <Property key="UniqueID" value="AT3G14550-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G14550.1" />
      <Property key="AlternativeId_Pid" value="NP_188073" />
      <Property key="AlternativeId_Uniprot" value="Q8GY09" />
      <Property key="Synonym_1" value="farnesyltranstransferase" />
      <Property key="Synonym_2" value="ATGGPS3" />
      <Property key="Catalyzes" value="RXN-33317, RXN-33316, RXN-33315, RXN-12018" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT3G14550.1" />
