    <DataNode elementId="AT4G33790-MONOMER" textLabel="alcohol-forming fatty acyl-CoA reductase" type="Protein">
      <Xref identifier="AT4G33790-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Metabolite analysis of total wax content and wax composition using mutant plants indicated CER4 is responsible for the conversion of very long chain fatty acids to primary alcohols. The CER4 cDNA was ectopically expressed in yeast. Novel very long chain primary alcohols C24:0-OH and C26:0-OH were detected in transgenic yeast cells. The conversion of acyl-CoA to alcohol catalyzed by CER4 is a single step reaction without releasing of a possible aldehyde intermediate. No change of aldehyde level was found in CER4 mutants. No novel aldehyde was produced in CER4 transgenic yeasts. There are seven putative fatty acyl-CoA reductases (FARs) genes in the Arabidopsis genome. CER4 is the most closely related FAR to the NADPH-dependent alcohol forming FAR characterized in jojoba.</Comment>
      <Property key="UniqueID" value="AT4G33790-MONOMER" />
      <Property key="Catalyzes" value="RXN-33888, RXN-10742" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="GOTerms" value="GO:0005789" />
      <Property key="Accession1" value="AT4G33790.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT4G33790" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCO-ER-MEM" />
      <CitationRef elementRef="citation_PUB_16980563" />
    </DataNode>
