    <DataNode elementId="AT2G20370-MONOMER" textLabel="xyloglucan galactosyltransferase" type="Protein">
      <Xref identifier="Q7XJ98" dataSource="uniprot" />
      <Graphics centerX="150" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, karthik">Biochemical analysis using crude extracts from |FRAME: TAX-4922| cells over-expressing the |FRAME: TAX-3702| |FRAME: AT2G20370| protein using radiolabeled |FRAME: UDP-GALACTOSE| as the donor substrate revealed that this xyloglucan galactosyltransferase attaches a D-galactose residue specifically to the third xylose residue within the XXXG core structure |CITS: [12837954]|. The |FRAME: AT2G20370| gene product has also been implicated in endomembrane organization, and appears to be necessary for cell elongation |CITS: [15863516]|.</Comment>
      <Property key="UniqueID" value="AT2G20370-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G20370.1" />
      <Property key="AlternativeId_Uniprot" value="Q7XJ98" />
      <Property key="Catalyzes" value="RXN-19227, RXN-15013" />
