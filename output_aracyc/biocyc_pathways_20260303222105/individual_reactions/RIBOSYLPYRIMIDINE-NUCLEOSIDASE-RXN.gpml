      <Property key="AlternativeId_Chebi" value="26432" />
      <Property key="AlternativeId_Metanetx" value="MNXM79941" />
      <Property key="Synonym_1" value="pyrimidine base" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="Osmolarity" value="0" />
    </DataNode>
