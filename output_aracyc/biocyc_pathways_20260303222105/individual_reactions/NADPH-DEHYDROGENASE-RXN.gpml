    <DataNode elementId="AT5G66190-MONOMER" textLabel="Ferredoxin--NADP reductase, leaf isozyme 1, chloroplastic" type="Protein">
      <Xref identifier="Q9FKW6" dataSource="uniprot" />
      <Graphics centerX="150" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The gene encoding the leaf ferredoxin-NADP+-oxidoreductase (AtLFNR1) catalyzing the formation of NADPH from reduced ferredoxin and NADP has been characterized in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. AtLFNR1 is involved in both the linear and non-linear electron transport chain as demonstrated in an AtLFNR1-deficient T-DNA mutant. AtLFNR1 is also a prerequisite for the attachment of another ferredoxin-NADP+-oxidoreductase (AtLFNR2) to the thylakoid membrane and forms a functional heterodimer with the former enzyme which has been discussed as a way to regulate the distribution of electrons between the cyclic and linear electron transfer pathways according to environmental cues |CITS: [17335513]|.</Comment>
      <Property key="UniqueID" value="AT5G66190-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G66190.1" />
      <Property key="AlternativeId_Uniprot" value="Q9FKW6" />
      <Property key="Synonym_1" value="Leaf FNR 1" />
      <Property key="Synonym_2" value="AtLFNR1" />
      <Property key="Synonym_3" value="FNR-1" />
      <Property key="Catalyzes" value="RXN-33573, RXN-ARA-418, RXN-9547" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT5G66190.1" />
      <Property key="Gene" value="AT5G66190" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Pi" value="5." />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17335513" />
    </DataNode>
    <DataNode elementId="AT1G20020-MONOMER" textLabel="Ferredoxin--NADP reductase, leaf isozyme 2, chloroplastic" type="Protein">
      <Xref identifier="Q8W493" dataSource="uniprot" />
      <Graphics centerX="300" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The leaf ferredoxin-NADP+-oxidoreductase (AtLFNR2) catalyzing the formation of NADPH from reduced ferredoxin and NADP has been characterized in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. AtLFNR2 functions in close relationship with another ferredoxin-NADP+-oxidoreductase (AtLFNR1) which is necessary to attach it to the thylakoid membrane and with which it forms a functional heterodimer to regulate the distribution of electrons between the cyclic and linear electron transfer pathways |CITS: [17335513]|.</Comment>
      <Property key="UniqueID" value="AT1G20020-MONOMER" />
