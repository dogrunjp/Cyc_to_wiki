    <DataNode elementId="AT5G51290-MONOMER" textLabel="Ceramide kinase" type="Protein">
      <Xref identifier="Q6USK2" dataSource="uniprot" />
      <Graphics centerX="150" centerY="215" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">In vitro assay of the purified recombinant ceramide kinase showed that short chain ceramides (C6 and C8) are the effective substrates, whereas naturally occurring ceramides are not. The Km for C8 ceramide is 24.4 uM.</Comment>
