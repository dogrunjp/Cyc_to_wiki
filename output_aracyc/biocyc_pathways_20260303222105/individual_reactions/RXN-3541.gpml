      <Property key="AlternativeId_Pubchem" value="54679076" />
      <Property key="AlternativeId_Chebi" value="38290" />
      <Property key="AlternativeId_Knapsack" value="C00001179" />
      <Property key="AlternativeId_LigandCpd" value="C00072" />
      <Property key="AlternativeId_Cas" value="50-81-7" />
      <Property key="Synonym_1" value="L-ascorbic acid" />
      <Property key="Synonym_2" value="vitamin C" />
      <Property key="Synonym_3" value="ascorbic acid" />
