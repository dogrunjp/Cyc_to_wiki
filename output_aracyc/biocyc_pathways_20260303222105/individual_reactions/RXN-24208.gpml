    <DataNode elementId="AT4G37640-MONOMER" textLabel="Calcium-transporting ATPase 2, plasma membrane-type" type="Protein">
      <Xref identifier="O81108" dataSource="uniprot" />
      <Graphics centerX="300" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">A full-length cDNA that encodes a Ca&lt;sup&gt;2+&lt;/sup&gt;-ATPase was isolated from Arabidopsis and named ACA2. The protein is similar to a plasma membrane-type Ca&lt;sup&gt;2+&lt;/sup&gt;-ATPase, but is missing the usual long C-terminal calmodulin-binding regulatory domain. Instead, it contains a calmodulin-binding sequence within the first 36 residues of its N-terminal domain. ACA2p was expressed in yeast as both a full-length protein and an N-terminal truncation mutant. The truncated protein was fully active and insensitive to calmodulin, while the full product had a low basal activity, but was stimulated 5-fold by calmodulin. Unlike previously characterized calmodulin-regulated Ca&lt;sup&gt;2+&lt;/sup&gt;-ATPases which are located in the plasma membrane, ACA2p is localized to an endomembrane system |CITS: [9422775]|</Comment>
      <Property key="UniqueID" value="AT4G37640-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G37640.1" />
      <Property key="AlternativeId_Uniprot" value="O81108" />
      <Property key="Synonym_1" value="Ca(2+)-ATPase isoform 2" />
      <Property key="Catalyzes" value="RXN-33475, RXN-9865" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT4G37640.1" />
      <Property key="FunctionalAssignmentStatus" value=":AMBIGUOUS" />
      <Property key="Gene" value="AT4G37640" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_9422775" />
    </DataNode>
