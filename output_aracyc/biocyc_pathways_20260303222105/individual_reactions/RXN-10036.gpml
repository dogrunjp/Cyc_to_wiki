    <Interaction elementId="RXN-10036">
      <Xref identifier="EC-3.1.3.86" dataSource="Enzyme Nomenclature" />
      <Waypoints>
        <Point elementId="RXN-10036_start" x="545.0" y="680" elementRef="PHOSPHATIDYLINOSITOL-345-TRIPHOSPHATE" relX="1.0" relY="0.0" />
        <Point elementId="RXN-10036_end" arrowHead="Conversion" x="155.0" y="780" elementRef="_1-PHOSPHATIDYL-1D-MYO-INOSITOL-34-BISPH" relX="-1.0" relY="0.0" />
        <Anchor elementId="RXN-10036_anchor" position="0.5" shapeType="Circle" />
      </Waypoints>
      <Graphics lineColor="000000" lineStyle="Solid" lineWidth="1.0" connectorType="Straight" />
      <Comment source="BioCyc">This enzyme hydroylses |FRAME: PHOSPHATIDYLINOSITOL-345-TRIPHOSPHATE 1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate| (PtdIns(3,4,5)P3) to produce |FRAME: 1-PHOSPHATIDYL-1D-MYO-INOSITOL-34-BISPH a 1-phosphatidyl-1D-myo-inositol 3,4-bisphosphate| [PtdIns(3,4)P2], thereby negatively regulating the PI3K (phosphoinositide 3-kinase) pathways. The enzyme also shows activity toward |FRAME: CPD-506 D-&lt;i&gt;myo&lt;/i&gt;-inositol (1,3,4,5)-tetrakisphosphate| [PtdIns(1,3,4,5)P4] |CITS: [9824312]|. The enzyme is involved in several signal transduction pathways in the immune system leading to an adverse range of effects.</Comment>
      <Property key="UniqueID" value="RXN-10036" />
      <Property key="EC_Number" value="EC-3.1.3.86" />
      <Property key="Orphan" value=":NO" />
      <Property key="ReactionEquation" value="PHOSPHATIDYLINOSITOL-345-TRIPHOSPHATE + WATER =&gt; 1-PHOSPHATIDYL-1D-MYO-INOSITOL-34-BISPH + Pi" />
      <Property key="ReactionDirection" value="PHYSIOL-LEFT-TO-RIGHT" />
      <Property key="BalanceStatus" value=":BALANCED" />
      <Property key="PhysiologicallyRelevant" value="T" />
      <Property key="EnzymaticReactions" value="ENZRXNQT-32960, ENZRXNQT-31803, ENZRXNQT-31644, ENZRXNQT-31383, ENZRXNQT-30758, ENZRXNQT-27092, ENZRXN-20331, ENZRXN-20335, ENZRXN-20329" />
