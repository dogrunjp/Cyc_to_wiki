    <DataNode elementId="AT3G59050-MONOMER" textLabel="Polyamine oxidase 3" type="Protein">
      <Xref identifier="Q9LYT1" dataSource="uniprot" />
      <Graphics centerX="300" centerY="275" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA of Arabidopsis PAO3 was expressed in E. coli and purified. PAO3 is an FAD-containing polyamine oxidase (PAO). PAO3 oxidizes spermine and spermidine, but not putrescine. The substrate specificity was determined for the purified enzyme. It showed the following substrate preferences in vitro: spermidine &gt; spermine &gt; N&lt;sup&gt;1&lt;/sup&gt;-acetylspermidine &gt; N&lt;sup&gt;1&lt;/sup&gt;-acetylspermine. The corresponding Kcat/Km for each substrate was determined as 6.12, 0.31, 0.042 and 0.01, respectively. Well-known PAO inhibitors guazatine and aminoguanidine were shown to inhibit the enzyme activity, with a Ki of 0.028 uM and 1.08 uM, respectively. Putrescine was also inhibitory, with a Ki of 61.5 uM.</Comment>
      <Property key="UniqueID" value="AT3G59050-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G59050.1" />
      <Property key="AlternativeId_Smr" value="Q9LYT1" />
      <Property key="AlternativeId_Prints" value="PR00757" />
      <Property key="AlternativeId_Pride" value="Q9LYT1" />
      <Property key="AlternativeId_Interpro" value="IPR023753" />
      <Property key="AlternativeId_Pfam" value="PF01593" />
      <Property key="AlternativeId_Phylomedb" value="Q9LYT1" />
      <Property key="AlternativeId_Uniprot" value="Q9LYT1" />
      <Property key="Synonym_1" value="AtPAO3" />
      <Property key="Catalyzes" value="RXN-33837, RXN-33836, RXN-17488, RXN-17489, RXN-ARA-927" />
      <Property key="CatalyzesCount" value="5" />
