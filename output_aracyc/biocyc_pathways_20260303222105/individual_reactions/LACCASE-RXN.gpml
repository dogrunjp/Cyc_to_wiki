    <DataNode elementId="AT5G60020-MONOMER" textLabel="Laccase-17" type="Protein">
      <Xref identifier="Q9FJD5" dataSource="uniprot" />
      <Graphics centerX="150" centerY="615" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">LAC17 appears to have laccase activity based on enzyme assays performed using &lt;i&gt;lac17&lt;/i&gt; mutants and the model substrate |FRAME: CPD-12796 ABTS| |CITS: [21447792]|. Laccase activity is typically associated with |FRAME: LACCASE-RXN EC 1.10.3.2|. The role of this enzyme &lt;i&gt;in planta&lt;/i&gt; is still under investigation. LAC17 transcripts are expressed in Arabidopsis interfascicular fibers where this enzyme may play a role in the oxidoreductase reactions required for the polymerization of lignin monomers (see |FRAME: PWY-83 monolignol glucosides biosynthesis|). Notably, &lt;i&gt;lac17&lt;/i&gt; mutants appear to have a reduced deposition of G lignin units |CITS: [21447792]|.</Comment>
      <Property key="UniqueID" value="AT5G60020-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G60020.1" />
      <Property key="AlternativeId_Uniprot" value="Q9FJD5" />
      <Property key="Synonym_1" value="Benzenediol:oxygen oxidoreductase 17" />
      <Property key="Synonym_2" value="Diphenol oxidase 17" />
      <Property key="Synonym_3" value="Urishiol oxidase 17" />
      <Property key="Catalyzes" value="RXN-34002, RXN-19138" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G60020.1" />
      <Property key="Gene" value="AT5G60020" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_21447792" />
    </DataNode>
