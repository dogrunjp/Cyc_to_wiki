    <DataNode elementId="AT2G38080-MONOMER" textLabel="Laccase-4" type="Protein">
      <Xref identifier="O80434" dataSource="uniprot" />
      <Graphics centerX="300" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">LAC4 appears to have laccase activity based on enzyme assays performed using &lt;i&gt;lac4&lt;/i&gt; mutants and the model substrate |FRAME: CPD-12796 ABTS| |CITS: [21447792]|. Laccase activity is typically associated with |FRAME: LACCASE-RXN EC 1.10.3.2|. The role of this enzyme &lt;i&gt;in planta&lt;/i&gt; is still under investigation. LAC4 transcripts are expressed in Arabidopsis interfascicular fibers and vascular bundles where this enzyme may play a role in the oxidoreductase reactions required for the polymerization of lignin monomers (see |FRAME: PWY-83 monolignol glucosides biosynthesis|). The potential role of this enzyme in lignin biosynthesis is further supported by the observation that &lt;i&gt;lac4&lt;/i&gt; mutants have reduced lignin levels |CITS: [21447792]|.</Comment>
      <Property key="UniqueID" value="AT2G38080-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G38080.1" />
      <Property key="AlternativeId_Uniprot" value="O80434" />
      <Property key="Synonym_1" value="Benzenediol:oxygen oxidoreductase 4" />
      <Property key="Synonym_2" value="Diphenol oxidase 4" />
      <Property key="Synonym_3" value="IRREGULAR XYLEM 12" />
      <Property key="Synonym_4" value="Urishiol oxidase 4" />
      <Property key="Catalyzes" value="RXN-33750, RXN-19139" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT2G38080.1" />
      <Property key="Gene" value="AT2G38080" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_21447792" />
    </DataNode>
