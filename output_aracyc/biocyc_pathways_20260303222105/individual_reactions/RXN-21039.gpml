      <Property key="N+1Name" value="poly[(&lt;i&gt;R&lt;/i&gt;)-3-hydroxyalkanoate]&lt;sub&gt;n+1&lt;/sub&gt;" />
      <Property key="NName" value="poly[(&lt;i&gt;R&lt;/i&gt;)-3-hydroxyalkanoate]&lt;sub&gt;n&lt;/sub&gt;" />
