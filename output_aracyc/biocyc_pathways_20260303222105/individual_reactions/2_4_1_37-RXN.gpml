      <Property key="Synonym_2" value="a glycoprotein-&amp;alpha;-L-fucosyl-(1,2)-&amp;beta;-D-galactose" />
      <Property key="Synonym_3" value="a 2-O-(6-deoxy-&amp;alpha;-L-galactopyranosyl)-&amp;beta;-D-galactopyranosyl" />
      <Property key="Synonym_4" value="an &amp;alpha;-L-fucosyl-1,2-&amp;beta;-D-galactoside" />
      <Property key="Synonym_5" value="an &amp;alpha;-L-fucosyl-1,2-&amp;beta;-D-galactosyl-R" />
      <Property key="GroupCoords2d" value="(41 41), (41 93), (93 41)" />
