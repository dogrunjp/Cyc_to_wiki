    <DataNode elementId="AT4G12110-MONOMER" textLabel="4,4-dimethyl-9β,19-cyclopropylsterol-4α-methyl oxidase" type="Protein">
      <Xref identifier="Q8LB57" dataSource="uniprot" />
      <Graphics centerX="150" centerY="275" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Several lines of evidence suggest that this enzyme is involved in the first of two demethylation steps that occur during plant sterol biosynthesis |CITS: [14653780]|. It should be capable of performing the reaction: a 4,4-dimethyl-9&amp;beta;,19-cyclopropylsterol + 3NADPH + 3H+ + 3O2 -&gt; a 4&amp;alpha;-carboxy, 4&amp;beta;-methyl-9&amp;beta;,19-cyclopropylsterol) + 3NADP+ + 3H2O. Enzymes of this class carry out three successive monooxygenation steps on the methyl group causing it to undergo the following series of changes: CH3-&gt;CH2OH-&gt;CHO-&gt;COOH. The final product of these reactions can then be acted on by a 3&amp;beta;-hydroxysteroid-dehydrogenase/C4-decarboxylase and a 3-keto-reductase to produce the final monomethylated product |CITS: [14653780]|. But, to date, no direct assays of this enzyme&apos;s activities have been performed.</Comment>
      <Property key="UniqueID" value="AT4G12110-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G12110.1" />
      <Property key="AlternativeId_Phytozome" value="AT4G12110.1" />
      <Property key="AlternativeId_Interpro" value="IPR006694" />
      <Property key="AlternativeId_Pfam" value="PF04116" />
      <Property key="AlternativeId_Uniprot" value="Q8LB57" />
      <Property key="AlternativeId_Pride" value="Q8L7W5" />
      <Property key="AlternativeId_Arrayexpress" value="Q8L7W5" />
      <Property key="AlternativeId_String" value="3702.AT4G12110.1-P" />
      <Property key="Synonym_1" value="sterol 4&amp;alpha;-methyl oxidase" />
      <Property key="Catalyzes" value="RXN-33851, RXN-33850, RXN-18519, RXN-18520, RXN-18521, RXN-18540, RXN-18625, RXN-18626" />
      <Property key="CatalyzesCount" value="8" />
      <Property key="Accession1" value="AT4G12110.1" />
      <Property key="Gene" value="AT4G12110" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_14653780" />
    </DataNode>
    <DataNode elementId="AT4G22756-MONOMER" textLabel="Methylsterol monooxygenase 1-2" type="Protein">
