    <Interaction elementId="_2.7.9.4-RXN">
      <Xref identifier="EC-2.7.9.4" dataSource="Enzyme Nomenclature" />
      <Waypoints>
        <Point elementId="_2.7.9.4-RXN_start" x="395.0" y="540" elementRef="Alpha-D-Glucans" relX="1.0" relY="0.0" />
        <Point elementId="_2.7.9.4-RXN_end" arrowHead="Conversion" x="455.0" y="540" elementRef="Phospho-alpha-glucans" relX="-1.0" relY="0.0" />
        <Anchor elementId="_2.7.9.4-RXN_anchor" position="0.5" shapeType="Circle" />
      </Waypoints>
      <Graphics lineColor="000000" lineStyle="Solid" lineWidth="1.0" connectorType="Straight" />
      <Comment source="BioCyc">ATP appears to be the only phosphate donor. No activity could be detected using GTP, UTP, phosphoenolpyruvate or diphosphate. The protein phosphorylates glucans at both the C-6 and C-3 position of the glucosyl residues. The protein phosphorylates itself with the &amp;beta;-phosphate of ATP, which is then transferred to the glucan.</Comment>
      <Property key="UniqueID" value="2.7.9.4-RXN" />
      <Property key="EC_Number" value="EC-2.7.9.4" />
      <Property key="ReactionEquation" value="Alpha-D-Glucans + WATER + ATP =&gt; Phospho-alpha-glucans + AMP + Pi + PROTON" />
      <Property key="ReactionDirection" value="PHYSIOL-LEFT-TO-RIGHT" />
      <Property key="BalanceStatus" value=":UNDETERMINED" />
      <Property key="PhysiologicallyRelevant" value="T" />
      <Property key="EnzymaticReactions" value="ENZRXNQT-33957, ENZRXNQT-28796, ENZRXNQT-28356, ENZRXN-18820" />
