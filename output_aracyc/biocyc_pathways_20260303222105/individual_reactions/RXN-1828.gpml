    <Interaction elementId="RXN-1828">
      <Xref identifier="EC-2.4.1.25" dataSource="Enzyme Nomenclature" />
      <Waypoints>
        <Point elementId="RXN-1828_start" x="395.0" y="400" elementRef="Long-linear-glucans" relX="1.0" relY="0.0" />
