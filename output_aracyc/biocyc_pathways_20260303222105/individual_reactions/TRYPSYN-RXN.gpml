    <DataNode elementId="AT4G02610-MONOMER" textLabel="Tryptophan synthase alpha chain" type="Protein">
      <Xref identifier="O22765" dataSource="uniprot" />
      <Graphics centerX="300" centerY="275" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The Arabidopsis tryptophan synthase, like all other characterized tryptophan synthases, is composed of an alpha and a beta subunit. The alpha subunit catalyzes the conversion of indole-3-glycerolphosphate to indole, and the beta subunit catalyzes the formation of tryptophan from indole and serine. At least one functional gene encoding the alpha subunit, TSA1, has been cloned by functional complementation of an E. coli mutant|CITS: [7476868]|. On the other hand, there are two closely related genes encoding the beta subunit, TSB1 and TSB2. TSB1 is the predominantly expressed, whose mRNA accounts for 90% of the TSB transcripts|CITS: [1840915]|. A TSB1 mutant was shown lost about 90% of tryptophan synthase beta subunit activity.</Comment>
      <Property key="UniqueID" value="AT4G02610-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G02610.1" />
      <Property key="AlternativeId_Uniprot" value="O22765" />
      <Property key="Synonym_1" value="Indole synthase" />
      <Property key="Synonym_2" value="Indole-3-glycerol-phosphate lyase" />
      <Property key="Catalyzes" value="RXN-7495, RXN-6052" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="GOTerms" value="GO:0009507" />
      <Property key="Accession1" value="AT4G02610.1" />
      <Property key="Gene" value="AT4G02610" />
      <Property key="^citations" value="7890741" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CHLOROPLAST-PL" />
      <CitationRef elementRef="citation_PUB_7476868" />
      <CitationRef elementRef="citation_PUB_1840915" />
    </DataNode>
