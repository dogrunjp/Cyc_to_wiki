    <DataNode elementId="AT2G23620-MONOMER" textLabel="Methylesterase 1" type="Protein">
      <Xref identifier="Q8S8S9" dataSource="uniprot" />
      <Graphics centerX="750" centerY="715" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">This enzyme has methylesterase activity against methyl indole-3-acetate (MeIAA), methyl salicylate (MeSA), and methyl jasmonate (MeJA) &lt;i&gt;in vitro&lt;/i&gt; |CITS: [18467465]|. MES1 has a much higher activity with MeSA than MeIAA or MeJA &lt;i&gt;in vitro&lt;/i&gt;. In addition, it can complement the systemic acquired resistance (SAR)-deficient phenotype of tobacco plants with reduced SABP2 expression. And, its transcript levels are up-regulated in response to pathogen attack. All of these suggest that MES1 likely plays a role in SA metabolism and SAR responses &lt;i&gt;in vivo&lt;/i&gt; |CITS: [18643994]|.</Comment>
      <Property key="UniqueID" value="AT2G23620-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G23620.1" />
      <Property key="AlternativeId_Uniprot" value="Q8S8S9" />
      <Property key="Synonym_1" value="AtMES1" />
      <Property key="Catalyzes" value="RXN-33705, RXN-19355, RXN-12611, RXN-12610, RXN-12464" />
      <Property key="CatalyzesCount" value="5" />
      <Property key="Accession1" value="AT2G23620.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT2G23620" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_18467465" />
      <CitationRef elementRef="citation_PUB_18643994" />
    </DataNode>
