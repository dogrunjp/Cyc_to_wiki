    <DataNode elementId="Glycerolipids" textLabel="a glycerolipid" type="Metabolite">
      <Xref identifier="35741" dataSource="ChEBI" />
      <Graphics centerX="350" centerY="400" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang, SRI, caspi">Glycerolipids are lipids that contain a |FRAME: GLYCEROL| backbone to which at least one fatty acyl group is esterified. If a phosphate group is ester-linked to the terminal carbon of the |FRAME: GLYCEROL| backbone, the compound is classified as |FRAME: Phosphoglycerides|.</Comment>
