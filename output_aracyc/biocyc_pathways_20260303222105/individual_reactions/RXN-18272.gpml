      <Property key="NonStandardInchi" value="InChI=1S/C10H19NO8/c12-1-5(11-4-14)3-18-10-9(17)8(16)7(15)6(2-13)19-10/h4-10,12-13,15-17H,1-3H2,(H,11,14)/t5-,6-,7+,8+,9-,10-/m1/s1" />
      <Property key="Osmolarity" value="0" />
