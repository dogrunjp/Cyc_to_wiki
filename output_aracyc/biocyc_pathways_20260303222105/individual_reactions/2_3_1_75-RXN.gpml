    <DataNode elementId="AT5G37300-MONOMER" textLabel="AT5G37300-MONOMER" type="Protein">
      <Xref identifier="Q93ZR6" dataSource="uniprot" />
      <Graphics centerX="150" centerY="695" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Palmitoyl (16:0-acyl) is the dominant acyl moiety found in Arabidopsis cuticular wax esters. The chain lengths of esterified alcohols are between C20 and C32|CITS: [17376164]|. The WS cDNA was expressed in E. coli. In vitro assay with the recombinant protein indicated it is a bifunctional enzyme. The wax ester synthase (WS) activity was demonstrated with substrates palmitoyl-CoA and 1-octadecanol (a C18 alcohol). The diacylglycerol acyltransferase (DGAT) activity was demonstrated with substrates palmitoyl-CoA and 1,2-dipalmitoyl-glycerol. However, the recombinant enzyme has a ratio of 10.9 between its WS and DGAT activities. The WS cDNA was also ectopically expressed in yeast. Transgenic yeast cells produced wax esters when supplemented with palmitate with either octadecanol (C18), tetracosanol (C24) or octacosanol (C28).</Comment>
      <Property key="UniqueID" value="AT5G37300-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G37300.4" />
      <Property key="AlternativeId_Uniprot" value="Q93ZR6" />
      <Property key="Synonym_1" value="AT5G37300.4" />
      <Property key="Catalyzes" value="RXN-33528, RXN-33527, RXN-10741" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="GOTerms" value="GO:0005789" />
      <Property key="Accession1" value="AT5G37300.4" />
      <Property key="Gene" value="AT5G37300" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCO-ER-MEM" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_18621978" />
      <CitationRef elementRef="citation_PUB_17376164" />
    </DataNode>
