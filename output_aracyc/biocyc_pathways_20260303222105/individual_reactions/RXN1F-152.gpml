      <Property key="Synonym_2" value="&amp;beta;-hydroxylase" />
      <Property key="Synonym_3" value="&amp;beta;-ring carotenoid hydroxylase" />
      <Property key="ComplexComponents" value="AT4G25700-MONOMER" />
