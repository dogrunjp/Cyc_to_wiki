    <DataNode elementId="Lewis-a-epitope" textLabel="a Lewis a epitope" type="Metabolite">
      <Xref identifier="18914" dataSource="ChEBI" />
      <Graphics centerX="350" centerY="400" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang, SRI, caspi">The |FRAME: Lewis-a-epitope &quot;Lewis a epitope&quot;| is formed by &amp;alpha;(1,4) fucosylation of the &lt;i&gt;N&lt;/i&gt;-acetylglucosaminyl residue of |FRAME: Core1|, the disaccharide precursor that can also lead to formation of the |FRAME: Type-1-H-Antigen| by &amp;alpha;(1,2) fucosylation at its terminal galactosyl residue |CITS: [5691821]|. The related |FRAME: CPD-8594 &quot;Lewis x epitope&quot;| is formed by &amp;alpha;(1,3) fucosylation of the &lt;i&gt;N&lt;/i&gt;-acetylglucosaminyl residue of |FRAME: B-Gal-14-NacGlc-R|. Both the |FRAME: Lewis-a-epitope| and the |FRAME: CPD-8594| cannot be further transformed to ABH-type antigens |CITS: [6156588]|.</Comment>
      <Property key="UniqueID" value="Lewis-a-epitope" />
      <Property key="AlternativeId_Seed" value="cpd02947" />
      <Property key="AlternativeId_Metanetx" value="MNXM5069" />
      <Property key="AlternativeId_LigandCpd" value="C04850" />
      <Property key="AlternativeId_Chebi" value="18914" />
      <Property key="Synonym_1" value="1,3-&amp;beta;-D-galactosyl-(&amp;alpha;-1,4-L-fucosyl)-&lt;i&gt;N&lt;/i&gt;-acetyl-D-glucosaminyl- R" />
      <Property key="Synonym_2" value="&amp;beta;Gal-(1&amp;rarr;3)-[&amp;alpha;-Fuc-(1&amp;rarr;4)-&amp;beta;GlcNac]-(1&amp;rarr;R)[" />
      <Property key="Synonym_3" value="&amp;beta;-D-galactosyl-(1&amp;rarr;3)-[(&amp;alpha;-L-fucosyl)-(1&amp;rarr;4)]-&lt;i&gt;N&lt;/i&gt;-acetyl-&amp;beta;-D-glucosaminyl-[protein]" />
      <Property key="Synonym_4" value="a histo-blood group Le&lt;sup&gt;a&lt;/sup&gt; antigen" />
      <Property key="GroupCoords2d" value="(93 41), NIL, (41 41), (93 93), (145 41)" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
