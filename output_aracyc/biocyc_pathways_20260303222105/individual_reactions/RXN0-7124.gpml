      <Property key="Synonym_3" value="a QH&lt;sub&gt;2&lt;/sub&gt;" />
      <Property key="AbbrevName" value="UQH&lt;sub&gt;2&lt;/sub&gt;" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NonStandardInchi" value="InChI=1S/C14H20O4/c1-8(2)6-7-10-9(3)11(15)13(17-4)14(18-5)12(10)16/h6,15-16H,7H2,1-5H3" />
      <Property key="Osmolarity" value="0" />
      <Property key="Regulates" value="REG-15265, REG-8065, REGQT-387" />
      <Property key="Smiles" value="C([R])C(\C)=C/CC1(\C(\O)=C(C(\OC)=C(C(/C)=1)\O)\OC)" />
      <CitationRef elementRef="citation_PUB_16233343" />
