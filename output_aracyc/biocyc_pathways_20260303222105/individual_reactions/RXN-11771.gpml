    <DataNode elementId="CPD-8838" textLabel="juvenile hormone III" type="Metabolite">
      <Xref identifier="QVJMXSGZTCGLHZ-HONBPKQLSA-N" dataSource="InChIKey" />
      <Graphics centerX="200" centerY="680" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="xu, SRI, caspi">Several compounds with juvenile hormone (JH) activity have been isolated from insects. The first three were named |FRAME: CPD-17897| (JH1), |FRAME: METHYL-EPOXYTRIDECADIENOATE| (JH2), and |FRAME: CPD-8838| (JH3). The three compounds differ widely in their physiological activity and their hemolymph concentrations during the insect&apos;s life cycle. JH3 is the predominant hormone in most adult insects, while JHI and JH2 have been identified mainly in larvae of Lepidoptera and in nymphs of |FRAME: TAX-6990|.</Comment>
      <Property key="UniqueID" value="CPD-8838" />
      <Property key="AlternativeId_Zinc" value="ZINC000013536517" />
      <Property key="AlternativeId_Seed" value="cpd06588" />
      <Property key="AlternativeId_Metanetx" value="MNXM2685" />
      <Property key="AlternativeId_Chebi" value="27493" />
      <Property key="AlternativeId_Pubchem" value="5281523" />
      <Property key="AlternativeId_Chemspider" value="4444856" />
      <Property key="AlternativeId_LigandCpd" value="C09694" />
      <Property key="Synonym_1" value="methyl (2&lt;i&gt;E&lt;/i&gt;,6&lt;i&gt;E&lt;/i&gt;,10&lt;i&gt;R&lt;/i&gt;)-10,11-epoxy-3,7,11-trimethyl-2,6-dodecadienoate" />
      <Property key="Synonym_2" value="JH III" />
      <Property key="ChemicalFormula" value="(C 16) (H 26) (O 3)" />
      <Property key="Gibbs0" value="225.23914" />
