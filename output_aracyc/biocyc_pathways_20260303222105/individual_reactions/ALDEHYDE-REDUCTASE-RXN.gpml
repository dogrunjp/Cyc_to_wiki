      <Property key="AlternativeId_Phylomedb" value="Q0PGJ6" />
      <Property key="AlternativeId_Prosite" value="PS00063" />
      <Property key="AlternativeId_Uniprot" value="Q0PGJ6" />
      <Property key="Catalyzes" value="RXN-33747, RXN-33745, RXN-19023, RXN-19021, RXN-19020, RXN-19019" />
