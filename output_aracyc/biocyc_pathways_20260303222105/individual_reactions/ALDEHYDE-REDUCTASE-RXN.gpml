      <Property key="AlternativeId_Prosite" value="PS00061" />
      <Property key="AlternativeId_Panther" value="PTHR24322" />
      <Property key="Catalyzes" value="RXN-33706, RXN-19013, RXN-19012, RXN-19011" />
