    <DataNode elementId="AT1G74380-MONOMER" textLabel="Probable xyloglucan 6-xylosyltransferase 5" type="Protein">
      <Xref identifier="Q9CA75" dataSource="uniprot" />
      <Graphics centerX="300" centerY="395" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
