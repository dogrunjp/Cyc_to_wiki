    <DataNode elementId="AT4G37930-MONOMER" textLabel="Serine hydroxymethyltransferase 1, mitochondrial" type="Protein">
      <Xref identifier="Q9SZJ5" dataSource="uniprot" />
      <Graphics centerX="150" centerY="395" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">A mutant of the serine hydroxymethyltransferase (originally called stm |CITS:[16661733]| and later renamed shmt1 |CITS:[15659103]| and shm1 |CITS[10806255]|) has been reported in Arabidopsis |CITS:[16661733][OGREN84]| and later mapped to |FRAME: AT4G37930|. Several potential homologs of this enzyme are reported for Arabidopsis (see Gene-Reaction schematic below). Serine hydroxymethyltransferase (SHMT) catalyzes the reversible conversion of 5,10-methylene-tetrahydrofolate and glycine to form serine and tetrahydrofolate. It was demonstrated that this enzyme possesses a second catalytic activity converting 5,10-methenyl-tetrahydrofolate to 5-formyl-tetrahydrofolate in the presence of glycine as shown for isolated SHMT from rabbit liver and &lt;i&gt;E. coli&lt;/i&gt; |CITS: [2201683]| |CITS: [1536856]|. The SHMT prefers polyglutamylated substrates (Km = 40 uM) to monoglutamylated substrates (140 uM). This enzyme is thought to be the main catalyst for 5-formyl-tetrahydrofolate (5-CHO-THF) formation in plants as well but a spontaneous hydrolysis of 5,10-methenyl-tetrahydrofolate to 5-CHO-THF may also occur |CITS: [11087421][15888445]|. The role of 5-CHO-THF in the C1-metabolism still remains to be solved. 5-CHO-THF is the most stable natural folate and the only one that does not serve as a cofactor in one-carbon metabolism. Instead, 5-CHO-THF is a potent inhibitor of SHMT and most other folatedependent enzymes in vitro and thought to be regulated by 5-formyltetrahydrofolate cycloligase during photorespiration |CITS: [8480361]| |CITS: [15888445]|.</Comment>
      <Property key="UniqueID" value="AT4G37930-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G37930.1" />
      <Property key="AlternativeId_Panther" value="PTHR11680" />
      <Property key="AlternativeId_Smr" value="Q9SZJ5" />
      <Property key="AlternativeId_String" value="Q9SZJ5" />
      <Property key="AlternativeId_Pride" value="Q9SZJ5" />
      <Property key="AlternativeId_Interpro" value="IPR019798" />
      <Property key="AlternativeId_Pfam" value="PF00464" />
      <Property key="AlternativeId_Phylomedb" value="Q9SZJ5" />
      <Property key="AlternativeId_Prosite" value="PS00096" />
      <Property key="AlternativeId_Uniprot" value="Q9SZJ5" />
      <Property key="Synonym_1" value="AtSHMT1" />
      <Property key="Synonym_2" value="Glycine hydroxymethyltransferase 1" />
      <Property key="Synonym_3" value="Serine Transhydroxymethyltransferase" />
      <Property key="Synonym_4" value="STM" />
      <Property key="Synonym_5" value="Serine methylase 1" />
      <Property key="Catalyzes" value="RXN-6111" />
      <Property key="Accession1" value="AT4G37930.1" />
      <Property key="Gene" value="AT4G37930" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_16661733" />
      <CitationRef elementRef="citation_PUB_15659103" />
      <CitationRef elementRef="citation_PUB_2201683" />
      <CitationRef elementRef="citation_PUB_1536856" />
      <CitationRef elementRef="citation_PUB_8480361" />
      <CitationRef elementRef="citation_PUB_15888445" />
    </DataNode>
    <DataNode elementId="MONOMER-845" textLabel="serine hydroxymethyltransferase" type="Protein">
      <Xref identifier="MONOMER-845" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="395" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">A mutant of the serine hydroxymethyltransferase has been reported in Arabidopsis|CITS: [OGREN84]| and later mapped to |FRAME: AT4G37930|, but several potential homologs of this enzyme are reported for Arabidopsis (see Gene-Reaction schematic below). Serine hydroxymethyltransferase (SHMT) catalyzes the reversible conversion of 5,10-methylene-tetrahydrofolate and glycine to form serine and tetrahydrofolate. It was demonstrated that this enzyme possesses a second catalytic activity converting 5,10-methenyl-tetrahydrofolate to 5-formyl-tetrahydrofolate in the presence of glycine as shown for isolated SHMT from rabbit liver and &lt;i&gt;E. coli&lt;/i&gt; |CITS: [2201683]| |CITS: [1536856]|. The SHMT prefers polyglutamylated substrates (Km = 40 uM) to monoglutamylated substrates (140 uM). This enzyme is thought to be the main catalyst for 5-formyl-tetrahydrofolate (5-CHO-THF) formation in plants as well but a spontaneous hydrolysis of 5,10-methenyl-tetrahydrofolate to 5-CHO-THF may also occur |CITS: [11087421]|. The role of 5-CHO-THF in the C1-metabolism still remains to be solved. 5-CHO-THF is the most stable natural folate and the only one that does not serve as a cofactor in one-carbon metabolism. Instead, 5-CHO-THF is a potent inhibitor of SHMT and most other folatedependent enzymes in vitro and thought to be regulated by 5-formyltetrahydrofolate cycloligase during photorespiration |CITS: [8480361]| |CITS: [15888445]|.</Comment>
      <Property key="UniqueID" value="MONOMER-845" />
      <Property key="Catalyzes" value="RXN-9624, RXN-2362" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="GOTerms" value="GO:0005739" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-MIT-PL" />
      <CitationRef elementRef="citation__OGREN84_" />
