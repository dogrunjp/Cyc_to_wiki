      <CitationRef elementRef="citation_PUB_11087421" />
      <CitationRef elementRef="citation_PUB_8480361" />
      <CitationRef elementRef="citation_PUB_15888445" />
    </DataNode>
    <DataNode elementId="AT4G35630-MONOMER" textLabel="AT4G35630-MONOMER" type="Protein">
