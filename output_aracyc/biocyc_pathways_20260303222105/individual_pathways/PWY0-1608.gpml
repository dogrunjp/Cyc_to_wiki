      <Property key="AlternativeId_Prosite" value="PS00096" />
      <Property key="AlternativeId_Uniprot" value="Q9SZJ5" />
      <Property key="Synonym_1" value="AtSHMT1" />
      <Property key="Synonym_2" value="Glycine hydroxymethyltransferase 1" />
      <Property key="Synonym_3" value="Serine Transhydroxymethyltransferase" />
      <Property key="Synonym_4" value="STM" />
