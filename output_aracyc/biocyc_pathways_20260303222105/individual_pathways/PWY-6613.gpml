      <Property key="Synonym_2" value="THF(glu)&lt;sub&gt;n&lt;/sub&gt;" />
      <Property key="Synonym_3" value="H&lt;sub&gt;4&lt;/sub&gt;PteGlu&lt;sub&gt;n&lt;/sub&gt;" />
      <Property key="Synonym_4" value="a tetrahydrofolate-glutamate" />
      <Property key="Synonym_5" value="THF" />
      <Property key="Synonym_6" value="THF polyglutamate" />
      <Property key="AtomCharges" value="(31 -1)" />
