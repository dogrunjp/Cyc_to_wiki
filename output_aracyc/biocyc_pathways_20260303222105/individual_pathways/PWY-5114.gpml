    <DataNode elementId="AT4G12250-MONOMER" textLabel="AT4G12250-MONOMER" type="Protein">
      <Xref identifier="AT4G12250-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="900" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The enzyme encoded by &lt;i&gt;Arabidopsis GAE5&lt;/i&gt; is similar to that encoded by &lt;i&gt;GAE1&lt;/i&gt;, which has been shown to have UDP-glucuronate 4-epimerase activity |CITS:[15247385]|. Although it has been postulated that GAE5 also has this activity, this assessment has not been experimentally verified.</Comment>
      <Property key="UniqueID" value="AT4G12250-MONOMER" />
      <Property key="Catalyzes" value="RXN-131" />
      <Property key="Accession1" value="AT4G12250.1" />
      <Property key="Gene" value="AT4G12250" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_15247385" />
    </DataNode>
    <DataNode elementId="AT4G00110-MONOMER" textLabel="AT4G00110-MONOMER" type="Protein">
      <Xref identifier="AT4G00110-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="855" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The enzyme encoded by &lt;i&gt;Arabidopsis GAE3&lt;/i&gt; is similar to that encoded by &lt;i&gt;GAE1&lt;/i&gt;, which has been shown to have UDP-glucuronate 4-epimerase activity |CITS:[15247385]|. Although it has been postulated that GAE3 also has this activity, this assessment has not been experimentally verified.</Comment>
      <Property key="UniqueID" value="AT4G00110-MONOMER" />
      <Property key="Catalyzes" value="RXN-130" />
