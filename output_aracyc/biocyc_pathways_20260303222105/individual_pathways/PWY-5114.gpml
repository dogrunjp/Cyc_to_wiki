    <DataNode elementId="AT3G53520-MONOMER" textLabel="UDP-glucuronate decarboxylase" type="Protein">
      <Xref identifier="Q9LFG7" dataSource="uniprot" />
      <Graphics centerX="900" centerY="615" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Nicotiana tabacum UXS1&lt;/i&gt; gene encodes a protein (AtUXS1) with UDP-glucuronate decarboxylase activity |CITS:[12481102]|, involved in the conversion of UDP-glucuronate (UDP-GlcA) into UDP-xylose (UDP-Xyl). This enzyme possesses a hydrophobic N-terminal domain thought to anchor the protein in endomembranes; the C-terminus moiety of the protein supposedly faces the lumen of endomembrane compartments |CITS:[12481102]|. AtUXS1 has a very high substrate specificity for UDP-GlcA. UDP-glucose, UDP-galactose, UDP-mannose, GDP-glucose, GDP-mannose and UDP-galacturonate were not used as substrates |CITS:[12481102]|. This enzyme does not require exogenously added NAD&lt;sup&gt;+&lt;/sup&gt;, although the cofactor is required for activity. It is therefore thought that NAD&lt;sup&gt;+&lt;/sup&gt; is tightly bound to the protein |CITS:[12481102]|.</Comment>
      <Property key="UniqueID" value="AT3G53520-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G53520.4" />
      <Property key="AlternativeId_Pid" value="AAK70880" />
      <Property key="AlternativeId_Uniprot" value="Q9LFG7" />
      <Property key="Catalyzes" value="RXN-11446" />
      <Property key="Accession1" value="AT3G53520.4" />
      <Property key="Gene" value="AT3G53520" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="48.3" />
      <Property key="MolecularWeightKd" value="48.3" />
      <CitationRef elementRef="citation_PUB_12481102" />
    </DataNode>
    <DataNode elementId="AT4G20460.1" textLabel="AT4G20460.1" type="Protein">
      <Xref identifier="AT4G20460.1" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="695" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
