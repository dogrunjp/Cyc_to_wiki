    <DataNode elementId="AT3G63520-MONOMER" textLabel="Carotenoid 9,10(9&apos;,10&apos;)-cleavage dioxygenase 1" type="Protein">
      <Xref identifier="Q8GRI2" dataSource="uniprot" />
      <Graphics centerX="150" centerY="275" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;CCD1&lt;/i&gt; encodes a protein which was shown through heterologous expression in &lt;i&gt;E. coli&lt;/i&gt; to have 9-&lt;i&gt;cis&lt;/i&gt;-epoxy-carotenoid dioxygenase (NCED) activity |CITS:[11316814]|. The enzyme has a wide spectrum of substrates, including &amp;beta;-carotene, lutein, zeaxanthin, and all-&lt;i&gt;trans&lt;/i&gt;-violaxanthin. When those compounds are used as substrates, the major reaction product detected is |FRAME:CPD-7202|. The enzyme did not cleave as efficiently carotenoids containing 9-&lt;i&gt;cis&lt;/i&gt;-double or allenic bonds |CITS:[11316814]|.</Comment>
      <Property key="UniqueID" value="AT3G63520-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G63520.1" />
      <Property key="AlternativeId_Modbase" value="Q8GRI2" />
      <Property key="AlternativeId_Swissmodel" value="Q8GRI2" />
      <Property key="AlternativeId_Uniprot" value="Q8GRI2" />
      <Property key="AlternativeId_Pid" value="NP_191911" />
      <Property key="Synonym_1" value="AtCCD1" />
      <Property key="Synonym_2" value="Neoxanthin cleavage enzyme NC1" />
      <Property key="Synonym_3" value="AtNCED1" />
      <Property key="Catalyzes" value="RXN-12618, RXN-12619, RXN-12625, RXN-12617" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT3G63520.1" />
