      <Property key="AlternativeId_Prosite" value="PS01247" />
      <Property key="AlternativeId_Uniprot" value="Q9SJM7" />
      <Property key="Catalyzes" value="RXN-33742, RXN-18696, RXN-18697, RXN-18695, RXN-18002, RXN-12667, RXN-12588, RXN-12587" />
