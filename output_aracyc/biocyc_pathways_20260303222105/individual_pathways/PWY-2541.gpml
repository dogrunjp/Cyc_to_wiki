      <Property key="AlternativeId_Interpro" value="IPR020532" />
      <Property key="AlternativeId_Phylomedb" value="Q9M643" />
      <Property key="AlternativeId_String" value="3702.AT5G50375.1-P" />
      <Property key="AlternativeId_Pid" value="AAF67863" />
