    <DataNode elementId="AT2G34500-MONOMER" textLabel="AT2G34500-MONOMER" type="Protein">
      <Xref identifier="O64697" dataSource="uniprot" />
      <Graphics centerX="150" centerY="395" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The gene encoding the &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; protein CYP710A2 was recombinantly expressed in insect cells. Microsomal fractions were used to characterize the substrate specificity and the C-22 desaturation activity of the enzyme |CITS:[16531502]|. The enzyme was shown to catalyze the C-22 desaturation of |FRAME:CPD-4143|, but not that of |FRAME:CPD-8134| or |FRAME:CPD-707|, showing a higher substrate specificity stringency that its homologue encoded by |FRAME:AT2G34490| |CITS:[16531502]|.</Comment>
      <Property key="UniqueID" value="AT2G34500-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G34500.1" />
      <Property key="AlternativeId_Smr" value="O64697" />
