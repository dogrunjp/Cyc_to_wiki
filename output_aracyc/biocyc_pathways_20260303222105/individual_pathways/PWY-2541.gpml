    <DataNode elementId="AT1G11680-MONOMER" textLabel="AT1G11680-MONOMER" type="Protein">
      <Xref identifier="Q9SQQ9" dataSource="uniprot" />
      <Graphics centerX="300" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Obtusifoliol 14&amp;alpha;-demethylase is a sterol 14&amp;alpha;-demethylase, which is classified as CYP51, a member of the cytochrome P450 monooxygenase superfamily. CYP51 is essential for sterol biosynthesis and it is assumed to be the only orthologous P450 family that exists in the fungi, mammal and plant kingdom. Whereas in animals and fungi the 14&amp;alpha;-methyl group is the first of the C14 and C4 methyls to be removed, in higher plants the 14&amp;alpha;-methyl is removed after the C4 methyl disappears in the main biosynthetic pathway.</Comment>
      <Property key="UniqueID" value="AT1G11680-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G11680.1" />
      <Property key="AlternativeId_Smr" value="Q9SAA9" />
      <Property key="AlternativeId_Arrayexpress" value="Q9SAA9" />
