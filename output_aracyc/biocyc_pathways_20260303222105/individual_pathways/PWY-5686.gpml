    <DataNode elementId="AT4G22930-MONOMER" textLabel="dihydroorotase" type="Protein">
      <Xref identifier="O04904" dataSource="uniprot" />
      <Graphics centerX="300" centerY="355" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Dihydroorotase is an enzyme involved in pyrimidine biosynthesis. The activity of this enzyme from Arabidopsis has been demonstrated through functional complementation of an &lt;i&gt;E.coli&lt;/i&gt; pyrC mutant, and through direct measurement of dihydroorotase activity in pyrC mutants expressing this enzyme |CITS: [12369616]|.</Comment>
      <Property key="UniqueID" value="AT4G22930-MONOMER" />
