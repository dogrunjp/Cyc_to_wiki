      <Property key="AlternativeId_Metanetx" value="MNXM162297" />
      <Property key="Synonym_1" value="(-)CH&lt;sub&gt;2&lt;/sub&gt;H&lt;sub&gt;4&lt;/sub&gt;folate" />
      <Property key="Synonym_2" value="(-)5,10-methylene-5,6,7,8-tetrahydrofolate" />
      <Property key="Synonym_3" value="methylene-H4PteGlu(n)" />
