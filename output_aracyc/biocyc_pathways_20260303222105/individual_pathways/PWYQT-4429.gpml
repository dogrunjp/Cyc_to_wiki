    <DataNode elementId="AT5G14740-MONOMER" textLabel="Beta carbonic anhydrase 2, chloroplastic" type="Protein">
      <Xref identifier="AT5G14740.1" dataSource="TAIR gene name" />
      <Graphics centerX="150" centerY="695" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA encoding a &amp;beta;-carbonic anhydrase (&amp;beta;-CA2) has been identified and partially characterized in &lt;i&gt;Arabidopsis thalaiana&lt;/i&gt;. The &amp;beta;-CA2 was localized to the cytosol indicating a different role than the &amp;beta;-CA1. The expression of &amp;beta;-CA2 was independent from light underlining the possible involvement of the enzyme in the synthesis of bicarbonate, the substrate for PEP carboxylase |CITS: [7520589]|.</Comment>
      <Property key="UniqueID" value="AT5G14740-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G14740.1" />
      <Property key="AlternativeId_Pid" value="AAA50156" />
      <Property key="Synonym_1" value="AtbCA2" />
      <Property key="Synonym_2" value="AtbetaCA2" />
      <Property key="Synonym_3" value="Beta carbonate dehydratase 2" />
      <Property key="Catalyzes" value="RXN-33933, RXN-6329" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G14740.1" />
      <Property key="Gene" value="AT5G14740" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_7520589" />
    </DataNode>
