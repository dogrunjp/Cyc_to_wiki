    </DataNode>
    <DataNode elementId="AT5G25900-MONOMER" textLabel="ent-kaurene oxidase" type="Protein">
      <Xref identifier="AT5G25900.1" dataSource="TAIR gene name" />
      <Graphics centerX="150" centerY="355" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis GA3&lt;/i&gt; gene was expressed in yeast and shown to encode for an enzyme (KO, &lt;i&gt;ent&lt;/i&gt;-kaurene oxidase) catalyzing the three steps of the gibberellin biosynthesis pathway from &lt;i&gt;ent&lt;/i&gt;-kaurene to &lt;i&gt;ent&lt;/i&gt;-kaurenoic acid (KA) |CITS:[9952446]|. Those three steps, involving the sequential triple hydroxylation of the same carbon position (C-19 methyl group), go as follows: &lt;i&gt;ent&lt;/i&gt;-kaurene to &lt;i&gt;ent&lt;/i&gt;-kaurenol (step1) to &lt;i&gt;ent&lt;/i&gt;-kaurenal (step2) to KA (step3).</Comment>
      <Property key="UniqueID" value="AT5G25900-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G25900.1" />
      <Property key="AlternativeId_Pid" value="AAD40137" />
      <Property key="Synonym_1" value="CYP701A3" />
      <Property key="Synonym_2" value="KO" />
      <Property key="Synonym_3" value="CYTOCHROME P450 701A3" />
      <Property key="Catalyzes" value="RXN-33524, RXN-11975, RXN-11974, RXN-11973" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT5G25900.1" />
      <Property key="Gene" value="AT5G25900" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
