    <Group elementId="CPLXQT-29" textLabel="4-aminobutyrate:pyruvate transaminase" type="Complex">
      <Xref identifier="CPLXQT-29" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="215" width="140" height="100" textColor="666666" fontName="Arial" fontSize="10" borderColor="9900CC" borderStyle="Dashed" borderWidth="2.0" fillColor="F5E6FF" shapeType="Rectangle" zOrder="-1" />
      <Comment>Note: The information concerning this enzyme described below was determined using recombinant POP2 from |FRAME: ORG-5862| and using mutants from |FRAME: ORG-5862| and |FRAME: ORG4FS-2|. However, the sequence of the POP2 protein from |FRAME: ORG-5862| is almost exactly identical to the AT3G22200.1 protein sequence from |FRAME: ORG-5993| therefore it seems likely the the proteins will behave in the same manner. The cDNA encoding &amp;gamma;-aminobutyrate (GABA) transaminase was identified and partially characterized in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. The enzyme catalyzes the transamination of &amp;gamma;-aminobutyrate (GABA) to form succinic semialdehyde using pyruvate (and NOT &amp;alpha;-ketoglutarate) as amino acid acceptor and this molecular function was confirmed by recombinant expression of the enzyme in &lt;i&gt;E. coli&lt;/i&gt; |CITS:[VanCauwenberghe03]|. It could be demonstrated that the enzyme is also involved in pollen growth and guidance by regulating the GABA &lt;i&gt;in vivo&lt;/i&gt; |CITS:[12859897]|.</Comment>
      <Property key="UniqueID" value="CPLXQT-29" />
      <Property key="ComplexComponents" value="AT3G22200-MONOMER" />
      <Property key="ComponentCount" value="1" />
      <Property key="IsComplex" value="true" />
      <Property key="Catalyzes" value="RXN-33339, RXN-33338, RXN-33337, RXN-10460" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="^coefficient" value="2" />
      <Property key="InstanceNameTemplate" value="CPLX-*" />
      <Property key="MolecularWeightExp" value="112." />
      <Property key="MolecularWeightKd" value="112." />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_VANCAUWENBERGHE03" />
      <CitationRef elementRef="citation_PUB_12859897" />
    </Group>
  </Groups>
