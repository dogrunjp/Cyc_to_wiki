    <DataNode elementId="AT1G61850-MONOMER" textLabel="AT1G61850-MONOMER" type="Protein">
      <Xref identifier="O80693" dataSource="uniprot" />
      <Graphics centerX="600" centerY="735" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup, THE-ARABIDOPSIS-INFORMATION-RESOURCE, zhang">The At1G61850 encoded acyl hydrolase accepts a broad range of substrates. Among all, oxylipin-containing glycolipids MGDG and DGDG are the best substrates, followed by non-oxylipin MGDG and DGDG, and to a less extend PG. Among the phospholipids, PG is by far the best substrate, followed by PI, PC, and PE with a sn-1 hydrolysis preference. Also accepts PA and PS but with a sn-2 hydrolysis preference.</Comment>
      <Property key="UniqueID" value="AT1G61850-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G61850.2" />
      <Property key="AlternativeId_Uniprot" value="O80693" />
      <Property key="Synonym_1" value="AT1G61850.2" />
      <Property key="Catalyzes" value="RXN-33191, RXN-12684" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT1G61850.2" />
      <Property key="Gene" value="AT1G61850" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17475618" />
    </DataNode>
