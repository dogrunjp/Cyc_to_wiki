    <DataNode elementId="AT1G06800-MONOMER" textLabel="Phospholipase A1-Igamma1, chloroplastic" type="Protein">
      <Xref identifier="Q941F1" dataSource="uniprot" />
      <Graphics centerX="600" centerY="1055" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Purified recombinant protein was assayed for acylhydrolase activities. The enzyme hydrolyzed phosphatidylcholine, glycolipids (MGDG and DGDG) as well as triacylglycerol.</Comment>
