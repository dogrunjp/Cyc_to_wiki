    <DataNode elementId="AT5G04040-MONOMER" textLabel="Triacylglycerol lipase SDP1" type="Protein">
      <Xref identifier="Q9LZA6" dataSource="uniprot" />
      <Graphics centerX="150" centerY="1055" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The Arabidopsis triacylglycerol lipase encoded by SDP1 is located in the oil body membrane. It hydrolyzes triacylglycerol, and to a much less extent, diacylglycerol. The enzyme is inactive towards monoacylglycerol. SDP1 hydrolysis triacylglycerols containing medium- and long-chain saturated fatty acids and long-chain polyunsaturated fatty acids. The SDP1 mutant plant exhibits a much slower rate of postgerminative growth than the wild type. Whilst in the wild type plant seedlings, the TAG content declines 98% over the first 5 days period of postgermination, the mutant plant only have 20% TAG converted due to the impaired activity of this triacylglycerol lipase. The SDP1 gene is highly expressed during seed maturation and imbibition.</Comment>
      <Property key="UniqueID" value="AT5G04040-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G04040.1" />
      <Property key="AlternativeId_Uniprot" value="Q9LZA6" />
      <Property key="Synonym_1" value="SUGAR-DEPENDENT 1" />
      <Property key="Catalyzes" value="RXN-33483, RXN-12700" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G04040.1" />
      <Property key="Gene" value="AT5G04040" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_16473965" />
    </DataNode>
