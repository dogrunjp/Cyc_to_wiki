    <DataNode elementId="MONOMER-2361" textLabel="MONOMER-2361" type="Protein">
      <Xref identifier="MONOMER-2361" dataSource="plantcyc" />
      <Graphics centerX="900" centerY="695" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">This cellulose synthase isoform is involved in the primary cell wall cellulose synthesis. Transgenic plants expressing antisense cellulose synthase constructs have reduced cellulose content.</Comment>
      <Property key="UniqueID" value="MONOMER-2361" />
      <Property key="Synonym_1" value="cellulose synthase" />
