    <DataNode elementId="MONOMER-2362" textLabel="MONOMER-2362" type="Protein">
      <Xref identifier="MONOMER-2362" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">This cellulose synthase isoform is involved in the primary cell wall cellulose synthesis. Transgenic plants expressing antisense cellulose synthase constructs have reduced cellulose content. Over-expression of CesA3 does not complement the CesA1 mutant suggesting the two isoforms are not functional redundant.</Comment>
      <Property key="UniqueID" value="MONOMER-2362" />
      <Property key="Synonym_1" value="cellulose" />
      <Property key="Synonym_2" value="&amp;beta;-1,4-glucan synthase" />
      <Property key="Catalyzes" value="RXN-2502" />
      <Property key="Accession1" value="AT5G05170.1" />
      <Property key="Gene" value="AT5G05170" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation__12068120_" />
    </DataNode>
    <DataNode elementId="MONOMER-2365" textLabel="MONOMER-2365" type="Protein">
      <Xref identifier="MONOMER-2365" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cellulose content of CesA7 mutant is reduced by about 80%. The mutant has irregular xylem cell shape. All the evidence suggests that this cellulose synthase isoform is involved in the secondary cell wall cellulose synthesis.</Comment>
      <Property key="UniqueID" value="MONOMER-2365" />
      <Property key="Synonym_1" value="cellulose synthase" />
      <Property key="Synonym_2" value="&amp;beta;-1,4-glucan synthase" />
      <Property key="Catalyzes" value="RXN-2505" />
      <Property key="Accession1" value="AT5G17420.1" />
      <Property key="Gene" value="AT5G17420" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation__12165296_" />
