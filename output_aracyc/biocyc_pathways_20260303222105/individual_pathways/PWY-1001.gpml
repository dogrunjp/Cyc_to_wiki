    <DataNode elementId="MONOMER-2364" textLabel="MONOMER-2364" type="Protein">
      <Xref identifier="MONOMER-2364" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cellulose content of CesA4 mutant is reduced by about 80%. The mutant has irregular xylem cell shape. All the evidence suggests that this cellulose synthase isoform is involved in the secondary cell wall cellulose synthesis. The CesA4, CesA7, and CesA8 isoforms co-immunoprecipitate suggesting they are components of the same protein complex.</Comment>
      <Property key="UniqueID" value="MONOMER-2364" />
      <Property key="Synonym_1" value="AT5G44030.2" />
      <Property key="Synonym_2" value="cellulose synthase" />
      <Property key="Synonym_3" value="&amp;beta;-1,4-glucan synthase" />
      <Property key="Catalyzes" value="RXN-2504" />
      <Property key="Accession1" value="AT5G44030.2" />
      <Property key="Gene" value="AT5G44030" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation__12538856_" />
    </DataNode>
