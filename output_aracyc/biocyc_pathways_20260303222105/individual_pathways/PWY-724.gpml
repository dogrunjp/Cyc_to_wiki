    <DataNode elementId="AT5G21060-MONOMER" textLabel="putative homoserine dehydrogenase" type="Protein">
      <Xref identifier="Q2V358" dataSource="uniprot" />
      <Graphics centerX="300" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The annotations of this enzyme to the homoserine dehydrogenase reaction |FRAME: HOMOSERDEHYDROG-RXN 1.1.1.3| and aspartate kinase reaction |FRAME: ASPARTATEKIN-RXN 2.7.2.4| were removed based on a low level of sequence similarity |CITS: [RHEE10]|.</Comment>
      <Property key="UniqueID" value="AT5G21060-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G21060.2" />
