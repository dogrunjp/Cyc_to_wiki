      <Property key="Synonym_1" value="&lt;i&gt;N&lt;/i&gt;&lt;sup&gt;5&lt;/sup&gt;-methyl--H&lt;sub&gt;4&lt;/sub&gt;PteGlu&lt;sub&gt;3&lt;/sub&gt;" />
      <Property key="Synonym_2" value="&lt;i&gt;N&lt;/i&gt;&lt;sup&gt;5&lt;/sup&gt;-methyltetrahydropteroyl tri-L-glutamate" />
