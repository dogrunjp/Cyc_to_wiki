    </DataNode>
    <DataNode elementId="AT3G14390-MONOMER" textLabel="Diaminopimelate decarboxylase 1, chloroplastic" type="Protein">
      <Xref identifier="Q949X7" dataSource="uniprot" />
      <Graphics centerX="450" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">NIL Diaminopimelate decarboxylase activity was detected from plants in the 60&apos;s. The gene(s) encoding the enzyme has only been recently identified. Arabidopsis contains two diaminopimelate decarboxylase genes, both were able to functionally complement the E. coli lysA mutant.</Comment>
      <Property key="UniqueID" value="AT3G14390-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G14390.1" />
      <Property key="AlternativeId_Uniprot" value="Q949X7" />
      <Property key="Synonym_1" value="DAP decarboxylase 1" />
      <Property key="Synonym_2" value="DAPDC 1" />
      <Property key="Catalyzes" value="RXN-12391" />
      <Property key="Accession1" value="AT3G14390.1" />
      <Property key="Gene" value="AT3G14390" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_15652176" />
    </DataNode>
    <DataNode elementId="AT2G45440-MONOMER" textLabel="4-hydroxy-tetrahydrodipicolinate synthase 2, chloroplastic" type="Protein">
      <Xref identifier="Q9FVC8" dataSource="uniprot" />
      <Graphics centerX="600" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Plants that have a mutation in this gene generate lower levels of lysine and accumulate higher levels of its precursor aspartate |CITS: [11069709]|.</Comment>
      <Property key="UniqueID" value="AT2G45440-MONOMER" />
