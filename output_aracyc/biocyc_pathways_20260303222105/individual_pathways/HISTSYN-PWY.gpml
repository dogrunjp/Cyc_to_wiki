    </DataNode>
    <DataNode elementId="AT1G09795-MONOMER" textLabel="AT1G09795-MONOMER" type="Protein">
      <Xref identifier="AT1G09795-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="600" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The Arabidopsis genome has two genes encoding ATP-phosphoribosyl transferase, the enzyme catalyzing the first step in histidine biosynthesis. Protein sequences of both genes have a chloroplast transit signal peptide.</Comment>
