      <Property key="Locations" value="CCO-CW-PLANT" />
      <CitationRef elementRef="citation_PUB_19861655" />
    </DataNode>
    <DataNode elementId="AT4G24620-MONOMER" textLabel="glucose-6-phosphate isomerase" type="Protein">
      <Xref identifier="Q9SB57" dataSource="uniprot" />
      <Graphics centerX="150" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">An &lt;i&gt;Arabidopsis&lt;/i&gt; mutant (&lt;i&gt;pgi1-1&lt;/i&gt;) with a missense mutation of the &lt;i&gt;PGI1&lt;/i&gt; gene has a reduced plastidic phosphoglucose isomerase (PGI) activity representing only 6.5% of that of the wild-type |CITS:[10806248]|. The mutant is deficient in starch synthesis.</Comment>
