      <Property key="AlternativeId_Modbase" value="Q9ZQ99" />
      <Property key="Synonym_1" value="UDP glycosyltransferase 73C1" />
      <Property key="Catalyzes" value="RXN-15422, RXN-15424, RXN-15429, RXN-15443, RXN-15449, RXN-15435, RXN-6419, RXN-6422, RXN-6429, RXN-6432" />
