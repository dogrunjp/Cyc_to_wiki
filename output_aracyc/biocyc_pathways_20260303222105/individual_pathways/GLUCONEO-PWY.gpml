      <Property key="AlternativeId_Pdb" value="4OBT" />
      <Property key="AlternativeId_Uniprot" value="P48491" />
      <Property key="AlternativeId_Pid" value="CAB75902" />
      <Property key="Synonym_1" value="TIM" />
      <Property key="Synonym_2" value="Triose-phosphate isomerase" />
      <Property key="Catalyzes" value="RXN-13729" />
