      <Property key="Synonym_2" value="(9Z,12Z)-octadeca-9,12-dienoyl-CoA" />
      <Property key="Synonym_3" value="18:2(n-6)" />
      <Property key="ChemicalFormula" value="(C 39) (H 62) (N 7) (O 17) (P 3) (S 1)" />
      <Property key="AtomCharges" value="(54 -1), (52 -1), (57 -1), (55 -1)" />
