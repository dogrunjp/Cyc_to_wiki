    <DataNode elementId="AT2G39770-MONOMER" textLabel="AT2G39770-MONOMER" type="Protein">
      <Xref identifier="AT2G39770-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="495" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The characterization of the vtc1 mutant, which has a 75% reduction of ascorbic acid level compared to wild type plants, and the subsequent cloning of the vtc1 gene provided the first time strong genetic evidence for the plant ascorbic acid biosynthesis pathway. The vtc1 encoded GDP-D-mannose pyrophosphorylase provides GDP-D-mannose and thus directly supports the proposed plant pathway that ascorbic acid is synthesized via GDP-D-mannose.</Comment>
      <Property key="UniqueID" value="AT2G39770-MONOMER" />
      <Property key="Synonym_1" value="mannose-1-phosphate guanylyltransferase" />
      <Property key="Catalyzes" value="RXN-2428" />
      <Property key="Accession1" value="AT2G39770.1" />
      <Property key="Gene" value="AT2G39770" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightKd" value="40." />
      <Property key="MolecularWeightSeq" value="40." />
      <CitationRef elementRef="citation__10097187_" />
    </DataNode>
