    <DataNode elementId="AT2G39930-MONOMER" textLabel="Isoamylase 1, chloroplastic" type="Protein" groupRef="CPLX-8667">
      <Xref identifier="O04196" dataSource="uniprot" />
      <Graphics centerX="450" centerY="555" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">|FRAME: AT2G39930 ISA1| is an isoamylase in the model plant |FRAME: ORG-5993 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; col|. |FRAME: AT2G39930 ISA1| and |FRAME: AT1G03310 ISA2| appear to play a role in |FRAME: PWY-622 starch biosynthesis| whereas |FRAME: AT4G09020 ISA3| seems to participate in |FRAME: PWY-6724 starch degradation| |CITS: [15743447][16495218]|. &lt;i&gt;isa1&lt;/i&gt; mutants have an altered |FRAME: CPD-7043 amylopectin| structure and an increased level of an abnormal soluble polysaccharide called phytoglycogen |CITS:[15849301][15743447]|.</Comment>
      <Property key="UniqueID" value="AT2G39930-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G39930.1" />
      <Property key="AlternativeId_Uniprot" value="O04196" />
      <Property key="Synonym_1" value="AtISA1" />
      <Property key="Catalyzes" value="RXN-21580, RXN-9815, RXN-ARA-182" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT2G39930.1" />
      <Property key="ComponentOf" value="CPLX-8667" />
      <Property key="EnzymeNotUsedIn" value="PWY-622" />
      <Property key="FunctionalAssignmentStatus" value=":AMBIGUOUS" />
      <Property key="Gene" value="AT2G39930" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
    </DataNode>
