    <DataNode elementId="AT5G24300-MONOMER" textLabel="Starch synthase 1, chloroplastic/amyloplastic" type="Protein">
      <Xref identifier="Q9FNF2" dataSource="uniprot" />
      <Graphics centerX="150" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">SSI (SS1) is a soluble starch synthase involved in the formation of |FRAME: CPD-7043 amylopectin|. It preferentially acts on glucan chains that have 9-10 glucans |CITS: [23393426]|. Analyses of the phenotype of &lt;i&gt;ss1&lt;/i&gt; mutants suggest that this enzyme plays an important role in transient starch biosynthesis in the leaves |CITS: [16045475 ]|.</Comment>
      <Property key="UniqueID" value="AT5G24300-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G24300.1" />
      <Property key="AlternativeId_Cazy" value="GT5" />
      <Property key="AlternativeId_Pride" value="Q9FNF2" />
      <Property key="AlternativeId_Smr" value="Q9FNF2" />
      <Property key="AlternativeId_Pfam" value="PF08323" />
      <Property key="AlternativeId_Interpro" value="IPR001296" />
      <Property key="AlternativeId_Uniprot" value="Q9FNF2" />
      <Property key="Synonym_1" value="AtSS1" />
      <Property key="Synonym_2" value="SSS" />
      <Property key="Synonym_3" value="Soluble starch synthase I" />
      <Property key="Catalyzes" value="RXN-16347" />
      <Property key="Accession1" value="AT5G24300.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT5G24300" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_23393426" />
    </DataNode>
    <DataNode elementId="AT1G03310-MONOMER" textLabel="isoamylase non-catalytic subunit" type="Protein" groupRef="CPLX-8667">
      <Xref identifier="Q8L735" dataSource="uniprot" />
      <Graphics centerX="345.0" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup, PMN, dreher">|FRAME: AT1G03310 ISA2| is plastidial protein that shows sequence similarity with isoamylases, but, is predicted to act as a non-catalytic subunit of a |FRAME: CPLX-8667 heteromultimeric isoamylase| in the model plant |FRAME: ORG-5993 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; col| |CITS: [12509527][15743447][23393426]|. |FRAME: AT2G39930 ISA1| and |FRAME: AT1G03310 ISA2| appear to play a role in |FRAME: PWY-622 starch biosynthesis| whereas |FRAME: AT4G09020 ISA3| seems to participate in |FRAME: PWY-6724 starch degradation| |CITS: [15743447][16495218]|. Given its importance in forming a functional isoamylase complex, &lt;i&gt;isa2&lt;/i&gt; mutants have an altered |FRAME: CPD-7043 amylopectin| structure and an increased level of an abnormal soluble polysaccharide called phytoglycogen |CITS:[15849301][15743447]|.</Comment>
      <Property key="UniqueID" value="AT1G03310-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G03310.1" />
      <Property key="AlternativeId_Smart" value="SM00642" />
      <Property key="AlternativeId_Interpro" value="IPR014756" />
      <Property key="AlternativeId_Pfam" value="PF02922" />
      <Property key="AlternativeId_Smr" value="Q8L735" />
      <Property key="AlternativeId_Pride" value="Q8L735" />
      <Property key="AlternativeId_Cazy" value="GH13" />
      <Property key="AlternativeId_Panther" value="PTHR10357" />
      <Property key="AlternativeId_Uniprot" value="Q8L735" />
