  <Groups>
    <Group elementId="CPLX-8667" textLabel="isoamylase" type="Complex">
      <Xref identifier="CPLX-8667" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="635" width="230" height="100" textColor="666666" fontName="Arial" fontSize="10" borderColor="9900CC" borderStyle="Dashed" borderWidth="2.0" fillColor="F5E6FF" shapeType="Rectangle" zOrder="-1" />
      <Comment source="PMN, dreher">The isoamylase enzyme involved in starch biosynthesis in the chloroplasts of leaves is a large heteromultimeric complex composed of catalytically active |FRAME: AT2G39930 ISA1| subunits as well as the |FRAME: AT1G03310 ISA2| subunit which is assumed to lack catalytic activity based on findings from potato |CITS: [15743447][15849301][12509527]|. The stoichiometry of this complex has not been determined in |FRAME: ORG-5993 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; col| but in rice, the heteromeric isoamylase is a hexamer composed of five |FRAME: AT2G39930 ISA1| subunits and one |FRAME:AT1G03310 ISA2| subunit |CITS: [16953433]|. This enzymatic complex is believed to play a role in partially debranching preamylopectin to allow the formation of the normal crystalline starch structure.Both &lt;i&gt;isa1&lt;/i&gt; and &lt;i&gt;isa2&lt;/i&gt; mutants have reduced starch levels and altered polysaccharide compositions consistent with a decrease in debranching activity |CITS: [15743447][15849301]|.</Comment>
      <Property key="UniqueID" value="CPLX-8667" />
      <Property key="ComplexComponents" value="AT2G39930-MONOMER, AT1G03310-MONOMER" />
      <Property key="ComponentCount" value="2" />
      <Property key="IsComplex" value="true" />
      <Property key="Catalyzes" value="RXN-21581" />
      <Property key="InstanceNameTemplate" value="CPLX-*" />
      <Property key="MolecularWeightExp" value="500." />
      <Property key="MolecularWeightKd" value="500." />
      <Property key="Species" value="ORG-5993" />
      <CitationRef elementRef="citation_PUB_16953433" />
    </Group>
  </Groups>
