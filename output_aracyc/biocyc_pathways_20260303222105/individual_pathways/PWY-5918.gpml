      <Property key="Synonym_3" value="GSA-AM" />
      <Property key="Synonym_4" value="AT5g63570" />
      <Property key="Catalyzes" value="RXN-1F-2217, RXN-6834" />
      <Property key="CatalyzesCount" value="2" />
