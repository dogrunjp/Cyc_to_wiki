    <DataNode elementId="AT1G58290-MONOMER" textLabel="Glutamyl-tRNA reductase 1, chloroplastic" type="Protein">
      <Xref identifier="P42804" dataSource="uniprot" />
      <Graphics centerX="450" centerY="555" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Glutamyl-tRNA reductase (GluTR) is an unusual enzyme which catalyzes the NADPH-dependent reduction of the loaded tRNA Glu-tRNA&lt;sup&gt;Glu&lt;/sup&gt; to glutamate 1-semialdehyde (GSA) with the release of free tRNA&lt;sup&gt;Glu&lt;/sup&gt;. The enzyme recognizes the tRNA cofactor in a nucleotide sequence-specific fashion and does not discriminate on the basis of the activated amino acid |CITS:[7908550]|. The &lt;i&gt;Arabidopsis thaliana HEMA1&lt;/i&gt; gene was heterologously expressed in the &lt;i&gt;hemA E. coli&lt;/i&gt; strain lacking the endogenous GluTR enzyme. The &lt;i&gt;Arabidopsis&lt;/i&gt; gene was shown to complement the mutation, thereby confirming that &lt;i&gt;AtHEMA1&lt;/i&gt; encodes for GluTR |CITS:[7908550]|.</Comment>
      <Property key="UniqueID" value="AT1G58290-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G58290.1" />
      <Property key="AlternativeId_Swissmodel" value="P42804" />
      <Property key="AlternativeId_Modbase" value="P42804" />
      <Property key="AlternativeId_Uniprot" value="P42804" />
      <Property key="AlternativeId_Pid" value="NP_176125" />
      <Property key="Synonym_1" value="GluTR" />
      <Property key="Catalyzes" value="RXN-1F-496" />
