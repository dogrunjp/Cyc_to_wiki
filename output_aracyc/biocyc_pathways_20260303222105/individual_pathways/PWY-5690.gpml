      <Property key="Osmolarity" value="0" />
      <Property key="Regulates" value="REG-15265, REG-8065, REGQT-387" />
      <Property key="Smiles" value="C([R])C(\C)=C/CC1(\C(\O)=C(C(\OC)=C(C(/C)=1)\O)\OC)" />
      <CitationRef elementRef="citation_PUB_16233343" />
