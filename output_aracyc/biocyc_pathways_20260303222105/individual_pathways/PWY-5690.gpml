    <DataNode elementId="AT5G50950-MONOMER" textLabel="fumarase" type="Protein">
      <Xref identifier="Q9FI53" dataSource="uniprot" />
      <Graphics centerX="150" centerY="515" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, dreher">FUM2 is one of two fumarase enzymes present in |FRAME: ORG-5993 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; col|. While |FRAME: AT2G47510-MONOMER FUM1| localizes to the mitochondria, FUM2 appears to be a cytosolic form of the enzyme |CITS: [20202172]|. FUM2 appears to be required for the formation of fumarate from malate in Arabidopsis leaves. A role for FUM2 in nitrogen assimilation in the light is suggested by the shift from N-containing amino acids to N-free organic acids in &lt;i&gt;fum2&lt;/i&gt; mutants |CITS: [20202172]|. However, FUM2 does not appear to be required for lipid metabolism and growth in seedlings |CITS: [20202172]|. The phenotype of reduced |FRAME: FUM fumarate| and increased |FRAME: MAL (&lt;i&gt;S&lt;/i&gt;)-malate| in &lt;i&gt;fum2&lt;/i&gt; mutants suggests that FUM2 primarily catalyzes malate dehydration during the day, however, further enzymatic characterization will be required to establish whether FUM2 also catalyzes the reverse reaction, and, if so, under what conditions |CITS: [20202172]|.</Comment>
      <Property key="UniqueID" value="AT5G50950-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G50950.1" />
      <Property key="AlternativeId_Tair" value="AT5G0950" />
      <Property key="AlternativeId_Smr" value="Q9FI53" />
      <Property key="AlternativeId_Prints" value="PR00149" />
      <Property key="AlternativeId_Pride" value="Q9FI53" />
      <Property key="AlternativeId_Interpro" value="IPR022761" />
      <Property key="AlternativeId_Pfam" value="PF00206" />
      <Property key="AlternativeId_Phylomedb" value="Q9FI53" />
      <Property key="AlternativeId_Prosite" value="PS00163" />
      <Property key="AlternativeId_Panther" value="PTHR11444" />
      <Property key="AlternativeId_Uniprot" value="Q9FI53" />
      <Property key="Synonym_1" value="fumarate hydratase" />
      <Property key="Catalyzes" value="RXN-17847" />
      <Property key="Accession1" value="AT5G50950.1" />
      <Property key="Gene" value="AT5G50950" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_20202172" />
    </DataNode>
    <DataNode elementId="AT5G03290-MONOMER" textLabel="Isocitrate dehydrogenase [NAD] catalytic subunit 5, mitochondrial" type="Protein" groupRef="CPLXQT-51">
      <Xref identifier="AT5G03290-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="515" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The IDH-V gene is predicted to encode a catalytic subunit of the mitochondrially-localized NAD+-dependent isocitrate dehydrogenase |CITS:[17468208][14671022]|. &lt;i&gt;idhv&lt;/i&gt; mutants have reduced levels of NAD+-dependent isocitrate dehydrogenase activity |CITS: [17468208]|. In addition, IDH-V can functionally complement a yeast &lt;i&gt;idh1 idh 2&lt;/i&gt; NAD+-dependent isocitrate dehydrogenase mutant when co-expressed with an IDH regulatory subunit (|FRAME: AT4G35260|, |FRAME: AT2G17130|, or |FRAME: AT4G35650|) |CITS: [16527867]|.</Comment>
      <Property key="UniqueID" value="AT5G03290-MONOMER" />
      <Property key="Synonym_1" value="IDH-V" />
      <Property key="Synonym_2" value="Isocitric dehydrogenase 5" />
      <Property key="Synonym_3" value="NAD(+)-specific ICDH 5" />
      <Property key="Catalyzes" value="RXN-6877" />
      <Property key="GOTerms" value="GO:0005739" />
      <Property key="Accession1" value="AT5G03290.1" />
      <Property key="ComponentOf" value="CPLXQT-51" />
      <Property key="Gene" value="AT5G03290" />
      <Property key="^citations" value="14671022" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-MIT-PL" />
    </DataNode>
