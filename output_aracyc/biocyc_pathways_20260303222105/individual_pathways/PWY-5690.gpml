    <DataNode elementId="AT4G35650-MONOMER" textLabel="Isocitrate dehydrogenase [NAD] regulatory subunit 3, mitochondrial" type="Protein">
      <Xref identifier="AT4G35650-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The IDH-III gene encodes a regulatory subunit of the mitochondrially-localized NAD+-dependent isocitrate lyase based on its ability to functionally complement a mutation in the IDH1 gene from &lt;i&gt;S.cerevisiae&lt;/i&gt; |CITS: [16527867][14671022]|. Although IDH-III, |FRAME: AT4G35260|, and |FRAME: AT2G17130| are all believed to act as regulatory subunits of the NAD+-dependent isocitrate lyase, IDH-III appears to have the most restricted expression pattern and is found primarily in the pollen |CITS: [16527867]|.</Comment>
      <Property key="UniqueID" value="AT4G35650-MONOMER" />
      <Property key="Synonym_1" value="IDH-III" />
      <Property key="Synonym_2" value="Isocitric dehydrogenase 3" />
      <Property key="Synonym_3" value="NAD(+)-specific ICDH 3" />
      <Property key="Catalyzes" value="RXN-5954" />
      <Property key="GOTerms" value="GO:0005739" />
      <Property key="Accession1" value="AT4G35650.1" />
      <Property key="Gene" value="AT4G35650" />
      <Property key="^citations" value="14671022" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-MIT-PL" />
      <CitationRef elementRef="citation_PUB_16527867" />
    </DataNode>
    <DataNode elementId="AT2G05710-MONOMER" textLabel="Aconitate hydratase 3, mitochondrial" type="Protein">
      <Xref identifier="AT2G05710-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">ACO3 is an aconitase that can catalyze the conversion of |FRAME: CIT| to |FRAME: THREO-DS-ISO-CITRATE| through a |FRAME: CIS-ACONITATE| intermediate, based on the phenotype of reduced aconitase activity in an &lt;i&gt;aco3&lt;/i&gt; mutant |CITS: [17013749]|. ACO3 may participate in the TCA cycle and other primary metabolic pathways and it is believed to accumulate in the mitochondria and the cytosol |CITS: [17013749]|. &lt;i&gt;aco3&lt;/i&gt; mutants have an elevated level of transcripts for |FRAME: AT2G28190|, which encodes a superoxide dismutase, and show enhanced tolerance to oxidative stress. Interestingly, one member of the aconitase family, |FRAME: AT4G35830-MONOMER ACO1|, was shown to specifically bind to the 5&apos; UTR of |FRAME: AT2G28190| &lt;i&gt;in vitro&lt;/i&gt; |CITS: [17013749]|.</Comment>
      <Property key="UniqueID" value="AT2G05710-MONOMER" />
      <Property key="Synonym_1" value="Aconitase 3" />
      <Property key="Synonym_2" value="mACO1" />
      <Property key="Synonym_3" value="Citrate hydro-lyase 3" />
      <Property key="Catalyzes" value="RXN-33229, RXN-10603, RXN-ARA-720" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT2G05710.1" />
      <Property key="Gene" value="AT2G05710" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_17013749" />
    </DataNode>
    <DataNode elementId="AT4G26970-MONOMER" textLabel="Aconitate hydratase 2, mitochondrial" type="Protein">
      <Xref identifier="AT4G26970-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">ACO2 is an aconitase that can catalyze the conversion of |FRAME: CIT| to |FRAME: THREO-DS-ISO-CITRATE| through a |FRAME: CIS-ACONITATE| intermediate, based on the phenotype of reduced aconitase activity in an &lt;i&gt;aco2&lt;/i&gt; mutant |CITS: [17013749]|. ACO2 may participate in the TCA cycle and other primary metabolic pathways and it is believed to accumulate in the mitochondria and the cytosol |CITS: [17013749]|. &lt;i&gt;aco2&lt;/i&gt; mutants have an elevated level of transcripts for |FRAME: AT2G28190|, which encodes a superoxide dismutase, and show enhanced tolerance to oxidative stress. Interestingly, one member of the aconitase family, |FRAME: AT4G35830-MONOMER ACO1|, was shown to specifically bind to the 5&apos; UTR of |FRAME: AT2G28190| &lt;i&gt;in vitro&lt;/i&gt; |CITS: [17013749]|.</Comment>
      <Property key="UniqueID" value="AT4G26970-MONOMER" />
      <Property key="Synonym_1" value="Aconitase 2" />
      <Property key="Synonym_2" value="mACO2" />
      <Property key="Synonym_3" value="Citrate hydro-lyase 2" />
      <Property key="Catalyzes" value="RXN-33427, RXN-T9-491, RXN-6065" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT4G26970.1" />
      <Property key="Gene" value="AT4G26970" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_17013749" />
    </DataNode>
    <DataNode elementId="AT5G08300.1" textLabel="AT5G08300.1" type="Protein">
      <Xref identifier="AT5G08300.1" dataSource="plantcyc" />
      <Graphics centerX="600" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
