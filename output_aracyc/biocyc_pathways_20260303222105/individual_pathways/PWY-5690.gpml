    <DataNode elementId="AT5G09600-MONOMER" textLabel="complex II subunit 3-1" type="Protein">
      <Xref identifier="AT5G09600-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="755" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">This is predicted to encode subunit 3-1 of the mitochondrial complex II that plays a role in the respiratory chain. This subunit may contribute to the succinate dehydrogenase activity of the complex when it is part of it |CITS: [15604729]|</Comment>
