    <DataNode elementId="CPD-24201" textLabel="9,10-DiHOME" type="Metabolite">
      <Xref identifier="XEBKSQSGNGRGDW-YFHOEESVSA-M" dataSource="InChIKey" />
      <Graphics centerX="650" centerY="880" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="AU4FS-4, SRI, caspi">|FRAME: CPD-13636|, also known as leukotoxin or coronaric acid, is an epoxy fatty acid produced by oxygenation of linoleate. |FRAME: CPD-13636| shows antifungal and antibacterial activity, and its production in neutrophlls is considered a defensive response to infection. Over-production of leukotoxin, which is associated with severe infection, results in the genesis of coagulating abnormalities |CITS: [3947358][3345035][3398695][2384990]|. Leukotoxin has also been associated with the multiple organ failure and adult respiratory distress syndrome seen in some severe burn patients |CITS: [7862104]|. Leukotoxin itself has been shown not to be toxic. Rather, it is acted upon by soluble epoxide hydrolase, and the resulting diol, |FRAME: CPD-24201|, is the toxic form |CITS: [9142128]|.</Comment>
      <Property key="UniqueID" value="CPD-24201" />
      <Property key="AlternativeId_Chebi" value="84027" />
      <Property key="AlternativeId_LigandCpd" value="C14828" />
      <Property key="AlternativeId_Hmdb" value="HMDB0004704" />
      <Property key="Synonym_1" value="9,10-Hydroxyoctadec-12(Z)-enoate" />
      <Property key="Synonym_2" value="9,10-DHOA" />
      <Property key="Synonym_3" value="9,10-dihydroxy-(12Z)-octadecenoate" />
      <Property key="Synonym_4" value="(12Z)-9,10-dihydroxyoctadecenoate" />
      <Property key="Synonym_5" value="(12&lt;i&gt;Z&lt;/i&gt;)-9,10-dihydroxydec-12-enoate" />
      <Property key="Synonym_6" value="leukotoxin diol" />
      <Property key="Synonym_7" value="(12&lt;i&gt;Z&lt;/i&gt;)-9,10-dihydroxydec-12-enoic acid" />
      <Property key="Synonym_8" value="(&amp;plusmn;)9,10-DiHOME" />
      <Property key="Synonym_9" value="(&amp;plusmn;)9,10-DHOA" />
      <Property key="ChemicalFormula" value="(C 18) (H 33) (O 4)" />
