      <Property key="AlternativeId_Pfam" value="PF01593" />
      <Property key="AlternativeId_Phylomedb" value="Q9FNA2" />
      <Property key="AlternativeId_Uniprot" value="Q9FNA2" />
      <Property key="Synonym_1" value="AtPAO1" />
      <Property key="Synonym_2" value="N(1)-acetylpolyamine oxidase" />
      <Property key="Synonym_3" value="Spermine oxidase" />
      <Property key="Catalyzes" value="RXN-33930, RXN-33929, RXN-33928, RXN-13408, RXN-16490, RXN-13407, RXN-6597" />
