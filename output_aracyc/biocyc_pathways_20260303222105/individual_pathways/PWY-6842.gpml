    <DataNode elementId="AT4G39640-MONOMER" textLabel="Glutathione hydrolase 1" type="Protein">
      <Xref identifier="Q8VYW6" dataSource="uniprot" />
      <Graphics centerX="150" centerY="915" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA (GGT1) encoding &amp;gamma;-glutamyltransferase (syn. &amp;gamma;-glutamyl transpeptidase, EC 2.3.2.2) was identified in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; and its physiological role and impact investigated by means of knock-out mutants. The protein is considered a key enzyme involved in the degradation of glutathione cleaving the gamma-peptide bond between glutamate and cysteine. It also mitigates oxidative stress by metabolizing oxidized glutathione (GSSG) in the apoplast. GGT1 is expressed in the whole plant but strongest in leaves. It has been found in the extracellular space bound to cell wall and plasma membrane, predominantly located in vascular tissues such as the phloem |CITS: [17316175]|.</Comment>
      <Property key="UniqueID" value="AT4G39640-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G39640.1" />
      <Property key="AlternativeId_Uniprot" value="Q8VYW6" />
      <Property key="Synonym_1" value="Gamma-glutamyltransferase 1" />
      <Property key="Synonym_2" value="Gamma-glutamyltranspeptidase 1" />
      <Property key="Catalyzes" value="RXN-33903, RXN-ARA-220, RXN-9510" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT4G39640.1" />
      <Property key="Gene" value="AT4G39640" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17316175" />
    </DataNode>
    <DataNode elementId="AT4G29210-MONOMER" textLabel="Glutathione hydrolase 3" type="Protein">
      <Xref identifier="Q9M0G0" dataSource="uniprot" />
      <Graphics centerX="300" centerY="915" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA (GGT4) encoding &amp;gamma;-glutamyltransferase (syn. &amp;gamma;-glutamyl transpeptidase, EC 2.3.2.2) was identified and its physiological role and impact investigated in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. The protein is considered a key enzyme involved in the degradation of glutathione cleaving the &amp;gamma;-peptide bond between glutamate and cysteine. Although seemingly expressed throughout the plant it has its highest activity in roots. It has been proposed that GGT4 may contribute to xenobiotics metabolism by processing the sequestration and further metabolism of glutathione conjugates. GGT4 is specifically expressed in vacuoles which distinguished it from the apoplastic GGT1 and GGT2 |CITS: [17316176]|. Please note: This gene / enzyme was originally referred to as GGT3 in |CITS: [17316176 ]|, however, the authors later called it GGT4 |CITS: [18768907]|, in keeping with the nomeclature used in |CITS: [17545509][17561001]|.</Comment>
      <Property key="UniqueID" value="AT4G29210-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G29210.1" />
      <Property key="AlternativeId_Uniprot" value="Q9M0G0" />
      <Property key="Synonym_1" value="Gamma-glutamyltransferase 3" />
      <Property key="Synonym_2" value="Gamma-glutamyltranspeptidase 3" />
      <Property key="Synonym_3" value="Gamma-glutamyltranspeptidase 4" />
      <Property key="Catalyzes" value="RXN-19409, RXN-ARA-136, RXN-9512" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="GOTerms" value="GO:0005773" />
      <Property key="Accession1" value="AT4G29210.1" />
      <Property key="Gene" value="AT4G29210" />
      <Property key="^citations" value="17316176" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCO-VACUOLE" />
