    <DataNode elementId="AT4G39650-MONOMER" textLabel="Glutathione hydrolase 2" type="Protein">
      <Xref identifier="Q680I5" dataSource="uniprot" />
      <Graphics centerX="600" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA (GGT1) encoding &amp;gamma;-glutamyltransferase (syn. &amp;gamma;-glutamyl transpeptidase, EC 2.3.2.2) was identified in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; and its physiological role and impact investigated by means of knock-out mutants. The protein is considered a key enzyme involved in the degradation of glutathione cleaving the &amp;gamma;-peptide bond between glutamate and cysteine. It has been proposed that GGT2 may be involved in the &amp;gamma;-glutamyl cycle and the formation of &amp;gamma;-glutamyl amino acids. In contrast to GGT1 GGT2 is only expressed in special tissues and is limited to the apoplastic portion of developing siliques |CITS: [17316175]|.</Comment>
      <Property key="UniqueID" value="AT4G39650-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G39650.1" />
      <Property key="AlternativeId_Uniprot" value="Q680I5" />
      <Property key="Synonym_1" value="Gamma-glutamyltransferase 2" />
      <Property key="Synonym_2" value="Gamma-glutamyltranspeptidase 2" />
      <Property key="Catalyzes" value="RXN-33906, RXN-ARA-277, RXN-9511" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT4G39650.1" />
      <Property key="Gene" value="AT4G39650" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17316175" />
    </DataNode>
