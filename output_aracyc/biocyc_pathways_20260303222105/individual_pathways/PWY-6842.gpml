    <DataNode elementId="AT5G44070-MONOMER" textLabel="Glutathione gamma-glutamylcysteinyltransferase 1" type="Protein">
      <Xref identifier="Q9S7Z3" dataSource="uniprot" />
      <Graphics centerX="1500" centerY="1155" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Heterologous expression and in vitro analysis of the Arabidopsis phytochelatin synthase (PCS1) indicated that it has dual functions, formation of phytochelatins and degradation of glutathione-S-conjugates (GS-conjugates). The former role is the result of &amp;gamma;-glutamylcysteine transpeptidation onto glutathione or isoglutathiones, the catalytic role reflects transpeptidation of S-glutamylcysteinyl-adducts onto water. The catalytic conversion was shown efficiently reduced by increasing glutathione concentrations. Under comparable assay conditions, the catalytic role was two times more efficient than the phytochelatin synthesis role. Several GS-conjugates were metabolized by the Arabidopsis PCS1, including bimane-GS, benzyl-GS, nitrobenzyl-GS, and phenylbenzyl-GS.</Comment>
      <Property key="UniqueID" value="AT5G44070-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G44070.1" />
      <Property key="AlternativeId_Uniprot" value="Q9S7Z3" />
      <Property key="Synonym_1" value="Cadmium tolerance protein" />
      <Property key="Synonym_2" value="Phytochelatin synthase 1" />
      <Property key="Synonym_3" value="AtPCS1" />
      <Property key="Catalyzes" value="RXN-19408, RXN-6686" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G44070.1" />
      <Property key="Gene" value="AT5G44070" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
    </DataNode>
