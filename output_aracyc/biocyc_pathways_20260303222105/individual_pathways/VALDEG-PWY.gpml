  <Groups>
    <Group elementId="CPLXQT-2" textLabel="CPLXQT-2" type="Complex">
      <Xref identifier="CPLXQT-2" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="335" width="140" height="100" textColor="666666" fontName="Arial" fontSize="10" borderColor="9900CC" borderStyle="Dashed" borderWidth="2.0" fillColor="F5E6FF" shapeType="Rectangle" zOrder="-1" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, zhang">Like other keto-acid dehydrogenase complexes such as the pyruvate dehydrogenase complex and the alpha-ketoglutarate dehydrogenase complex, the branched-chain keto-acid dehydrogenase complex has three components, E1 (alpha-keto acid dehydrogenase which catalyzes the decarboxylation of alpha-keto acids), E2 (lipoic acid-containing acyltransferase which esterifies aldehydes to CoA), and E3 (lipoamide dehydrogenase which reduces NAD+ to NADH). The E1 subunit is further composed of E1 &amp;alpha; and E1 &amp;beta; subunits. The Arabidopsis BCKDC E2 subunit has been detected in isolated mitochondria. It appears as a 50 kDa protein. The enzyme activity was detected with alpha-keto acids derived from all three branched-chain amino acids|CITS: [14764908]|. cDNAs encoding the E1 &amp;beta; and E2 subunits were isolated. Southern blot indicated the Arabidopsis genome contains two copies of the E1 &amp;beta; gene and a single copy of the E2 gene. Both E1 &amp;beta; and E2 expression are induced by dark treatment and sugar starvation|CITS: [10681595]|.</Comment>
      <Property key="UniqueID" value="CPLXQT-2" />
      <Property key="ComplexComponents" value="CPLXQT-1, AT3G06850-MONOMER, AT3G17240-MONOMER" />
      <Property key="ComponentCount" value="3" />
      <Property key="IsComplex" value="true" />
      <Property key="Catalyzes" value="RXN-9469, RXN-9464, RXN-9460" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="GOTerms" value="GO:0005739" />
      <Property key="^coefficient" value="24" />
      <Property key="^citations" value="14764908" />
      <Property key="InstanceNameTemplate" value="CPLX-*" />
      <Property key="Locations" value="CCI-MIT-PL" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_14764908" />
      <CitationRef elementRef="citation_PUB_10681595" />
    </Group>
  </Groups>
