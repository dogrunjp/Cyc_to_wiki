      <Property key="MolecularWeightKd" value="43." />
      <CitationRef elementRef="citation_PUB_DASCHNER01" />
    </DataNode>
    <DataNode elementId="AT1G10070-MONOMER" textLabel="AT1G10070-MONOMER" type="Protein">
      <Xref identifier="AT1G10070-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Atbcat-2 (AT1G10070), Atbcat-3 (AT3G49680) and Atbcat-5 (AT5G65780) each encodes a chloroplast branched-chain amino acid aminotransferase. They can complement the yeast leu/iso-leu/val auxotrophy mutant. The location of the enzymes in chloroplast suggested their roles in branched-chain amino acid biosynthesis.</Comment>
