    <DataNode elementId="AT5G65940-MONOMER" textLabel="3-hydroxyisobutyryl-CoA hydrolase 1" type="Protein">
      <Xref identifier="Q9LKJ1" dataSource="uniprot" />
      <Graphics centerX="150" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The Arabidopsis CHY1 (AT5G65940) mutant can be functionally complemented by a human 3-hydroxyisobutyryl-CoA hydrolase, which indicates the CHY1 gene encodes a similar enzyme. The activity of CHY1 was confirmed by in vitro assay of a CHY1 recombinant protein, expressed and purified from E. coli. The in vitro results indicated CHY1 is specific for 3-hydroxyisobutyryl-CoA. Other CoA esters were not effectively used by the enzyme.</Comment>
      <Property key="UniqueID" value="AT5G65940-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G65940.1" />
      <Property key="AlternativeId_Uniprot" value="Q9LKJ1" />
      <Property key="Synonym_1" value="CoA-thioester hydrolase CHY1" />
      <Property key="Catalyzes" value="RXN-34010, RXN-6289" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="GOTerms" value="GO:0005777" />
