    <DataNode elementId="AT1G70310-MONOMER" textLabel="Spermidine synthase 2" type="Protein">
      <Xref identifier="AT1G70310-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis SPDS2&lt;/i&gt; gene was expressed in two heterologous expression systems: yeast and &lt;i&gt;E. coli&lt;/i&gt; |CITS:[12220656]|. The enzyme was shown to be able to catalyze the formation of spermidine but not spermine.</Comment>
      <Property key="UniqueID" value="AT1G70310-MONOMER" />
      <Property key="Synonym_1" value="SPDSY 2" />
      <Property key="Synonym_2" value="Putrescine aminopropyltransferase 2" />
      <Property key="Catalyzes" value="RXN-4597" />
      <Property key="Accession1" value="AT1G70310.1" />
      <Property key="Gene" value="AT1G70310" />
