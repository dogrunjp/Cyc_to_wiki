    <DataNode elementId="MONOMER-6102" textLabel="UDP-glucose:phenylacetothiohydroximate glucosyltransferase" type="Protein">
      <Xref identifier="O48676" dataSource="uniprot" />
      <Graphics centerX="150" centerY="555" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The recombinant enzyme was in vitro assayed with the commercially available substrate phenylacetothiohydroximate. And the product was confirmed as the expected desulfobenzylglucosinolate. UGT74B1 does not act with IAA, or salicylic acid. The UGT74B1 mutant accumulates less than half of all glucosinolates measured, compared with the wild type plants, including methionine-, tryptophan- and phenylalanine-derived glucosinolates. It indicates that UGT74B1 is involved in the glucosylation step for all glucosinolate biosynthesis.</Comment>
      <Property key="UniqueID" value="MONOMER-6102" />
      <Property key="AlternativeId_Araport" value="AT1G24100.1" />
      <Property key="AlternativeId_Uniprot" value="O48676" />
      <Property key="Synonym_1" value="UGT74B1" />
      <Property key="Catalyzes" value="RXN-33151, RXN-12786, RXN-12787, RXN-12788, RXN-12489, RXN-12490, RXN-12491, RXN-12492, RXN-12493" />
      <Property key="CatalyzesCount" value="9" />
      <Property key="Accession1" value="AT1G24100.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT1G24100" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_15584955" />
    </DataNode>
