    <DataNode elementId="AT3G10550-MONOMER" textLabel="inositol or phosphatidylinositol phosphatase" type="Protein">
      <Xref identifier="Q9LPP2" dataSource="uniprot" />
      <Graphics centerX="600" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Purified recombinant protein was assayed for phosphatase activities. The Arabidopsis enzyme displayed 3&apos;-phosphatase activity against both Phosphatidylinositol-3,5-bisphosphate (PtdIns3,5P2) and Phosphatidylinositol-3-phosphate (PtdIns3P). Its activity was higher with PtdIns3,5P2 than with PtdIns3P indicating that the bi-phosphate is a preferred substrate for AtMTM1 (At3g10550).</Comment>
      <Property key="UniqueID" value="AT3G10550-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G10550.1" />
      <Property key="AlternativeId_Uniprot" value="Q9LPP2" />
      <Property key="Catalyzes" value="RXN-12831, RXN-T9-363" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT3G10550.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT3G10550" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_19901554" />
    </DataNode>
