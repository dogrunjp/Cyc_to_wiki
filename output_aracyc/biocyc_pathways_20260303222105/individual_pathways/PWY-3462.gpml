      <CitationRef elementRef="citation_PUB_10564818" />
    </DataNode>
    <DataNode elementId="AT5G22630-MONOMER" textLabel="Arogenate dehydratase 5, chloroplastic" type="Protein">
      <Xref identifier="Q9FNJ8" dataSource="uniprot" />
      <Graphics centerX="450" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">There are six genes in the Arabidopsis genome previously predicted as prephenate dehydratase based on sequence similarity. Warpeha et al. demonstrated that PD1, encoded by one of the six genes, has prephenate dehydratase activity|CITS: [16415218]| in vitro. However arogenate was not tested as an alternative substrate in that study. Thus it was not clear whether or not prephenate is the preferred substrate. Subsequently, Cho et al.|CITS: [17726025]| expressed all six genes in E. coli and analyzed enzyme activities of the recombinant proteins. It was shown that three of them (AT2G27820, AT3G44720, At5G22630) lack any detectable activity towards prephenate, and the other three had significantly higher activity with arogenate than prephenate. The catalytic efficiency (Kcat/Km) for arogenate was 98-, 28- and 32-fold higher than that of prephenate when tested with AT1G08250, AT1G11790 and At3G07630, respectively. Consequently all six genes were re-annotated as arogenate dehydratase.</Comment>
      <Property key="UniqueID" value="AT5G22630-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G22630.1" />
      <Property key="AlternativeId_Uniprot" value="Q9FNJ8" />
      <Property key="Synonym_1" value="AtADT5" />
      <Property key="Catalyzes" value="RXN-10482" />
      <Property key="Accession1" value="AT5G22630.1" />
      <Property key="Gene" value="AT5G22630" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_16415218" />
      <CitationRef elementRef="citation_PUB_17726025" />
    </DataNode>
    <DataNode elementId="AT2G27820-MONOMER" textLabel="Arogenate dehydratase 3, chloroplastic" type="Protein">
      <Xref identifier="Q9ZUY3" dataSource="uniprot" />
      <Graphics centerX="600" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">There are six genes in the Arabidopsis genome previously predicted as prephenate dehydratase based on sequence similarity. Warpeha et al. demonstrated that PD1, encoded by one of the six genes, has prephenate dehydratase activity|CITS: [16415218]| in vitro. However arogenate was not tested as an alternative substrate in that study. Thus it was not clear whether or not prephenate is the preferred substrate. Subsequently, Cho et al.|CITS: [17726025]| expressed all six genes in E. coli and analyzed enzyme activities of the recombinant proteins. It was shown that three of them (AT2G27820, AT3G44720, At5G22630) lack any detectable activity towards prephenate, and the other three had significantly higher activity with arogenate than prephenate. The catalytic efficiency (Kcat/Km) for arogenate was 98-, 28- and 32-fold higher than that of prephenate when tested with AT1G08250, AT1G11790 and At3G07630, respectively. Consequently all six genes were re-annotated as arogenate dehydratase.</Comment>
