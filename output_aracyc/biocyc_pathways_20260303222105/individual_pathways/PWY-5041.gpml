    <DataNode elementId="AT5G17920-MONOMER" textLabel="methionine synthase" type="Protein">
      <Xref identifier="O50008" dataSource="uniprot" />
      <Graphics centerX="300" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Arabidopsis contains three isoforms of methionine synthase, one located in the chloroplast and involved in de novo methionine synthesis (AtMS3), and the other two in the cytosol which are involved in the SAM cycle (AtMS1 and AtMS2). The vitamin B12-independent methionine synthases AtMS1 and AtMS2 have a clear substrate preference with polyglutamate forms of 5-methyltetrahydrofolate as the methyl donor. The monoglutamate form is not efficiently accepted.</Comment>
      <Property key="UniqueID" value="AT5G17920-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G17920.1" />
      <Property key="AlternativeId_Uniprot" value="O50008" />
      <Property key="AlternativeId_Pid" value="AAC50037" />
      <Property key="Synonym_1" value="5-methyltetrahydropteroyltriglutamate-homocysteine S-methyltransferase" />
      <Property key="Catalyzes" value="RXN-9982" />
      <Property key="Accession1" value="AT5G17920.1" />
