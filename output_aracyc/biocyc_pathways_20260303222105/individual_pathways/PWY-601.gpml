    <DataNode elementId="AT4G37400-MONOMER" textLabel="AT4G37400-MONOMER" type="Protein">
      <Xref identifier="Q0WTF4" dataSource="uniprot" />
      <Graphics centerX="750" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, zhang">In Arabidopsis, there are four members in the CYP81F subfamily. Heterologous expression and enzyme assay indicated that all four catalyzed the conversion of I3M to 1OH-I3M. However, Genetics data indicated that CYP81F4 is mainly responsible for the generation of 1MO-I3M, the downstream methylated product of 1OH-I3M, in vivo. 1MO-I3M was virtually absent in CYP81F4 knockout mutants |CITS: [21317374]|. CYP81F1, CYP81F2 and CYP81F3, but not CYP81F4, catalyzed the conversion of I3M to 4OH-I3M. But mutant glucosinolate profiling data only supported the in vivo role of CYP81F2 and CYP81F3. The biological role of CYP81F1 remains to be identified |CITS: [21317374]|.</Comment>
      <Property key="UniqueID" value="AT4G37400-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G37400.1" />
      <Property key="AlternativeId_Uniprot" value="Q0WTF4" />
      <Property key="Catalyzes" value="RXN-33469, RXN-33468, RXN-12775" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT4G37400.1" />
      <Property key="Gene" value="AT4G37400" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_21317374" />
    </DataNode>
    <DataNode elementId="AT4G30530-MONOMER" textLabel="AT4G30530-MONOMER" type="Protein">
      <Xref identifier="Q9M0A7" dataSource="uniprot" />
      <Graphics centerX="900" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, zhang">The Arabidopsis gamma-glutamyl peptidase GGP1 (At4G30530) was expressed in E. coli. The recombinant protein was purified. In vitro assay proved enzyme activity with the glutathione-conjugate substrate. In planta, GGP1 is highly co-expressed with the other glucosinolate biosynthetic genes CYP83B1 and SUR1.</Comment>
      <Property key="UniqueID" value="AT4G30530-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G30530.1" />
      <Property key="AlternativeId_Uniprot" value="Q9M0A7" />
      <Property key="Catalyzes" value="RXN-33435, RXN-33434, RXN-33431, RXN-17796" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT4G30530.1" />
      <Property key="Gene" value="AT4G30530" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_19483696" />
    </DataNode>
