    <DataNode elementId="AT1G74090-MONOMER" textLabel="Cytosolic sulfotransferase 18" type="Protein">
      <Xref identifier="AT1G74090-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="750" centerY="615" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Three sulfotransferases have been identified to specifically catalyze the sulfo transferring reaction involved in glucosinolate biosynthesis. Substrate specificity varies among the three genes in the same ecotype (C24) and between ecotypes (C24 versus Col). AtSOT16 (C24) has broad substrate specificities. Tryptophan and phenylalanine-derived desulfoglucosinolates (desulfoGS) are the best substrates. Also accepts methionine-derived desulfoGS of chain length C3, C4, C5, C6, C7 and C8, although at much lower activities. AtSOT17 (C24) has narrow substrate specificities. Does not act upon tryptophan-derived desulfoGS. Phenylalanine-derived benzyldesulfoglucosinolate is the best substrate. Also accepts methionine derived desulfoGS but has a strong preference for longer side chains, C6, C7 and C8. AtSOT18 (C24) also has narrow substrate specificities. Does not act upon tryptophan-derived desulfoGS. Accepts phenylalanine-derived desulfoGS. Also accepts methionine derived desulfoGS but has a strong preference of longer side chains, C6, C7 and C8. AtSOT18 (Col) has broad substrate specificities with trytophan, phenylalanine and methionine-derived desulfoGS. Here the enzyme data of AtSOT18 came from the Col ecotype.</Comment>
      <Property key="UniqueID" value="AT1G74090-MONOMER" />
      <Property key="Synonym_1" value="AtSOT18" />
      <Property key="Synonym_2" value="Desulfo-glucosinolate sulfotransferase B" />
      <Property key="Synonym_3" value="Sulfotransferase 5B" />
      <Property key="Synonym_4" value="AtST5b" />
      <Property key="Catalyzes" value="RXN-33208, RXN-12512, RXN-12511, RXN-12510, RXN-12509, RXN-12508, RXN-12507, RXN-12506, RXN-6272" />
      <Property key="CatalyzesCount" value="9" />
      <Property key="GOTerms" value="GO:0005737" />
      <Property key="Accession1" value="AT1G74090.1" />
      <Property key="Gene" value="AT1G74090" />
      <Property key="^citations" value="16367753" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_15358770" />
      <CitationRef elementRef="citation_PUB_16367753" />
      <CitationRef elementRef="citation_PUB_19077143" />
    </DataNode>
    <DataNode elementId="AT1G74100-MONOMER" textLabel="Cytosolic sulfotransferase 16" type="Protein">
      <Xref identifier="AT1G74100-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="900" centerY="615" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Three sulfotransferases have been identified to specifically catalyze the sulfo transferring reaction involved in glucosinolate biosynthesis. Substrate specificity varies among the three genes in the same ecotype (C24) and between ecotypes (C24 versus Col). AtSOT16 (C24) has broad substrate specificities. Tryptophan and phenylalanine-derived desulfoglucosinolates (desulfoGS) are the best substrates. Also accepts methionine-derived desulfoGS of chain length C3, C4, C5, C6, C7 and C8, although at much lower activities. AtSOT17 (C24) has narrow substrate specificities. Does not act upon tryptophan-derived desulfoGS. Phenylalanine-derived benzyldesulfoglucosinolate is the best substrate. Also accepts methionine derived desulfoGS but has a strong preference for longer side chains, C6, C7 and C8. AtSOT18 (C24) also has narrow substrate specificities. Does not act upon tryptophan-derived desulfoGS. Accepts phenylalanine-derived desulfoGS. Also accepts methionine derived desulfoGS but has a strong preference of longer side chains, C6, C7 and C8. AtSOT18 (Col) has broad substrate specificities with trytophan, phenylalanine and methionine-derived desulfoGS. Here, the enzyme data of AtSOT16 came from the C24 ecotype.</Comment>
      <Property key="UniqueID" value="AT1G74100-MONOMER" />
