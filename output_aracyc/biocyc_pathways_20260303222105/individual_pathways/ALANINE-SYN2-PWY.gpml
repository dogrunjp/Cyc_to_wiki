      <Property key="Locations" value="CCI-CYTOSOL-PL" />
      <CitationRef elementRef="citation_PUB_17319845" />
    </DataNode>
    <DataNode elementId="AT1G70580-MONOMER" textLabel="Glutamate--glyoxylate aminotransferase 2" type="Protein">
      <Xref identifier="Q9S7E9" dataSource="uniprot" />
      <Graphics centerX="300" centerY="275" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">In vitro assay of the recombinant proteins indicated that GGAT1 and GGAT2 have four aminotransferase activities, namely GGAT, AGAT, GPAT and AOAT. The two recombinant proteins exhibited very similar Km values towards amino acid substrates glutamate and alanine, as well as the oxoacid substrates glyoxylate, pyruvate and 2-oxoglutarate|CITS: [12529529]|. AOAT2 (GGAT2), which is predicted to be located in the peroxisome, is likely involved in photorespiration.</Comment>
