    <DataNode elementId="AT2G36530-MONOMER" textLabel="Bifunctional enolase 2/transcriptional activator" type="Protein">
      <Xref identifier="P25696" dataSource="uniprot" />
      <Graphics centerX="300" centerY="755" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">An &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; mutant (&lt;i&gt;los2&lt;/i&gt;) was characterized, which exhibits a wilting phenotype under cold and light growth conditions (no phenotype was observed under dark cold or normal growth conditions) |CITS:[12032082]|. The point mutation was identified in the &lt;i&gt;LOS&lt;/i&gt; gene which was predicted to encode a protein with enolase (phosphopyruvate hydratase) activity. The gene was heterologously expressed in &lt;i&gt;E. coli&lt;/i&gt; where its function was confirmed |CITS:[12032082]|. Expression of the &lt;i&gt;los2&lt;/i&gt; mutant gene produced a protein with a significantly reduced activity at 22°C. Tissue extracts of the mutant &lt;i&gt;Arabidopsis&lt;/i&gt; plants also had a significantly lower enolase activity at 22°C |CITS:[12032082]|.</Comment>
      <Property key="UniqueID" value="AT2G36530-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G36530.1" />
      <Property key="AlternativeId_Panther" value="PTHR11902" />
      <Property key="AlternativeId_Smr" value="P25696" />
      <Property key="AlternativeId_Prints" value="PR00148" />
      <Property key="AlternativeId_Pride" value="P25696" />
      <Property key="AlternativeId_Interpro" value="IPR029065" />
      <Property key="AlternativeId_Pfam" value="PF03952" />
      <Property key="AlternativeId_Phylomedb" value="P25696" />
      <Property key="AlternativeId_Prosite" value="PS00164" />
      <Property key="AlternativeId_Smart" value="SM01192" />
      <Property key="AlternativeId_Uniprot" value="P25696" />
      <Property key="AlternativeId_Pid" value="NP_181192" />
      <Property key="Synonym_1" value="2-phospho-D-glycerate hydro-lyase 2" />
      <Property key="Synonym_2" value="2-phosphoglycerate dehydratase 2" />
      <Property key="Synonym_3" value="LOW EXPRESSION OF OSMOTICALLY RESPONSIVE GENES 1" />
      <Property key="Catalyzes" value="RXN-13696" />
