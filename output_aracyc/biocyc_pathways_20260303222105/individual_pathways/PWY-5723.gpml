    <DataNode elementId="AT1G67090-MONOMER" textLabel="Ribulose bisphosphate carboxylase small chain 1A, chloroplastic" type="Protein" groupRef="RUBISCO2">
      <Xref identifier="AT1G67090-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="755" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The RUBISCO small subunit is nuclear encoded by a small gene family. Four genes (rbcS1A, rbcS1B, rbcS2B, rbcS3B) have been described in this gene family and each is differentially regulated by light.</Comment>
      <Property key="UniqueID" value="AT1G67090-MONOMER" />
      <Property key="Synonym_1" value="RuBisCO small subunit 1A" />
      <Property key="Catalyzes" value="RXN-33648" />
