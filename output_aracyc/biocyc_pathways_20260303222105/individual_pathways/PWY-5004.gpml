    <DataNode elementId="MONOMERQT-4120" textLabel="MONOMERQT-4120" type="Protein">
      <Xref identifier="MONOMERQT-4120" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="575" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, hartmut">The enzymatic activity reversibly converting argininosuccinate to arginine and fumarate, i.e. argininosuccinate lyase (EC 4.3.2.1) has been identified and partially purified from leaves of &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. It has been established that the enzyme is dependent on fumarate and that the forward reaction is favored forming arginine and fumarate |CITS:[17651442]|.</Comment>
      <Property key="UniqueID" value="MONOMERQT-4120" />
      <Property key="Catalyzes" value="RXN-10480" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17651442" />
    </DataNode>
