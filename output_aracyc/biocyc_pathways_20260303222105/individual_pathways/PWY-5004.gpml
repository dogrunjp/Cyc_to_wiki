    <DataNode elementId="AT3G47450-MONOMER" textLabel="NO-associated protein 1, chloroplastic/mitochondrial" type="Protein">
      <Xref identifier="Q66GP9" dataSource="uniprot" />
      <Graphics centerX="150" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">This protein was originally believed to function as a nitric oxide synthase (AtNOS1) |CITS: [14526079]|. However, later work has shown that this enzyme functions as a GTPase |CITS: [18801746]|. Further investigation will be required to understand NO biosynthesis in Arabidopsis. NO deficient plants show inhibited plant growth, less fertility, abnormal stomatal movement and changed hormone signaling indicating the vital role of this enzyme |CITS:[14526079]|. However, other groups could not find NOS activity in Arabidopsis suggesting that further research is needed |CITS:[17030145]|.</Comment>
      <Property key="UniqueID" value="AT3G47450-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G47450.1" />
      <Property key="AlternativeId_Uniprot" value="Q66GP9" />
      <Property key="Synonym_1" value="AtNOA1" />
      <Property key="Synonym_2" value="Dubious mitochondrial nitric oxide synthase 1" />
      <Property key="Synonym_3" value="AtNOS1" />
      <Property key="Synonym_4" value="GTPase NOA1" />
      <Property key="Synonym_5" value="RESISTANT TO INHIBITION BY FOSMIDOMYCIN 1" />
      <Property key="Catalyzes" value="RXN-33823, RXN-11429" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT3G47450.1" />
      <Property key="Gene" value="AT3G47450" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_14526079" />
      <CitationRef elementRef="citation_PUB_17030145" />
      <CitationRef elementRef="citation_PUB_18801746" />
    </DataNode>
    <DataNode elementId="AT4G08900-MONOMER" textLabel="AT4G08900-MONOMER" type="Protein">
      <Xref identifier="P46637" dataSource="uniprot" />
      <Graphics centerX="300" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">A |FRAME: TAX-3702 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;| cDNA clone was recovered by complementation of an arginase deficient yeast mutant. The isolates of the complemented mutant produced urea in the presence of |FRAME: ARG L-arginine|, indicating that the ariginase was present. This enzyme catalyzes the conversion of arginine to ornithine and it occurs as a single copy in the |FRAME: TAX-3702 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;| genome |CITS: [7770544]|.</Comment>
      <Property key="UniqueID" value="AT4G08900-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G08900.1" />
      <Property key="AlternativeId_Panther" value="PTHR11358" />
