    <DataNode elementId="AT5G23300-MONOMER" textLabel="dihydroorotate dehydrogenase" type="Protein">
      <Xref identifier="P32746" dataSource="uniprot" />
      <Graphics centerX="150" centerY="475" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA encoding dihydroorotic dehydrogenase has been identified in and partly characterized from &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. The molecular function of oxidizing dihydroorotate to form orotate has been demonstrated by functional complementation of an auxotrophic yeast mutant deficient in this activity |CITS: [1303803]|. In addition, the purified recombinant protein expressed in &lt;i&gt;E. coli&lt;/i&gt; was shown to carry out the oxidation however the endogenous electron acceptor has not yet been established. The characterization of dihydroorotic dehydrogenase in Arabidopsis revealed significant differences to their animal counterpart protein as specific inhibitors working in animals have no effects in the plant enzyme |CITS: [12372626]|.</Comment>
      <Property key="UniqueID" value="AT5G23300-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G23300.1" />
      <Property key="AlternativeId_Smr" value="P32746" />
      <Property key="AlternativeId_Pride" value="P32746" />
      <Property key="AlternativeId_Interpro" value="IPR005720" />
      <Property key="AlternativeId_Pfam" value="PF01180" />
      <Property key="AlternativeId_Phylomedb" value="P32746" />
      <Property key="AlternativeId_Prosite" value="PS00912" />
      <Property key="AlternativeId_Uniprot" value="P32746" />
      <Property key="Catalyzes" value="RXN-33951, RXN-7247" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G23300.1" />
      <Property key="FunctionalAssignmentStatus" value=":AMBIGUOUS" />
      <Property key="Gene" value="AT5G23300" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_12372626" />
      <CitationRef elementRef="citation_PUB_1303803" />
    </DataNode>
    <DataNode elementId="AT3G20330-MONOMER" textLabel="AT3G20330-MONOMER" type="Protein">
      <Xref identifier="P49077" dataSource="uniprot" />
      <Graphics centerX="300" centerY="475" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA encoding aspartate carbamoyltransferase in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; has been isolated and partly functionally characterized. Its molecular function of N-carbamoyl-L-aspartate from aspartate and carbamoyl-phosphate has been demonstrated by functionally complementing a auxotrophic yeast mutant deficient in the aspartate carbamoyltransferase activity |CITS: [8041358]|.</Comment>
      <Property key="UniqueID" value="AT3G20330-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G20330.1" />
      <Property key="AlternativeId_Phylomedb" value="P49077" />
      <Property key="AlternativeId_Prosite" value="PS00097" />
      <Property key="AlternativeId_Prints" value="PR00100" />
      <Property key="AlternativeId_Pride" value="P49077" />
      <Property key="AlternativeId_Smr" value="P49077" />
      <Property key="AlternativeId_Pfam" value="PF00185" />
      <Property key="AlternativeId_Interpro" value="IPR006132" />
