      <CitationRef elementRef="citation_PUB_15561724" />
      <CitationRef elementRef="citation_PUB_12506203" />
      <CitationRef elementRef="citation_PUB_15927941" />
    </DataNode>
    <DataNode elementId="AT2G16370.3" textLabel="AT2G16370.3" type="Protein">
