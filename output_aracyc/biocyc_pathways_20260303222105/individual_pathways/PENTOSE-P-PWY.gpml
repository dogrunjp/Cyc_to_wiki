    <DataNode elementId="AT5G13110-MONOMER" textLabel="Glucose-6-phosphate 1-dehydrogenase 2, chloroplastic" type="Protein">
      <Xref identifier="AT5G13110-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The enzyme encoded by this gene was recombinant expressed in &lt;i&gt;E. coli&lt;/i&gt; and purified by affinity chromatography. The enzyme lost activity rapidly upon storage at 4°C, -20°C with or without 20% glycerol, or -80°C following snap-freezing. It utilized NADP&lt;sup&gt;+&lt;/sup&gt; but not NAD&lt;sup&gt;+&lt;/sup&gt; in a concentration-dependent manner and showed a concentration- dependent competitive inhibition by NADPH indicative of feedback inhibition by NADPH |CITS:[15634201]|.</Comment>
      <Property key="UniqueID" value="AT5G13110-MONOMER" />
      <Property key="Synonym_1" value="G6PD2" />
      <Property key="Synonym_2" value="G6PDH2" />
