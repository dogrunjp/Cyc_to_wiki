    <DataNode elementId="AT3G02780-MONOMER" textLabel="Isopentenyl-pyrophosphate Delta-isomerase II, chloroplastic" type="Protein">
      <Xref identifier="Q42553" dataSource="uniprot" />
      <Graphics centerX="450" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana IPP2&lt;/i&gt; gene was heterologously expressed in &lt;i&gt;E. coli&lt;/i&gt;. Clarified crude extracts containing IPP2 were shown to possess isopentenyl diphosphate (IPP) isomerase activity, well above background levels |CITS:[9484444]|. This enzyme allows for the interconversion of IPP with dimethylallyldiphosphate (DMAPP). There is genetic evidence that this protein functions in the |FRAME: PWY-922| but not the MEP biosynthetic pathway |CITS: [18303110]|.</Comment>
      <Property key="UniqueID" value="AT3G02780-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G02780.1" />
      <Property key="AlternativeId_Uniprot" value="Q42553" />
      <Property key="AlternativeId_Pid" value="NP_186927" />
      <Property key="Synonym_1" value="Isopentenyl pyrophosphate isomerase II" />
      <Property key="Synonym_2" value="IPP isomerase II" />
      <Property key="Catalyzes" value="RXN-5604, RXN-12481" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT3G02780.1" />
      <Property key="Gene" value="AT3G02780" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_9484444" />
      <CitationRef elementRef="citation_PUB_18303110" />
    </DataNode>
    <DataNode elementId="AT2G26930-MONOMER" textLabel="4-(cytidine 5&apos;-diphospho)-2-C-methyl-D-erythritol kinase" type="Protein">
      <Xref identifier="O81014" dataSource="uniprot" />
      <Graphics centerX="600" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, dreher">AT2G26930 is predicted to encode a protein that functions as a 4-(cytidine 5&apos;-diphospho)-2-C-methyl-D-erythritol kinase (CMK) in the |FRAME: NONMEVIPP-PWY| (MEP). Mutations that disrupt the CMK/IspE gene cause an albino lethal phenotype in ispE-1 mutants. Photosynthetic pigments are almost undetectable in these mutants and they completely lack thylakoid membranes. |CITS: [18236010]|. The putative transit peptide of this protein is able to target GFP to the choloroplast, consistent with the localization of other enzymes involved in the |FRAME: NONMEVIPP-PWY MEP pathway| |CITS: [18236010]|.</Comment>
      <Property key="UniqueID" value="AT2G26930-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G26930.1" />
      <Property key="AlternativeId_Uniprot" value="O81014" />
      <Property key="Catalyzes" value="RXN-12927" />
      <Property key="GOTerms" value="GO:0009507" />
      <Property key="Accession1" value="AT2G26930.1" />
      <Property key="Gene" value="AT2G26930" />
      <Property key="^citations" value="18236010" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CHLOROPLAST-PL" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_18948055" />
      <CitationRef elementRef="citation_PUB_18236010" />
    </DataNode>
    <DataNode elementId="AT5G16440-MONOMER" textLabel="Isopentenyl-pyrophosphate Delta-isomerase I, chloroplastic" type="Protein">
      <Xref identifier="Q38929" dataSource="uniprot" />
      <Graphics centerX="150" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana IPP1&lt;/i&gt; gene was heterologously expressed in &lt;i&gt;E. coli&lt;/i&gt;. Clarified crude extracts containing IPP1 were shown to possess isopentenyl diphosphate (IPP) isomerase activity, well above background levels |CITS:[9484444]|. This enzyme allows for the interconversion of IPP with dimethylallyldiphosphate (DMAPP). There is genetic evidence that this protein functions in the |FRAME: PWY-922| but not the MEP biosynthetic pathway |CITS: [18303110]|.</Comment>
      <Property key="UniqueID" value="AT5G16440-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G16440.1" />
      <Property key="AlternativeId_Uniprot" value="Q38929" />
      <Property key="AlternativeId_Pid" value="NP_197148" />
      <Property key="Synonym_1" value="Isopentenyl pyrophosphate isomerase I" />
      <Property key="Synonym_2" value="IPP isomerase I" />
      <Property key="Catalyzes" value="RXN-6675, RXN-12480" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G16440.1" />
      <Property key="Gene" value="AT5G16440" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_9484444" />
      <CitationRef elementRef="citation_PUB_18303110" />
    </DataNode>
    <DataNode elementId="AT5G62790-MONOMER" textLabel="1-deoxy-D-xylulose-5-phosphate reductoisomerase" type="Protein">
      <Xref identifier="Q9XFS9" dataSource="uniprot" />
      <Graphics centerX="300" centerY="415" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana DXR&lt;/i&gt; gene was heterologously expressed in an &lt;i&gt;E. coli&lt;/i&gt; lethal mutant defective in the &lt;i&gt;dxr&lt;/i&gt; gene and shown to rescue the mutant phenotype |CITS:[12177470]|. Rescue was achieved with two truncated version of the &lt;i&gt;Arabidopsis DXR&lt;/i&gt; gene: a long version missing some of the N-terminal region (residues 55-477) and a shorter version missing the entire N-terminal region (residue 81-477) |CITS:[12177470]|. Importantly however, the longer version led to a more vigorous growth of the rescued cells, demonstrating that the N-terminal proline-rich region (residues 57-80) contains elements that are important for activity or stability of the protein when expressed in &lt;i&gt;E. coli&lt;/i&gt;.</Comment>
      <Property key="UniqueID" value="AT5G62790-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G62790.2" />
      <Property key="AlternativeId_Uniprot" value="Q9XFS9" />
