      <Property key="Gene" value="AT1G63970" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_16231155" />
    </DataNode>
    <DataNode elementId="AT4G34350-MONOMER-9581" textLabel="AT4G34350-MONOMER-9581" type="Protein">
      <Xref identifier="Q94B35" dataSource="uniprot" />
      <Graphics centerX="150" centerY="495" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana IspH&lt;/i&gt; gene was heterologously expressed in an &lt;i&gt;E. coli&lt;/i&gt; lethal mutant defective in the &lt;i&gt;ispH&lt;/i&gt; gene and shown to rescue the mutant phenotype |CITS:[15863698]|. Seedlings defective in the &lt;i&gt;Arabidopsis&lt;/i&gt; gene display an albino phenotype |CITS:[15863698]|.</Comment>
      <Property key="UniqueID" value="AT4G34350-MONOMER-9581" />
