      <Property key="Synonym_1" value="(2&lt;i&gt;S&lt;/i&gt;)-4&apos;,5,7-trihydroxyflavanone" />
      <Property key="Synonym_2" value="(2&lt;i&gt;S&lt;/i&gt;)-5,7,4&apos;-trihydroxyflavone" />
      <Property key="Synonym_3" value="(2&lt;i&gt;S&lt;/i&gt;)-4&apos;,5,7-trihydroxyflavan-4-one" />
