    <DataNode elementId="AT3G02780-MONOMER" textLabel="Isopentenyl-pyrophosphate Delta-isomerase II, chloroplastic" type="Protein">
      <Xref identifier="Q42553" dataSource="uniprot" />
      <Graphics centerX="300" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana IPP2&lt;/i&gt; gene was heterologously expressed in &lt;i&gt;E. coli&lt;/i&gt;. Clarified crude extracts containing IPP2 were shown to possess isopentenyl diphosphate (IPP) isomerase activity, well above background levels |CITS:[9484444]|. This enzyme allows for the interconversion of IPP with dimethylallyldiphosphate (DMAPP). There is genetic evidence that this protein functions in the |FRAME: PWY-922| but not the MEP biosynthetic pathway |CITS: [18303110]|.</Comment>
      <Property key="UniqueID" value="AT3G02780-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G02780.1" />
      <Property key="AlternativeId_Uniprot" value="Q42553" />
      <Property key="AlternativeId_Pid" value="NP_186927" />
      <Property key="Synonym_1" value="Isopentenyl pyrophosphate isomerase II" />
      <Property key="Synonym_2" value="IPP isomerase II" />
      <Property key="Catalyzes" value="RXN-5604, RXN-12481" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT3G02780.1" />
      <Property key="Gene" value="AT3G02780" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_9484444" />
      <CitationRef elementRef="citation_PUB_18303110" />
    </DataNode>
