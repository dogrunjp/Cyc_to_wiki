    <DataNode elementId="AT1G63970-MONOMER" textLabel="2-C-methyl-D-erythritol 2,4-cyclopyrophosphate synthase" type="Protein">
      <Xref identifier="Q9CAK8" dataSource="uniprot" />
      <Graphics centerX="750" centerY="615" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana IspF&lt;/i&gt; gene was heterologously expressed in an &lt;i&gt;E. coli&lt;/i&gt; lethal mutant defective in the &lt;i&gt;ispF&lt;/i&gt; gene and shown to rescue the mutant phenotype |CITS:[16231155]|. Seedlings defective in the &lt;i&gt;Arabidopsis&lt;/i&gt; gene display an albino phenotype containing less than 1% and about 2% of the wildtype chlorophylls and carotenoids content, respectively.</Comment>
      <Property key="UniqueID" value="AT1G63970-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G63970.1" />
      <Property key="AlternativeId_Uniprot" value="Q9CAK8" />
