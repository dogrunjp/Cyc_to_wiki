    <DataNode elementId="AT2G02500-MONOMER" textLabel="2-C-methyl-D-erythritol 4-phosphate cytidylyltransferase, chloroplastic" type="Protein">
      <Xref identifier="P69834" dataSource="uniprot" />
      <Graphics centerX="750" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana MCT&lt;/i&gt; gene was heterologously expressed in &lt;i&gt;E. coli&lt;/i&gt;. The recombinant protein was purified to homogeneity and shown to catalyze the transfer of a cytidyl phosphate group to 2C-methyl-D-erythritol 4-phosphate, a function also known as 4-diphosphocytidyl-2C-methyl-D-erythritol synthase activity |CITS:[10841550]|. The enzyme was shown to be able to use several nucleotide triphosphates as substrates although CTP was by far the best substrate. Additionally, the recombinant enzyme demonstrated an absolute requirement for divalent cations (Mg&lt;sup&gt;2+&lt;/sup&gt; resulted in the highest activity) |CITS:[10841550]|.</Comment>
      <Property key="UniqueID" value="AT2G02500-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G02500.1" />
      <Property key="AlternativeId_Uniprot" value="P69834" />
      <Property key="AlternativeId_Pid" value="NP_417227" />
      <Property key="Synonym_1" value="4-diphosphocytidyl-2C-methyl-D-erythritol synthase" />
      <Property key="Synonym_2" value="MEP cytidylyltransferase" />
      <Property key="Synonym_3" value="AtMECT" />
      <Property key="Synonym_4" value="AtMEPCT" />
      <Property key="Catalyzes" value="RXN-12476" />
      <Property key="Accession1" value="AT2G02500.1" />
      <Property key="Gene" value="AT2G02500" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="41." />
      <Property key="MolecularWeightKd" value="41." />
      <CitationRef elementRef="citation_PUB_10841550" />
    </DataNode>
    <DataNode elementId="AT2G26930-MONOMER" textLabel="4-(cytidine 5&apos;-diphospho)-2-C-methyl-D-erythritol kinase" type="Protein">
      <Xref identifier="O81014" dataSource="uniprot" />
      <Graphics centerX="900" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, dreher">AT2G26930 is predicted to encode a protein that functions as a 4-(cytidine 5&apos;-diphospho)-2-C-methyl-D-erythritol kinase (CMK) in the |FRAME: NONMEVIPP-PWY| (MEP). Mutations that disrupt the CMK/IspE gene cause an albino lethal phenotype in ispE-1 mutants. Photosynthetic pigments are almost undetectable in these mutants and they completely lack thylakoid membranes. |CITS: [18236010]|. The putative transit peptide of this protein is able to target GFP to the choloroplast, consistent with the localization of other enzymes involved in the |FRAME: NONMEVIPP-PWY MEP pathway| |CITS: [18236010]|.</Comment>
      <Property key="UniqueID" value="AT2G26930-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G26930.1" />
      <Property key="AlternativeId_Uniprot" value="O81014" />
      <Property key="Catalyzes" value="RXN-12927" />
      <Property key="GOTerms" value="GO:0009507" />
      <Property key="Accession1" value="AT2G26930.1" />
      <Property key="Gene" value="AT2G26930" />
      <Property key="^citations" value="18236010" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CHLOROPLAST-PL" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_18948055" />
      <CitationRef elementRef="citation_PUB_18236010" />
    </DataNode>
    <DataNode elementId="AT5G16440-MONOMER" textLabel="Isopentenyl-pyrophosphate Delta-isomerase I, chloroplastic" type="Protein">
      <Xref identifier="Q38929" dataSource="uniprot" />
      <Graphics centerX="150" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana IPP1&lt;/i&gt; gene was heterologously expressed in &lt;i&gt;E. coli&lt;/i&gt;. Clarified crude extracts containing IPP1 were shown to possess isopentenyl diphosphate (IPP) isomerase activity, well above background levels |CITS:[9484444]|. This enzyme allows for the interconversion of IPP with dimethylallyldiphosphate (DMAPP). There is genetic evidence that this protein functions in the |FRAME: PWY-922| but not the MEP biosynthetic pathway |CITS: [18303110]|.</Comment>
      <Property key="UniqueID" value="AT5G16440-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G16440.1" />
      <Property key="AlternativeId_Uniprot" value="Q38929" />
      <Property key="AlternativeId_Pid" value="NP_197148" />
      <Property key="Synonym_1" value="Isopentenyl pyrophosphate isomerase I" />
      <Property key="Synonym_2" value="IPP isomerase I" />
      <Property key="Catalyzes" value="RXN-6675, RXN-12480" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G16440.1" />
      <Property key="Gene" value="AT5G16440" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_9484444" />
      <CitationRef elementRef="citation_PUB_18303110" />
    </DataNode>
    <DataNode elementId="AT4G36810-MONOMER" textLabel="Heterodimeric geranylgeranyl pyrophosphate synthase large subunit 1, chloroplastic" type="Protein">
      <Xref identifier="P34802" dataSource="uniprot" />
      <Graphics centerX="300" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;GGPS1&lt;/i&gt; when expressed in recombinant &lt;i&gt;E.coli&lt;/i&gt; was shown to encode for a protein catalyzing the condensation of farnesyl pyrophosphate (FPP) and isopentenyl pyrophosphate (IPP) to produce geranylgeranyl diphosphate (GGPP) |CITS:[10759500]|. &lt;i&gt;In planta&lt;/i&gt;, the protein was shown to be localized in the chloroplasts of epidermal cells and leaf guard cells, and in the etioplasts of roots |CITS:[10759500]|.</Comment>
      <Property key="UniqueID" value="AT4G36810-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G36810.1" />
      <Property key="AlternativeId_Pid" value="NP_195399" />
      <Property key="AlternativeId_Uniprot" value="P34802" />
      <Property key="Synonym_1" value="GGPP synthase 1" />
      <Property key="Synonym_2" value="GGPS1" />
      <Property key="Synonym_3" value="(2E,6E)-farnesyl diphosphate synthase 1" />
      <Property key="Synonym_4" value="Dimethylallyltranstransferase 1" />
      <Property key="Synonym_5" value="Farnesyl diphosphate synthase 1" />
      <Property key="Synonym_6" value="Farnesyltranstransferase 1" />
      <Property key="Synonym_7" value="Geranyltranstransferase 1" />
      <Property key="Catalyzes" value="RXN-33464, RXN-33463, RXN-12011" />
      <Property key="CatalyzesCount" value="3" />
