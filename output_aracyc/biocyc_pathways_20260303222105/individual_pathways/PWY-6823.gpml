      <Property key="ReactionEquation" value="PRECURSOR-Z + Thiocarboxylated-MPT-synthases + WATER =&gt; CPD-4 + MPT-Synthase-small-subunits + PROTON" />
      <Property key="ReactionDirection" value="PHYSIOL-LEFT-TO-RIGHT" />
      <Property key="BalanceStatus" value=":BALANCED" />
