    <DataNode elementId="AT2G43760-MONOMER" textLabel="MPT synthase large subunit" type="Protein" groupRef="CPLX-7191">
      <Xref identifier="O22827" dataSource="uniprot" />
      <Graphics centerX="300.0" centerY="275" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, hartmut">The functional molybdopterin synthase (MTP synthase) is a heterotetramer that consists of 2 large subunits (Cnx6) and 2 small subunits (Cnx7) |CITS: [9421926]| |CITS: [12147719]|. The large subunit Cnx6 was identified based on sequence homology to its bacterial complement MoaE and the small subunit (Cnx7) using a yeast two-hybrid screen |CITS: [11459846]|. The structure and function of the enzyme including the mechanism of the catalyzed reaction has been investigated in detail in bacteria |CITS: [11135669]| |CITS: [12571227]| |CITS: [12571226]|.</Comment>
      <Property key="UniqueID" value="AT2G43760-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G43760.1" />
      <Property key="AlternativeId_Uniprot" value="O22827" />
      <Property key="AlternativeId_Pid" value="CAB38428" />
      <Property key="Accession1" value="AT2G43760.1" />
      <Property key="ComponentOf" value="CPLX-7191" />
