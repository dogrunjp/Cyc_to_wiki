    <Interaction elementId="RXN-11361">
      <Xref identifier="EC-2.7.7.80" dataSource="Enzyme Nomenclature" />
      <Waypoints>
        <Point elementId="RXN-11361_start" x="545.0" y="840" elementRef="ATP" relX="1.0" relY="0.0" />
