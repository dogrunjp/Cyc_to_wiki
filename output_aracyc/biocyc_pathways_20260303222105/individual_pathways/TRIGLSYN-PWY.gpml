    <DataNode elementId="AT1G48300.1" textLabel="AT1G48300.1" type="Protein">
      <Xref identifier="AT1G48300.1" dataSource="plantcyc" />
      <Graphics centerX="750" centerY="575" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
