    <DataNode elementId="MONOMER-AT1G15080" textLabel="Lipid phosphate phosphatase 2" type="Protein">
      <Xref identifier="Q9XI60" dataSource="uniprot" />
      <Graphics centerX="150" centerY="655" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Two isoforms of lipid phosphate phosphatase exist in Arabidopsis. The two isoforms take both |FRAME: DIACYLGLYCEROL-PYROPHOSPHATE a 1,2-diacyl-&lt;i&gt;sn&lt;/i&gt;-glycerol 3-diphosphate| (DGPP) and |FRAME: L-PHOSPHATIDATE a 1,2-diacyl-&lt;i&gt;sn&lt;/i&gt;-glycerol-3-phosphate| as substrates. Isoform |FRAME: AT2G01180 LPP1| has a preference of DGPP for substrate, whereas isoform |FRAME: AT1G15080 LPP2| does not have preference over the two substrates |CITS: [11278556]|.</Comment>
      <Property key="UniqueID" value="MONOMER-AT1G15080" />
      <Property key="AlternativeId_Araport" value="AT1G15080.1" />
      <Property key="AlternativeId_Smart" value="SM00014" />
      <Property key="AlternativeId_Smr" value="Q9XI60" />
      <Property key="AlternativeId_Pride" value="Q9XI60" />
      <Property key="AlternativeId_Interpro" value="IPR028681" />
      <Property key="AlternativeId_Pfam" value="PF01569" />
      <Property key="AlternativeId_Phylomedb" value="Q9XI60" />
      <Property key="AlternativeId_Panther" value="PTHR10165:SF80" />
      <Property key="AlternativeId_Uniprot" value="Q9XI60" />
      <Property key="Synonym_1" value="AtLPP2" />
      <Property key="Synonym_2" value="Phosphatidic acid phosphatase 2" />
      <Property key="Synonym_3" value="AtPAP2" />
      <Property key="Synonym_4" value="Prenyl diphosphate phosphatase" />
      <Property key="Catalyzes" value="RXN-1804, RXN-17522" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT1G15080.1" />
      <Property key="Gene" value="AT1G15080" />
