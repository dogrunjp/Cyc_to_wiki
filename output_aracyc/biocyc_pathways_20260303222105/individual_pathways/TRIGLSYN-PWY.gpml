    <DataNode elementId="MONOMER-AT5G66450" textLabel="plastidic phosphatidic acid phosphatase" type="Protein">
      <Xref identifier="MONOMER-AT5G66450" dataSource="plantcyc" />
      <Graphics centerX="1200" centerY="975" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup, PMN, dreher">|FRAME: AT5G66450| (this protein), |FRAME:AT3G50920|, and |FRAME: AT5G03080| are part of a family of lipid phosphatidate phosphatases with prokaryotic origins |CITS: [17652095]|. All three enzymes can be localized to the plastid based on immunolocalization studies. Of these three, |FRAME: AT5G03080| has the highest level of transcripts in Arabidopsis shoots. In addition, although heterozygous &lt;i&gt;|FRAME: AT5G03080 lpp&amp;gamma;|&lt;/i&gt; mutants produce pollen that have defects in pollen tube germination and no homozygous mutants have been recovered, the &lt;i&gt; |FRAME:AT5G66450 lpp&amp;epsilon;1|/ |FRAME:AT3G50920 lpp&amp;epsilon;2| &lt;/i&gt; double mutants appear to have wild type growth and a wild type lipid profile. These data suggest that |FRAME: AT5G03080| is the most important plastidic member of the family |CITS: [17652095]|.</Comment>
      <Property key="UniqueID" value="MONOMER-AT5G66450" />
      <Property key="Synonym_1" value="AT5G66450.3" />
      <Property key="Catalyzes" value="RXN-19374, RXN-19373" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="GOTerms" value="GO:0009507" />
      <Property key="Accession1" value="AT5G66450.3" />
      <Property key="Gene" value="AT5G66450" />
      <Property key="^citations" value="17652095:EV-EXP-IDA:3542993266:dreher" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CHLOROPLAST-PL" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17652095" />
    </DataNode>
