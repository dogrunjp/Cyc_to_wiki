    </DataNode>
    <DataNode elementId="MONOMER-AT5G42870" textLabel="Phosphatidate phosphatase PAH2" type="Protein">
      <Xref identifier="MONOMER-AT5G42870" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="655" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, dreher">PAH2 encodes a phosphatidate phosphohydrolase that participates in the eukaryotic phosopholipid biosynthesis |CITS: [19923426]|. However it is unclear whether all of the phosphatidate (PA) that it acts on is derived from the breakdown of membrane phospholipids, such as phosphatidyl choline, or whether some of it can be provided by the &lt;i&gt;de novo&lt;/i&gt; PA biosynthetic pathways. Meanwhile, several experiments suggest that the diacyglycerol produced by this enzyme may feed into the lipid modification pathways present in both the inner and outer envelope membranes of the chloroplast |CITS: [19923426]|. PAH2 is a member of the lipin family of proteins. Physiological tests performed using |FRAME: AT3G09560 pah1|/pah2 double mutants indicate that these loci play an important role in helping Arabidopsis plants endure phosphate deficient conditions |CITS: [19923426]|.</Comment>
      <Property key="UniqueID" value="MONOMER-AT5G42870" />
      <Property key="Synonym_1" value="Phosphatidic acid phosphohydrolase 2" />
      <Property key="Synonym_2" value="AtPAH2" />
      <Property key="Catalyzes" value="RXN-19367" />
      <Property key="Accession1" value="AT5G42870.1" />
      <Property key="Gene" value="AT5G42870" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_19923426" />
    </DataNode>
    <DataNode elementId="MONOMER-AT3G50920" textLabel="plastidic phosphatidic acid phosphatase" type="Protein">
      <Xref identifier="MONOMER-AT3G50920" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="655" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, dreher">|FRAME:AT3G50920 | (this protein), |FRAME:AT5G66450|, and |FRAME: AT5G03080| are part of a family of lipid phosphatidate phosphatases with prokaryotic origins |CITS: [17652095]|. All three enzymes can be localized to the plastid based on immunolocalization studies. Of these three, |FRAME: AT5G03080| has the highest level of transcripts in Arabidopsis shoots. In addition, although heterozygous &lt;i&gt;|FRAME: AT5G03080 lpp&amp;gamma;|&lt;/i&gt; mutants produce pollen that have defects in pollen tube germination and no homozygous mutants have been recovered, the &lt;i&gt; |FRAME:AT5G66450 lpp&amp;epsilon;1|/ |FRAME:AT3G50920 lpp&amp;epsilon;2| &lt;/i&gt; double mutants appear to have wild type growth and a wild type lipid profile. These data suggest that |FRAME: AT5G03080| is the most important plastidic member of the family |CITS: [17652095]|.</Comment>
      <Property key="UniqueID" value="MONOMER-AT3G50920" />
      <Property key="Catalyzes" value="RXN-19371, RXN-19370" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="GOTerms" value="GO:0009507" />
      <Property key="Accession1" value="AT3G50920.1" />
      <Property key="Gene" value="AT3G50920" />
      <Property key="^citations" value="17652095:EV-EXP-IDA:3542745658:dreher" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CHLOROPLAST-PL" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17652095" />
    </DataNode>
