    <DataNode elementId="AT1G51260-MONOMER" textLabel="1-acyl-sn-glycerol-3-phosphate acyltransferase 3" type="Protein">
      <Xref identifier="Q9SYC8" dataSource="uniprot" />
      <Graphics centerX="600" centerY="575" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
