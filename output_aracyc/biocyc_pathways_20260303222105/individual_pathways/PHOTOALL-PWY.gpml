    <DataNode elementId="AT3G55800-MONOMER" textLabel="sedoheptulose-bisphosphatase" type="Protein">
      <Xref identifier="P46283" dataSource="uniprot" />
      <Graphics centerX="750" centerY="735" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis&lt;/i&gt; gene &lt;i&gt;AT3G55800&lt;/i&gt; was predicted to encode a sedoheptulose-1,7-bisphosphatase (SBPase) based on its sequence similarities with the wheat gene (itself based on similarities with the pig sequence) |CITS:[7811976]|. This gene was subsequently overexpressed in &lt;i&gt;Nicotiana tabacum&lt;/i&gt; where its expression was show to correlate with an increase in SBPase activity |CITS:[15863701]|.</Comment>
      <Property key="UniqueID" value="AT3G55800-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G55800.1" />
      <Property key="AlternativeId_Uniprot" value="P46283" />
      <Property key="Synonym_1" value="SBPase" />
      <Property key="Catalyzes" value="RXN-9516" />
      <Property key="Accession1" value="AT3G55800.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT3G55800" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_15863701" />
      <CitationRef elementRef="citation_PUB_7811976" />
    </DataNode>
    <DataNode elementId="AT3G55440-MONOMER" textLabel="Triosephosphate isomerase, cytosolic" type="Protein">
      <Xref identifier="P48491" dataSource="uniprot" />
      <Graphics centerX="900" centerY="735" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">A triose-phosphate isomerase (TGI)-encoding gene of &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; was cloned through PCR amplification and expressed in &lt;i&gt;E. coli&lt;/i&gt; from which recombinant enzymes were extracted |CITS:[12881492]|. The enzyme proved to be very labile in the absence of bovine serum albumine (BSA) which, being rich in cysteine residues, serves as an antioxidant stabilizing agent. Under these conditions, the enzyme was shown to have triose-phosphate isomerase activity |CITS:[12881492]|. The activity of the enzyme is reduced to less than 20% in the presence of 2.5 mM |FRAME:OXIDIZED-GLUTATHIONE|. This inactivation is reversible by addition of |FRAME:GLUTATHIONE|. In the absence of BSA or |FRAME:DITHIOTHREITOL|, the recombinant enzyme was rapidly and irreversibly inactivated, suggesting that it is subject to spontaneous oxidation. This phenomenon is promoted by the addition of |FRAME:GLUTATHIONE| |CITS:[12881492]|.</Comment>
      <Property key="UniqueID" value="AT3G55440-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G55440.1" />
      <Property key="AlternativeId_Panther" value="PTHR21139" />
      <Property key="AlternativeId_Smr" value="P48491" />
      <Property key="AlternativeId_Pride" value="P48491" />
      <Property key="AlternativeId_Interpro" value="IPR020861" />
      <Property key="AlternativeId_Pfam" value="PF00121" />
      <Property key="AlternativeId_Phylomedb" value="P48491" />
      <Property key="AlternativeId_Prosite" value="PS51440" />
      <Property key="AlternativeId_Pdb" value="4OBT" />
      <Property key="AlternativeId_Uniprot" value="P48491" />
      <Property key="AlternativeId_Pid" value="CAB75902" />
      <Property key="Synonym_1" value="TIM" />
      <Property key="Synonym_2" value="Triose-phosphate isomerase" />
      <Property key="Catalyzes" value="RXN-13729" />
      <Property key="Accession1" value="AT3G55440.1" />
      <Property key="Gene" value="AT3G55440" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="30.5" />
      <Property key="MolecularWeightKd" value="30.5" />
      <CitationRef elementRef="citation_PUB_12881492" />
    </DataNode>
