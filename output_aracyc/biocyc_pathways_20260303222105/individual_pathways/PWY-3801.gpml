    <DataNode elementId="AT5G20830-MONOMER" textLabel="Sucrose synthase 1" type="Protein">
      <Xref identifier="P49040" dataSource="uniprot" />
      <Graphics centerX="300" centerY="675" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Sucrose synthase catalyzes the conversion of sucrose and UDP to UDP-glucose and fructose. Although the cleavage of sucrose by sucrose synthase was shown to be reversible |CITS:[14367373]|, biochemical and physiological studies indicate that sucrose synthase acts only in the breakdown of sucrose &lt;i&gt;in vivo&lt;/i&gt; |CITS:[avigad82]|. The &lt;i&gt;SUS1&lt;/i&gt; gene encoding sucrose synthase was isolated from &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. It was shown that during anaerobiosis the increase in &lt;i&gt;SUS1&lt;/i&gt; mRNA levels correlated with an increase in sucrose synthase activity in the roots |CITS:[8220487]|. At the time of this review the enzyme encoded by &lt;i&gt;SUS1&lt;/i&gt; has not been characterized.</Comment>
      <Property key="UniqueID" value="AT5G20830-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G20830.1" />
      <Property key="AlternativeId_Uniprot" value="P49040" />
      <Property key="Synonym_1" value="AtSUS1" />
      <Property key="Synonym_2" value="Sucrose-UDP glucosyltransferase 1" />
      <Property key="Catalyzes" value="RXN-33516, RXN-6600" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G20830.1" />
      <Property key="Gene" value="AT5G20830" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_17257168" />
      <CitationRef elementRef="citation_PUB_10567234" />
      <CitationRef elementRef="citation_PUB_14367373" />
      <CitationRef elementRef="citation_PUB_8220487" />
    </DataNode>
