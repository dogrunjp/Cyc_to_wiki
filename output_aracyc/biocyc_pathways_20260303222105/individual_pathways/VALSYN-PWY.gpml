    <DataNode elementId="AT3G48560-MONOMER" textLabel="Acetolactate synthase, chloroplastic" type="Protein">
      <Xref identifier="P17597" dataSource="uniprot" />
      <Graphics centerX="150" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Acetolactate synthase is the first common enzyme in the biosynthetic pathways of branched-chain amino acids leucine, isoleucine and valine. It is feedback inhibited by the end products leucine, isoleucine and valine. The enzyme is also the target of three classes of herbicides. Point mutations of the enzyme have been isolated and the plants were shown to be herbicide resistant. The sequence of the enzyme is highly conserved in bacteria, yeast and higher plants. The Arabidopsis protein sequence has a chloroplast transit peptide.</Comment>
      <Property key="UniqueID" value="AT3G48560-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G48560.1" />
      <Property key="AlternativeId_Uniprot" value="P17597" />
      <Property key="Synonym_1" value="AtALS" />
      <Property key="Synonym_2" value="Acetohydroxy-acid synthase" />
      <Property key="Synonym_3" value="CHLORSULFURON RESISTANT 1" />
      <Property key="Catalyzes" value="RXN-7411, RXN-5554" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT3G48560.1" />
      <Property key="FunctionalAssignmentStatus" value=":AMBIGUOUS" />
      <Property key="Gene" value="AT3G48560" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_7767237" />
      <CitationRef elementRef="citation_PUB_16594052" />
    </DataNode>
    <DataNode elementId="AT1G10060-MONOMER" textLabel="AT1G10060-MONOMER" type="Protein">
      <Xref identifier="AT1G10060-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Atbcat-1 (AT1G10060) encodes a mitochondrial branched-chain amino acid aminotransferase. It can complement the yeast leu/iso-leu/val auxotrophy mutant. The location of the enzyme in mitochondria suggested its role in branched-chain amino acid degradation|CITS: [12068099]|. In-vitro assay of purified recombinant Atbcat-1 indicated the enzyme is capable degrade all three branched-chain amino acids. It has highest substrate affinity towards isoleucine, followed by leucine then valine|CITS: [15821880]|.</Comment>
      <Property key="UniqueID" value="AT1G10060-MONOMER" />
      <Property key="Synonym_1" value="AT1G10060.5" />
      <Property key="Synonym_2" value="branched-chain amino acid transaminase" />
      <Property key="Catalyzes" value="RXN-9468, RXN-9463, RXN-9433" />
