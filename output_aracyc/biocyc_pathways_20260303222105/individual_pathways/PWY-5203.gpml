    <DataNode elementId="AT1G78960-MONOMER" textLabel="Amyrin synthase LUP2" type="Protein">
      <Xref identifier="AT1G78960.1" dataSource="TAIR gene name" />
      <Graphics centerX="600" centerY="395" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA encoding the protein (AtLUP2) that catalyzes the formation of pentacyclic triterpenoids such as &amp;alpha;- and &amp;beta;-amyrin and lupeol has been isolated from &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. The protein was recombinant expressed in yeast and its molecular function classified as a &amp;beta;-amyrin synthase. The recombinant protein formed 85% &amp;alpha;- and &amp;beta;-amyrin with &amp;beta;-amyrin being the predominant product and 15% lupeol |CITS: [11247608]|. It has been concluded that AtLUP2 is more involved in the formation of &amp;beta;-amyrin than in other triterpenoids such as lupeol which biosynthesis (|FRAME:PWY-112|) is catalyzed by AtLUP1 |CITS: [9883589]|.</Comment>
      <Property key="UniqueID" value="AT1G78960-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G78960.1" />
      <Property key="AlternativeId_Pid" value="AAG41762" />
      <Property key="Synonym_1" value="Alpha-amyrin synthase" />
      <Property key="Synonym_2" value="Beta-amyrin synthase" />
      <Property key="Synonym_3" value="Lupeol synthase 2" />
      <Property key="Synonym_4" value="AtLUP2" />
      <Property key="Catalyzes" value="RXN-33678, RXN-13, RXN-13357" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT1G78960.1" />
      <Property key="Gene" value="AT1G78960" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
