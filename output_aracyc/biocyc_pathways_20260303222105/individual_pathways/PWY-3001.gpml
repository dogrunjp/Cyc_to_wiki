    </DataNode>
    <DataNode elementId="AT1G10060-MONOMER" textLabel="AT1G10060-MONOMER" type="Protein">
      <Xref identifier="AT1G10060-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="900" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Atbcat-1 (AT1G10060) encodes a mitochondrial branched-chain amino acid aminotransferase. It can complement the yeast leu/iso-leu/val auxotrophy mutant. The location of the enzyme in mitochondria suggested its role in branched-chain amino acid degradation|CITS: [12068099]|. In-vitro assay of purified recombinant Atbcat-1 indicated the enzyme is capable degrade all three branched-chain amino acids. It has highest substrate affinity towards isoleucine, followed by leucine then valine|CITS: [15821880]|.</Comment>
      <Property key="UniqueID" value="AT1G10060-MONOMER" />
      <Property key="Synonym_1" value="AT1G10060.5" />
      <Property key="Synonym_2" value="branched-chain amino acid transaminase" />
      <Property key="Catalyzes" value="RXN-9468, RXN-9463, RXN-9433" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="GOTerms" value="GO:0005739" />
      <Property key="Accession1" value="AT1G10060.5" />
      <Property key="EnzymeNotUsedIn" value="VALSYN-PWY, LEUSYN-PWY, ILEUSYN-PWY" />
      <Property key="Gene" value="AT1G10060" />
      <Property key="^citations" value="12068099" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-MIT-PL" />
      <CitationRef elementRef="citation_PUB_15821880" />
      <CitationRef elementRef="citation_PUB_12068099" />
    </DataNode>
