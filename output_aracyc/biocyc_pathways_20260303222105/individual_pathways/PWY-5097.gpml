    <DataNode elementId="AT3G60880-MONOMER" textLabel="4-hydroxy-tetrahydrodipicolinate synthase 1, chloroplastic" type="Protein">
      <Xref identifier="Q9LZX6" dataSource="uniprot" />
      <Graphics centerX="450" centerY="395" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">There is evidence that this enzyme has activity when the apoprotein is expressed in &lt;i&gt;E.coli&lt;/i&gt; |CITS: [10758475]|. It is sensitive to lysine inhibition, but the substitution of an arginine for an important tryptophan makes the enzyme insensitive to lysline-mediated inhibition |CITS: [10758475]|.</Comment>
      <Property key="UniqueID" value="AT3G60880-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G60880.2" />
      <Property key="AlternativeId_Uniprot" value="Q9LZX6" />
      <Property key="Synonym_1" value="HTPA synthase 1" />
