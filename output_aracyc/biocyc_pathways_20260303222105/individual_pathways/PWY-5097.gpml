      <CitationRef elementRef="citation_PUB_10758475" />
    </DataNode>
    <DataNode elementId="AT1G31230-MONOMER" textLabel="AT1G31230-MONOMER" type="Protein">
      <Xref identifier="AT1G31230-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="600" centerY="395" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis&lt;/i&gt; gene &lt;i&gt;AK-HSDH1&lt;/i&gt; was overexpressed in &lt;i&gt;E. coli&lt;/i&gt;, purified to homogeneity, and characterized |CITS:[16216875]|. The enzyme was shown to be bifunctional and to have both aspartate kinase and homoserine dehydrogenase activities |CITS:[16216875]|.</Comment>
      <Property key="UniqueID" value="AT1G31230-MONOMER" />
      <Property key="Synonym_1" value="AK1" />
      <Property key="Synonym_2" value="HSDH1" />
      <Property key="Catalyzes" value="RXN-4433, RXN-4432" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT1G31230.1" />
      <Property key="Gene" value="AT1G31230" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_16216875" />
    </DataNode>
    <DataNode elementId="AT3G02020-MONOMER" textLabel="Aspartokinase 3, chloroplastic" type="Protein">
      <Xref identifier="Q9S702" dataSource="uniprot" />
      <Graphics centerX="150" centerY="475" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Aspartate kinase (AK) is a key enzyme in the biosynthsis of aspartate family amino acids such as lysine, threonine, isoleucine, and methionine. In plants, two types of AK are known: one is sensitive to feedback inhibition by threonine and carries both AK and homoserine dehydrogenase (HSD) activities catalyzing the first and third step of threonine biosynthesis. The other one is monofunctional, sensitive to lysine and synergistically S-adenosylmethionine, and has only AK activity. In Arabidopsis, there are two bifunctional AK/HSD genes and three reported monofunctional AK genes.</Comment>
      <Property key="UniqueID" value="AT3G02020-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G02020.1" />
      <Property key="AlternativeId_Uniprot" value="Q9S702" />
      <Property key="Synonym_1" value="Aspartate kinase 3" />
      <Property key="Catalyzes" value="RXN-12385, RXN-5251" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT3G02020.1" />
      <Property key="Gene" value="AT3G02020" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_12602885" />
    </DataNode>
