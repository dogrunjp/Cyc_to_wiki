    <DataNode elementId="MONOMER-17353" textLabel="MONOMER-17353" type="Protein">
      <Xref identifier="MONOMER-17353" dataSource="plantcyc" />
      <Graphics centerX="600" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang">A phospholipase C was partially purified from highly purified wheat plasma membranes. The wheat phospholipase C acts on both phosphatidylinositol 4,5-bisphosphate, PI(4,5)P2, and phosphatidylinositol 4-phosphate (PI4P). The specific activities towards PI(4,5)P2 and PI4P were 10 umol/min/mg and 5 umol/min/mg, respectively. Phosphatidylinositol was not accepted as a substrate. The enzyme had an absolute requirement of Ca2+ for basal activity with both substrates. Mg2+ further enhanced the enzyme activities.</Comment>
      <Property key="UniqueID" value="MONOMER-17353" />
      <Property key="Catalyzes" value="RXN-20355" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_1310875" />
    </DataNode>
