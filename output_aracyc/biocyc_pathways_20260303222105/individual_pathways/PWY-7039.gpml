    <DataNode elementId="AT3G15730-MONOMER" textLabel="PLD alpha" type="Protein" groupRef="AT3G15730-CPLX">
      <Xref identifier="Q38882" dataSource="uniprot" />
      <Graphics centerX="300.0" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
