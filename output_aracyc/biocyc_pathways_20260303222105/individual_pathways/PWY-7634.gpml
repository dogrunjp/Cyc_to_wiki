    <DataNode elementId="AT3G10570-MONOMER" textLabel="fatty acid in-chain hydroxylase" type="Protein">
      <Xref identifier="AT3G10570-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="150" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, zhang">CYP77A6 is an in-chain fatty acid hydroxylase involved in cutin biosynthesis. No cuticle could be observed in flower petals of the CYP77A6 mutant plants. The mutants had a complete reduction of 10,16-dihydroxypalmitate, concomitant with an increase of 16- hydroxypalmitate |CITS: [19959665]|. Microsome fractions of yeast cells expressing CYP77A6 was shown to metabolize 16-hydroxypalmitate to form dihydroxypalmitates |CITS: [19959665]|.</Comment>
      <Property key="UniqueID" value="AT3G10570-MONOMER" />
      <Property key="Synonym_1" value="CYP77A6" />
      <Property key="Catalyzes" value="RXN-33794, RXN-33793, RXN-33792, RXN-33791, RXN-33790, RXN-33789, RXN-33788, RXN-12859" />
