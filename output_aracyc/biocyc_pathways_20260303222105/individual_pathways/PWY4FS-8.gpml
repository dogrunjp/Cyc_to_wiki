    <DataNode elementId="AT5G40610-MONOMER" textLabel="Glycerol-3-phosphate dehydrogenase [NAD(+)] 1, chloroplastic" type="Protein">
      <Xref identifier="AT5G40610-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="750" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">GPDHp is one of the plastidic glycerol-3-phosphate dehydrogenases found in |FRAME: ORG-5993|. Its enzyme activity was confirmed through complementation of the gpsA mutant from E.coli and from in vitro enzymatic analyses |CITS: [WEI01]|. The N-terminal 55 amino acids of this protein were sufficient to direct a GFP fusion protein to the chloroplasts in mesophyll protoplasts |CITS: [WEI01]|.</Comment>
      <Property key="UniqueID" value="AT5G40610-MONOMER" />
      <Property key="Catalyzes" value="RXN-19361, RXN-6624" />
      <Property key="CatalyzesCount" value="2" />
