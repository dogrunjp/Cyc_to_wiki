    <DataNode elementId="AT1G51260-MONOMER" textLabel="1-acyl-sn-glycerol-3-phosphate acyltransferase 3" type="Protein">
      <Xref identifier="Q9SYC8" dataSource="uniprot" />
      <Graphics centerX="450" centerY="515" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Property key="UniqueID" value="AT1G51260-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G51260.1" />
      <Property key="AlternativeId_Uniprot" value="Q9SYC8" />
      <Property key="Synonym_1" value="Lysophosphatidyl acyltransferase 3" />
      <Property key="Catalyzes" value="RXN-12155" />
      <Property key="Accession1" value="AT1G51260.1" />
      <Property key="EnzymeNotUsedIn" value="PWYQT-4482, PWY0-1319" />
