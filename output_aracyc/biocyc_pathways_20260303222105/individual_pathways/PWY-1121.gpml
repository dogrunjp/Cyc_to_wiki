    </DataNode>
    <DataNode elementId="AT5G54160-MONOMER" textLabel="Flavone 3&apos;-O-methyltransferase 1" type="Protein">
      <Xref identifier="AT5G54160.1" dataSource="TAIR gene name" />
      <Graphics centerX="300" centerY="915" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">This enzyme has been shown to act as a 3&apos;-O-methyltransferase on a variety of substrates, based both on in vitro assays and mutant phenotypes. The substrates characterized to date are quercetin |CITS: [10700397][12777055]|, myricetin |CITS:[10700397]|, and caffeic acid, 5-OH-ferulic acid, 5-OH-coniferaldehyde, and 5-OH-coniferyl alcohol |CITS:[12777055]|. Another papers identifies the enzyme as a flavonol 3&apos;-methyltransferase |CITS: [10700397]|.</Comment>
      <Property key="UniqueID" value="AT5G54160-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G54160.1" />
      <Property key="AlternativeId_Pid" value="AAB96879" />
      <Property key="Synonym_1" value="AtOMT1" />
      <Property key="Synonym_2" value="Acetylserotonin O-methyltransferase OMT1" />
      <Property key="Synonym_3" value="Caffeate O-methyltransferase 1" />
      <Property key="Synonym_4" value="Quercetin 3&apos;-O-methyltransferase 1" />
      <Property key="Catalyzes" value="RXN-33985, RXN-33984, RXN-33983, RXN-33982, RXN-1226, RXN-12638, RXN-ARA-937, RXN-10545, RXN-13097, RXN-1224" />
      <Property key="CatalyzesCount" value="10" />
