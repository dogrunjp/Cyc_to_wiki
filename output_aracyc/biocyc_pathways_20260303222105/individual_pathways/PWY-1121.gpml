    <DataNode elementId="AT3G61990.1" textLabel="AT3G61990.1" type="Protein">
      <Xref identifier="AT3G61990.1" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="915" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
