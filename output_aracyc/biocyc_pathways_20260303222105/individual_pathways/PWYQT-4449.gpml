    <DataNode elementId="AT1G49530-MONOMER" textLabel="Geranylgeranyl pyrophosphate synthase 6, mitochondrial" type="Protein">
      <Xref identifier="Q9XIC0" dataSource="uniprot" />
      <Graphics centerX="450" centerY="555" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;GGPS6&lt;/i&gt; when expressed in recombinant &lt;i&gt;E.coli&lt;/i&gt; was shown to encode for a protein catalyzing the condensation of farnesyl pyrophosphate (FPP) and isopentenyl pyrophosphate (IPP) to produce geranylgeranyl diphosphate (GGPP) |CITS:[9349257]|. In the same study, &lt;i&gt;Arabidopsis GGPS6&lt;/i&gt; was expressed in a strain of &lt;i&gt;E.coli&lt;/i&gt; containing all the metabolic &lt;i&gt;E. uredovora&lt;/i&gt; genes required for the biosynthesis of carotenoids from GGPP. This systems uses a visible screen (yellow color) to determine the expression of a protein with geranylgeranyl pyrophosphate synthase activity such as AtGGPS6 |CITS:[9349257]|. &lt;i&gt;In planta&lt;/i&gt;, the protein was shown to be localized in the mitochondria of hypocotyl epidermal cells |CITS:[10759500]|.</Comment>
      <Property key="UniqueID" value="AT1G49530-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G49530.1" />
      <Property key="AlternativeId_Pid" value="NP_175376" />
      <Property key="AlternativeId_Uniprot" value="Q9XIC0" />
      <Property key="Synonym_1" value="GGPP synthase 6" />
      <Property key="Synonym_2" value="GGPS6" />
      <Property key="Synonym_3" value="(2E,6E)-farnesyl diphosphate synthase 6" />
      <Property key="Synonym_4" value="Dimethylallyltranstransferase 6" />
      <Property key="Synonym_5" value="Farnesyl diphosphate synthase 6" />
      <Property key="Synonym_6" value="Farnesyltranstransferase 6" />
      <Property key="Synonym_7" value="Geranyltranstransferase 6" />
      <Property key="Catalyzes" value="RXN-33178, RXN-33177, RXN-4463" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT1G49530.1" />
      <Property key="Gene" value="AT1G49530" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_9349257" />
      <CitationRef elementRef="citation_PUB_10759500" />
    </DataNode>
    <DataNode elementId="AT5G47770-MONOMER" textLabel="AT5G47770-MONOMER" type="Protein">
      <Xref identifier="Q09152" dataSource="uniprot" />
      <Graphics centerX="600" centerY="555" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;FPS1&lt;/i&gt; was shown to complement the mutant phenotype of the &lt;i&gt;Saccharomyces cerevisiae&lt;/i&gt; mutant strain CC25 which bears a leaky mutation (erg20) preventing the condensation of GPP with IPP to form FPP, resulting in a lethal phenotype |CITS:[7858223]|. The complementation experiment therefore demonstrates the ability of FPS to catalyze the conversion of GPP into FPP. Moreover, the &lt;i&gt;Arabidopsis&lt;/i&gt; gene was also able to complement another &lt;i&gt;S. cerevisiae&lt;/i&gt; mutant strain (DD163) where the FPP synthase gene was fully disrupted, showing that the FPS1 catalyzes both IPP condensation steps |CITS:[7858223]|.</Comment>
      <Property key="UniqueID" value="AT5G47770-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G47770.1" />
      <Property key="AlternativeId_Uniprot" value="Q09152" />
      <Property key="AlternativeId_Pid" value="CAA53433" />
      <Property key="Synonym_1" value="geranyltranstransferase//dimethylallyltranstransferase" />
      <Property key="Catalyzes" value="RXN-12473, RXN-12472" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G47770.1" />
      <Property key="Gene" value="AT5G47770" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_8631820" />
      <CitationRef elementRef="citation_PUB_7858223" />
    </DataNode>
    <DataNode elementId="AT2G18620-MONOMER" textLabel="AT2G18620-MONOMER" type="Protein">
      <Xref identifier="Q9ZU77" dataSource="uniprot" />
