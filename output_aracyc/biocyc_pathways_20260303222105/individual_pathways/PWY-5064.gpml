    <DataNode elementId="AT1G74470-MONOMER" textLabel="geranylgeranyl reductase" type="Protein">
      <Xref identifier="O49594" dataSource="uniprot" />
      <Graphics centerX="150" centerY="215" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">A cDNA containing the &lt;i&gt;Arabidopsis thaliana At1g74470&lt;/i&gt; gene was expressed in &lt;i&gt;E. coli&lt;/i&gt; and shown to encode for a multifunctional enzyme with geranylgeranyl reductase activity. This enzyme catalyzes the reduction of prenylated geranylgeranyl-chlorophyll a to phytyl-chlorophyll a (chlorophyll a) involved specifically in |FRAME:PWY-5064|, as well as free geranylgeranyl pyrophosphate to phytyl pyrophosphate, a compound which is evenly distributed to the different subplastidial pathways of prenyllipids (|FRAME:CHLOROPHYLL-SYN|,|FRAME:PWY-5027|,|FRAME:PWY-1422|). The enzyme requires reducing agents for activity |CITS:[9492312]|. It has been postulated that, due to its weak hydrophobicity, this enzyme might easily partition between the thylakoid and the plastid envelope membranes and can thus be recruited for either the chlorophyll or the prenylquinone pathways.</Comment>
      <Property key="UniqueID" value="AT1G74470-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G74470.1" />
      <Property key="AlternativeId_Uniprot" value="O49594" />
      <Property key="AlternativeId_Pid" value="AAO00931" />
      <Property key="Catalyzes" value="RXN-33669, RXN-12119, RXN-12118, RXN-12117, RXN-12120, RXN-12121, RXN-12122" />
      <Property key="CatalyzesCount" value="7" />
      <Property key="Accession1" value="AT1G74470.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
