    <DataNode elementId="AT1G11720-MONOMER" textLabel="soluble starch synthase III" type="Protein">
      <Xref identifier="AT1G11720-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="600" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">SSIII (SS3) is a soluble starch synthase that is required for normal |FRAME: CPD-7043| formation in conjunction with |FRAME: AT3G01180 SSII| |CITS: [18811962][21624979][19666739]|. SSIII appears to have a preference for glucan chains that have more than 25 glucosyl units |CITS: [23393426]|.</Comment>
      <Property key="UniqueID" value="AT1G11720-MONOMER" />
      <Property key="Synonym_1" value="SSIII" />
      <Property key="Synonym_2" value="SS3" />
      <Property key="Catalyzes" value="RXN-ARA-391" />
      <Property key="GOTerms" value="GO:0009507, GO:0009570" />
      <Property key="Accession1" value="AT1G11720.2" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT1G11720" />
      <Property key="^citations" value="18431481:EV-EXP-IDA:3572316798:dreher, 23393426:EV-IC:3572316811:dreher" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CHLOROPLAST-PL, CCI-CHLOR-STR-PL" />
      <CitationRef elementRef="citation_PUB_23393426" />
    </DataNode>
    <DataNode elementId="AT4G09510-MONOMER" textLabel="neutral/alkaline invertase" type="Protein">
      <Xref identifier="AT4G09510-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="750" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">CINV2 appears to function as a neutral invertase based on the phenotype of a |FRAME: AT1G35580-MONOMER cinv1|/cinv2 double mutant (|CITS: [19470642 ]| cf |CITS: [17220200]|). It is predicted to be a cytosolic enzyme. |FRAME: AT1G35580-MONOMER CINV1|, CINV2, and possibly other cytosolic invertases may play an important role in supplying carbon from sucrose to non-photosynthetic tissues |CITS: [19470642 ]|.</Comment>
      <Property key="UniqueID" value="AT4G09510-MONOMER" />
      <Property key="Synonym_1" value="alkaline/neutral invertase" />
      <Property key="Catalyzes" value="RXN-33403, RXN-38" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT4G09510.1" />
      <Property key="Gene" value="AT4G09510" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_17220200" />
    </DataNode>
