    <DataNode elementId="AT3G03540-MONOMER" textLabel="AT3G03540-MONOMER" type="Protein">
      <Xref identifier="Q9S816" dataSource="uniprot" />
      <Graphics centerX="600" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">There are two characterized non-specific phospholipase C (NPC) genes in Arabidopsis, NPC4 and NPC5. NPC activity in npc4 mutant was strongly reduced, suggesting that NPC4 is the most active NPC. In vitro activity assay also showed a 40-fold higher activity for NPC4. NPC4 is located at the plasma membrane, whereas NPC5 is located in the cytosol. The biological role of NPC5 was indicated in galactolipid biosynthesis in the chloroplasts. Under phosphate deprivation, NPC5 is transported from the cytosol to the chloroplast, and the diacylglycerol produced from NPC5 is used in galactolipid biosynthesis.</Comment>
      <Property key="UniqueID" value="AT3G03540-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G03540.1" />
      <Property key="AlternativeId_Uniprot" value="Q9S816" />
      <Property key="Synonym_1" value="phospholipase C" />
      <Property key="Catalyzes" value="RXN-15366" />
      <Property key="Accession1" value="AT3G03540.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT3G03540" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="60." />
      <Property key="MolecularWeightKd" value="60." />
      <CitationRef elementRef="citation_PUB_18564386" />
    </DataNode>
