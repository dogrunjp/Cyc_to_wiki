    <DataNode elementId="AT2G06925-MONOMER" textLabel="Phospholipase A2-alpha" type="Protein">
      <Xref identifier="Q8S8N6" dataSource="uniprot" />
      <Graphics centerX="450" centerY="1115" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">NIL Plant PLA2s can be classified into two groups, the secretory and the patatin-like. The secretory group is sn-2-specific, whereas the patatin-like PLA2s can also hydrolyze the sn-1 acyl groups of phospholipids. There are four members of the Arabidopsis secretory PLA2s. PLA2-alpha exhibits an acyl preference for linoleoyl over palmitoyl, whereas PLA2-beta has an opposite preference. Neither PLA2-gamma nor PLA2-delta has any specific acyl preference. PLA2-alpha and beta also displayed slight headgroup preference for phosphatidylethanolamine (PE) over phosphatidylcholine (PC). PLA2-gamma and delta had strong preference for PE over PC.</Comment>
      <Property key="UniqueID" value="AT2G06925-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G06925.1" />
      <Property key="AlternativeId_Uniprot" value="Q8S8N6" />
      <Property key="Synonym_1" value="Secretory phospholipase A2-alpha" />
      <Property key="Synonym_2" value="AtsPLA2-alpha" />
      <Property key="Catalyzes" value="RXN-12779" />
      <Property key="Accession1" value="AT2G06925.1" />
      <Property key="Gene" value="AT2G06925" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="16." />
      <Property key="MolecularWeightKd" value="16." />
      <Property key="Pi" value="7.61" />
      <CitationRef elementRef="citation_PUB_16140037" />
    </DataNode>
