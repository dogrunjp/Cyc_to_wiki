    <DataNode elementId="AT4G16820-MONOMER" textLabel="Phospholipase A1-Ibeta2, chloroplastic" type="Protein">
      <Xref identifier="O23522" dataSource="uniprot" />
      <Graphics centerX="450" centerY="715" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Purified recombinant protein was assayed for acylhydrolase activities. The enzyme hydrolyzed phosphatidylcholine, glycolipids (MGDG and DGDG) as well as triacylglycerol.</Comment>
      <Property key="UniqueID" value="AT4G16820-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G16820.1" />
      <Property key="AlternativeId_Uniprot" value="O23522" />
      <Property key="Catalyzes" value="RXN-33417, RXN-12824, RXN-12823, RXN-T9-1792" />
