    <DataNode elementId="AT4G29460-MONOMER" textLabel="Phospholipase A2-gamma" type="Protein">
      <Xref identifier="Q9M0D7" dataSource="uniprot" />
      <Graphics centerX="1350" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">NIL Plant PLA2s can be classified into two groups, the secretory and the patatin-like. The secretory group is sn-2-specific, whereas the patatin-like PLA2s can also hydrolyze the sn-1 acyl groups of phospholipids. There are four members of the Arabidopsis secretory PLA2s. PLA2-alpha exhibits an acyl preference for linoleoyl over palmitoyl, whereas PLA2-beta has an opposite preference. Neither PLA2-gamma nor PLA2-delta has any specific acyl preference. PLA2-alpha and beta also displayed slight headgroup preference for phosphatidylethanolamine (PE) over phosphatidylcholine (PC). PLA2-gamma and delta had strong preference for PE over PC.</Comment>
      <Property key="UniqueID" value="AT4G29460-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G29460.1" />
      <Property key="AlternativeId_Uniprot" value="Q9M0D7" />
      <Property key="Synonym_1" value="Secretory phospholipase A2-gamma" />
      <Property key="Synonym_2" value="AtsPLA2-gamma" />
      <Property key="Catalyzes" value="RXN-12780" />
      <Property key="Accession1" value="AT4G29460.1" />
      <Property key="Gene" value="AT4G29460" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_16140037" />
    </DataNode>
    <DataNode elementId="AT2G31690-MONOMER" textLabel="Phospholipase A1-Ialpha2, chloroplastic" type="Protein">
      <Xref identifier="Q9SIN9" dataSource="uniprot" />
      <Graphics centerX="150" centerY="715" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA encoding triacylglycerol lipase has been identified and characterized in &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. The molecular function of hydrolyzing long chain triacylglyceride has been demonstrated by recombinant expression and characterization of the protein in &lt;i&gt;E. coli&lt;/i&gt;. The triacylglycerol lipase is localized in plastoglobuli within the chloroplast stroma. It has been shown that transgenic Arabidopsis plants expressing a antisense construct of the gene are stunted and have severely disorganized thylakoids. It has been concluded that At2g31690 encodes for a triacylglycerol lipase that is involved in both leaf senescence and maintaining the structural integrity of the chloroplast |CITS: [17259290]|.</Comment>
      <Property key="UniqueID" value="AT2G31690-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G31690.1" />
      <Property key="AlternativeId_Uniprot" value="Q9SIN9" />
      <Property key="AlternativeId_Pid" value="AAD24845" />
      <Property key="Catalyzes" value="RXN-33273, RXN-12822, RXN-12821, RXN-5096" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="GOTerms" value="GO:0009507" />
      <Property key="Accession1" value="AT2G31690.1" />
      <Property key="Gene" value="AT2G31690" />
      <Property key="^citations" value="17259290" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CHLOROPLAST-PL" />
      <Property key="MolecularWeightExp" value="46." />
      <Property key="MolecularWeightKd" value="46." />
      <CitationRef elementRef="citation_PUB_17259290" />
    </DataNode>
    <DataNode elementId="AT3G48610.1" textLabel="AT3G48610.1" type="Protein">
