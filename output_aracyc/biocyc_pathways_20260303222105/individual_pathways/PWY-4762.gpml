      <Property key="Synonym_2" value="an L-1-phosphatidylethanolamine" />
      <Property key="Synonym_3" value="a 1-phosphatidylethanolamine" />
      <Property key="Synonym_4" value="an L-1-phosphotidylethanolamine" />
      <Property key="Synonym_5" value="a phosphatidylethenolamine" />
      <Property key="Synonym_6" value="an &lt;i&gt;O&lt;/i&gt;-(1-&amp;beta;-acyl-2-acyl-&lt;i&gt;sn&lt;/i&gt;-glycero-3-phospho)-ethanolamine" />
      <Property key="Synonym_7" value="PtdEtn" />
