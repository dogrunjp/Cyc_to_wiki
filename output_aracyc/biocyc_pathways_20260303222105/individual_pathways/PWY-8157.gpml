    <DataNode elementId="AT1G74550-MONOMER" textLabel="tricoumaroylspermidine meta-hydroxylase" type="Protein">
      <Xref identifier="Q9CA60" dataSource="uniprot" />
      <Graphics centerX="750" centerY="615" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">CYP98A9 is a member of the cytochrome p450 family of enzymes. Several lines of evidence including analysis of mutant plants with reduced and elevated levels of CYP98A9 and characterization of the recombinant CYP98A9 enzyme suggest that this enzyme catalyzes the &lt;i&gt;meta&lt;/i&gt; attachment of hydroxyl residues to any of the phenolic rings of |FRAME: CPD-12212| |CITS: [19779199]|. Interestingly, although the reaction catalyzed by this enzyme is depicted as a single step, there is evidence that CYP98A9 releases a mono- and a di-hydroxylated intermediate that can be subject to methylation |CITS: [19779199]|. CYP98A9 participates in the formation of N&lt;sup&gt;1&lt;/sup&gt;,N&lt;sup&gt;5&lt;/sup&gt;-di(hydroxyferuloyol)- N&lt;sup&gt;10&lt;/sup&gt;-sinapoylspermidine, an important constituent of pollen. This gene appears to be expressed in young flower buds and inflorescence tips with notably high levels of expression in the tapetum and pollen. It is also expressed in root tips |CITS: [19779199]|.</Comment>
      <Property key="UniqueID" value="AT1G74550-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G74550.1" />
      <Property key="AlternativeId_Uniprot" value="Q9CA60" />
      <Property key="Catalyzes" value="RXN-33217, RXN-33216, RXN-33215, RXN-12878" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT1G74550.1" />
      <Property key="Gene" value="AT1G74550" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_19779199" />
    </DataNode>
