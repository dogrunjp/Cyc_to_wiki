    <DataNode elementId="AT3G21240-MONOMER" textLabel="4-coumarate--CoA ligase 2" type="Protein">
      <Xref identifier="Q9S725" dataSource="uniprot" />
      <Graphics centerX="750" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">4-coumarate coenzyme A ligase is encoded by a gene family of three members, &lt;i&gt;4CL1&lt;/i&gt;, &lt;i&gt;4CL2&lt;/i&gt; and &lt;i&gt;4CL3&lt;/i&gt;. The 4CL1, 4CL2 and 4CL3 proteins were expressed in &lt;i&gt;E. coli&lt;/i&gt; where they were shown to have different substrate specificities. 4CL1 has higher substrate specificity for 4-coumarate and caffeate than ferulate. 4CL2 has higher specificity for caffeate than coumarate, and ferulate is not a substrate of 4CL2. 4CL3 has higher specificity for 4-coumarate than caffeate and ferulate. All three proteins are also able to convert cinnamate, albeit with low efficiency, and none would convert sinapate.</Comment>
      <Property key="UniqueID" value="AT3G21240-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G21240.1" />
      <Property key="AlternativeId_Smr" value="Q9S725" />
      <Property key="AlternativeId_Pride" value="Q9S725" />
      <Property key="AlternativeId_Interpro" value="IPR025110" />
      <Property key="AlternativeId_Pfam" value="PF13193" />
      <Property key="AlternativeId_Phylomedb" value="Q9S725" />
      <Property key="AlternativeId_Prosite" value="PS00455" />
      <Property key="AlternativeId_Uniprot" value="Q9S725" />
      <Property key="AlternativeId_Modbase" value="Q9S725" />
      <Property key="AlternativeId_Swissmodel" value="Q9S725" />
      <Property key="AlternativeId_Pid" value="NP_188761" />
      <Property key="Synonym_1" value="4CL 2" />
      <Property key="Synonym_2" value="4-coumarate--CoA ligase isoform 2" />
      <Property key="Synonym_3" value="At4CL2" />
      <Property key="Synonym_4" value="4-coumaroyl-CoA synthase 2" />
      <Property key="Catalyzes" value="RXN-1230, RXN-2043" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT3G21240.1" />
      <Property key="Gene" value="AT3G21240" />
