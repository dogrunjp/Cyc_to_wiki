    <DataNode elementId="AT5G26000-MONOMER" textLabel="AT5G26000-MONOMER" type="Protein">
      <Xref identifier="AT5G26000-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="555" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The Arabidopsis genome has a family of six myrosinase genes. Myrosinase function is only known for TGG1 and TGG2. TGG1 and TGG2 appear to be functionally redundant. Single mutation of either one of them does not show any difference from the wild type plants in glucosinolate breakdown, when induced by tissue damage. However, double mutant of TGG1 and TGG2 has undetectable myrosinase activity. The developmental decreases of glucosinolate during senescence and germination are independent of TGG1 and TGG2. The Arabidopsis TGG1 and TGG2 myrosinases are soluble proteins.</Comment>
      <Property key="UniqueID" value="AT5G26000-MONOMER" />
      <Property key="Catalyzes" value="RXN-33956, RXN-33955, RXN-12887, RXN-7164" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT5G26000.1" />
      <Property key="FunctionalAssignmentStatus" value=":AMBIGUOUS" />
      <Property key="Gene" value="AT5G26000" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="76." />
      <Property key="MolecularWeightKd" value="76." />
      <CitationRef elementRef="citation_PUB_16640593" />
    </DataNode>
