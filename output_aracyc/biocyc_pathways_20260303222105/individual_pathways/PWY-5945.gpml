      <Property key="BalanceStatus" value=":BALANCED" />
      <Property key="PhysiologicallyRelevant" value="T" />
      <Property key="EnzymaticReaction" value="ENZRXN-12744" />
      <Property key="ReactionTypes" value="Chemical-Reactions, Small-Molecule-Reactions" />
