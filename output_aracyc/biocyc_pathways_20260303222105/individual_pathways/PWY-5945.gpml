    <Interaction elementId="RXN-7984">
      <Xref identifier="RXN-7984" dataSource="PlantCyc" />
      <Waypoints>
        <Point elementId="RXN-7984_start" x="395.0" y="415" elementRef="CPD1F-133" relX="1.0" relY="0.0" />
