    <DataNode elementId="AT3G21780-MONOMER" textLabel="UDP-glycosyltransferase 71B6" type="Protein">
      <Xref identifier="Q9LSY6" dataSource="uniprot" />
      <Graphics centerX="750" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana UGT71B6&lt;/i&gt; gene encodes a protein with glucosyltransferase activity. The gene was expressed in &lt;i&gt;E. coli&lt;/i&gt; and purified as a GST-fusion protein |CITS:[lim05]|. The purified protein was shown to catalyze the transfer of glucose from UDP-glucose to |FRAME:CPD-693| but not (-)-ABA |CITS:[lim05]|. Expression of the gene was shown to be up-regulated in response to salt or osmosis stress, as well as ABA treatment |CITS:[16623908]|.</Comment>
      <Property key="UniqueID" value="AT3G21780-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G21780.1" />
      <Property key="AlternativeId_Interpro" value="IPR002213" />
      <Property key="AlternativeId_Uniprot" value="Q9LSY6" />
      <Property key="AlternativeId_Cazy" value="GT1" />
      <Property key="AlternativeId_Panther" value="PTHR11926" />
      <Property key="AlternativeId_Smr" value="Q9LSY6" />
      <Property key="AlternativeId_Pride" value="Q9LSY6" />
      <Property key="AlternativeId_Pfam" value="PF00201" />
      <Property key="AlternativeId_Phylomedb" value="Q9LSY6" />
      <Property key="AlternativeId_Prosite" value="PS00375" />
      <Property key="AlternativeId_Pid" value="NP_188815" />
      <Property key="Synonym_1" value="Abscisic acid glycosyltransferase" />
      <Property key="Catalyzes" value="RXN-12935" />
      <Property key="Accession1" value="AT3G21780.1" />
