    <DataNode elementId="AT3G25820-MONOMER" textLabel="1,8-cineole synthase" type="Protein">
      <Xref identifier="Q9LDF1" dataSource="uniprot" />
      <Graphics centerX="300" centerY="495" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The main product of the conversion of geranyl-PP by TPS-Cin is the monoterpene 1,8-cineole (52%). This enzyme is however also able to calalyze the biosynthesis of several additional monoterpenes, albeit in minor quantities: sabinene (14.5%), myrcene (13.3%), &amp;beta;-pinene (7.8%), limonene (4%), &amp;alpha;-terpineol (2.4%), &amp;alpha;-pinene (1.9%), terpinolene (0.8%) and &amp;alpha;-thujene (0.6%) |CITS: [15299125]|.</Comment>
      <Property key="UniqueID" value="AT3G25820-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G25820.1" />
      <Property key="AlternativeId_Uniprot" value="Q9LDF1" />
