      <Property key="Catalyzes" value="RXN-33910, RXN-18706, RXN-18705, RXN-18704, RXN-18703, RXN-18702, RXN-18701, RXN-18710, RXN-18709, RXN-18708, RXN-18707" />
      <Property key="CatalyzesCount" value="11" />
      <Property key="GOTerms" value="GO:0005792" />
