    <DataNode elementId="AT4G15130-MONOMER" textLabel="choline-phosphate cytidylyltransferase" type="Protein">
      <Xref identifier="Q8L4J8" dataSource="uniprot" />
      <Graphics centerX="450" centerY="495" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">In cold-hardy plants, low temperature induces the expansion of cellular membranes which requires phospholipid biosynthesis including phosphatidylcholine (PC). CTP:phosphorylcholine cytidylyltransferase (CCT) is a key enzyme in PC biosynthesis. It was shown in Arabidopsis that CCT activity increased at low temperatures. The Arabidopsis genome has two CCT genes, CCT1 (At2G32260) and CCT2 (At4G15130). Either of the CCT genes was sufficient for the increased PC biosynthesis at low temperature, however by isogene-specific mechanisms: CCT2 gene expression was enhanced; whereas the membrane bound CCT1 protein activity was post-translationally regulated.</Comment>
      <Property key="UniqueID" value="AT4G15130-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G15130.1" />
      <Property key="AlternativeId_Uniprot" value="Q8L4J8" />
      <Property key="Catalyzes" value="RXN-6131" />
      <Property key="Accession1" value="AT4G15130.1" />
      <Property key="Gene" value="AT4G15130" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_19667100" />
    </DataNode>
