      <Property key="Synonym_3" value="1,2-diacyl-sn-glycero-3-phospho-(1&apos;-myo-inositol-4&apos;,5&apos;-bisphosphate" />
      <Property key="Synonym_4" value="PIP2" />
      <Property key="Synonym_5" value="phosphatidylinositol-4,5-bisphosphate" />
      <Property key="AtomCharges" value="(23 -1), (22 -1), (21 -1), (19 -1), (18 -1)" />
