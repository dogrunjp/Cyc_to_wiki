    <DataNode elementId="AT2G24270-MONOMER" textLabel="NADP-dependent glyceraldehyde-3-phosphate dehydrogenase" type="Protein">
      <Xref identifier="Q1WIQ6" dataSource="uniprot" />
      <Graphics centerX="450" centerY="1235" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">An &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; mutant containing a T-DNA insertion in the &lt;i&gt;NP-GAPDH&lt;/i&gt; gene was confirmed to be defective in non-phosphorylating glyceraldehydes 3-phosphate dehydrogenase activity by enzymatic assay |CITS:[16927206]|. Incidentally, in this mutant line, it was shown that the activity of the phosphorylating glyceraldehydes 3-phosphate dehydrogenase (presumably encoded by the &lt;i&gt;Arabidopsis&lt;/i&gt; gene &lt;i&gt;AT3G04120&lt;/i&gt;) was increased, possibly to compensate for the absence of the non-phosphorylating enzyme |CITS:[16927206]|.</Comment>
      <Property key="UniqueID" value="AT2G24270-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G24270.2" />
      <Property key="AlternativeId_Pid" value="ABB83822" />
      <Property key="AlternativeId_Uniprot" value="Q1WIQ6" />
      <Property key="Synonym_1" value="Aldehyde dehydrogenase family 11 member A3" />
      <Property key="Synonym_2" value="Glyceraldehyde-3-phosphate dehydrogenase [NADP(+)]" />
      <Property key="Synonym_3" value="Non-phosphorylating glyceraldehyde 3-phosphate dehydrogenase" />
      <Property key="Synonym_4" value="Triosephosphate dehydrogenase" />
      <Property key="Catalyzes" value="RXN-13705" />
      <Property key="Accession1" value="AT2G24270.2" />
      <Property key="Gene" value="AT2G24270" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
