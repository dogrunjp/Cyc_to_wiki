    </DataNode>
    <DataNode elementId="AT3G26650-MONOMER" textLabel="Glyceraldehyde-3-phosphate dehydrogenase GAPA1, chloroplastic" type="Protein" groupRef="CPLXQT-49">
      <Xref identifier="P25856" dataSource="uniprot" />
      <Graphics centerX="855.0" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
