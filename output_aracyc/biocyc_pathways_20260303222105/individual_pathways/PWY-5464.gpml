      <Property key="AlternativeId_Uniprot" value="Q9ZP05" />
      <Property key="Synonym_1" value="Microbody NAD-dependent malate dehydrogenase" />
      <Property key="Synonym_2" value="mbNAD-MDH" />
      <Property key="Synonym_3" value="Peroxisomal NAD-dependent malate dehydrogenase 2" />
      <Property key="Synonym_4" value="pxNAD-MDH2" />
