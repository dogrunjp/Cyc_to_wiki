      <Property key="Synonym_2" value="mMDH1" />
      <Property key="Synonym_3" value="Mitochondrial NAD-dependent malate dehydrogenase 1" />
      <Property key="Synonym_4" value="mNAD-MDH 1" />
      <Property key="Synonym_5" value="mtNAD-MDH1" />
