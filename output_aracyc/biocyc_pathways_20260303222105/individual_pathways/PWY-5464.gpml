    <DataNode elementId="AT5G03290-MONOMER" textLabel="Isocitrate dehydrogenase [NAD] catalytic subunit 5, mitochondrial" type="Protein" groupRef="CPLXQT-51">
      <Xref identifier="AT5G03290-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="555.0" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The IDH-V gene is predicted to encode a catalytic subunit of the mitochondrially-localized NAD+-dependent isocitrate dehydrogenase |CITS:[17468208][14671022]|. &lt;i&gt;idhv&lt;/i&gt; mutants have reduced levels of NAD+-dependent isocitrate dehydrogenase activity |CITS: [17468208]|. In addition, IDH-V can functionally complement a yeast &lt;i&gt;idh1 idh 2&lt;/i&gt; NAD+-dependent isocitrate dehydrogenase mutant when co-expressed with an IDH regulatory subunit (|FRAME: AT4G35260|, |FRAME: AT2G17130|, or |FRAME: AT4G35650|) |CITS: [16527867]|.</Comment>
      <Property key="UniqueID" value="AT5G03290-MONOMER" />
      <Property key="Synonym_1" value="IDH-V" />
      <Property key="Synonym_2" value="Isocitric dehydrogenase 5" />
      <Property key="Synonym_3" value="NAD(+)-specific ICDH 5" />
      <Property key="Catalyzes" value="RXN-6877" />
      <Property key="GOTerms" value="GO:0005739" />
      <Property key="Accession1" value="AT5G03290.1" />
      <Property key="ComponentOf" value="CPLXQT-51" />
      <Property key="Gene" value="AT5G03290" />
      <Property key="^citations" value="14671022" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-MIT-PL" />
    </DataNode>
    <DataNode elementId="AT2G17130-MONOMER" textLabel="Isocitrate dehydrogenase [NAD] regulatory subunit 2, mitochondrial" type="Protein" groupRef="CPLXQT-51">
      <Xref identifier="AT2G17130-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="645.0" centerY="835" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The IDH-II gene is predicted to encode a regulatory subunit of the mitochondrially-localized NAD+-dependent isocitrate dehydrogenase |CITS: [LIN04][17468208][14671022]|. &lt;i&gt;idhii&lt;/i&gt; mutants have reduced levels of NAD+-dependent isocitrate dehydrogenase activity |CITS: [LIN04][17468208]|. In addition, IDH-II can functionally complement a yeast &lt;i&gt;idh1 idh 2&lt;/i&gt; NAD+-dependent isocitrate dehydrogenase mutant when co-expressed with an IDH catalytic subunit (|FRAME: AT5G03290| or |FRAME: AT3G09810|) |CITS: [16527867]|.</Comment>
      <Property key="UniqueID" value="AT2G17130-MONOMER" />
      <Property key="Synonym_1" value="IDH-II" />
