      <Property key="Pathways" value="PWY66-385, PWY0-1608, PWY-8363, PWY-3841, PWY-181, GLYSYN-PWY, GLYSYN2-PWY, PWY-2161" />
      <Property key="PathwayCount" value="8" />
      <Property key="ReactionEquation" value="GLY + METHYLENE-THF-GLU-N + WATER &lt;=&gt; SER + THF-GLU-N" />
      <Property key="ReactionDirection" value="REVERSIBLE" />
