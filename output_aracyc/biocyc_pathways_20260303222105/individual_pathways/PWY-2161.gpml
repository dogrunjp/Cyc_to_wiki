    <DataNode elementId="AT4G13890.2" textLabel="AT4G13890.2" type="Protein">
      <Xref identifier="AT4G13890.2" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="555" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
