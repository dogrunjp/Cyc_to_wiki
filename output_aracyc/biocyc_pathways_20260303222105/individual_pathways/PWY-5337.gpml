    <DataNode elementId="AT5G40390-MONOMER" textLabel="Probable galactinol--sucrose galactosyltransferase 5" type="Protein">
      <Xref identifier="Q9FND9" dataSource="uniprot" />
      <Graphics centerX="600" centerY="475" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">This protein has sequence similarities with other raffinose synthases (EC 3.4.1.82), however a mutant with a T-DNA insertion in the gene coding for this protein was shown to have its levels of verbascose decreased (along with mannitol and sucrose) whereas raffinose and stachyose levels were normal. This observation led the authors to speculate that the enzyme might, in fact, catalyze the formation of verbascose |CITS:[anderson01]|.</Comment>
      <Property key="UniqueID" value="AT5G40390-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT5G40390.1" />
      <Property key="AlternativeId_Uniprot" value="Q9FND9" />
      <Property key="Synonym_1" value="SEED IMBIBITION 1-LIKE" />
      <Property key="Synonym_2" value="Raffinose synthase 5" />
      <Property key="Catalyzes" value="RXN-70, RXN-56" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT5G40390.1" />
