    <DataNode elementId="AT2G05830-MONOMER" textLabel="Methylthioribose-1-phosphate isomerase" type="Protein">
      <Xref identifier="Q9ZUG4" dataSource="uniprot" />
      <Graphics centerX="300" centerY="695" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The MTI1 enzyme in |FRAME: ORG-5993 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; col| participates in methioine recycling and salvage pathways. Like other enzymes that catalyze this isomerization reaction, MTI1 was originally predicted to be a eukaryotic translation initiation factor eIF-2B family protein. But, functional complementation of a yeast strain deficient in 5-methylthioribose-1-phosphate isomerase actvity demonstrates that MTI1 is capable of catalyzing this reaction (|FRAME: 5.3.1.23-RXN 5.3.1.23|) |CITS: [21540433]|.</Comment>
      <Property key="UniqueID" value="AT2G05830-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G05830.1" />
      <Property key="AlternativeId_Uniprot" value="Q9ZUG4" />
      <Property key="Synonym_1" value="M1Pi" />
      <Property key="Synonym_2" value="MTR-1-P isomerase" />
      <Property key="Synonym_3" value="S-methyl-5-thioribose-1-phosphate isomerase" />
      <Property key="Synonym_4" value="Translation initiation factor eIF-2B subunit alpha/beta/delta-like protein" />
      <Property key="Catalyzes" value="RXN-13272" />
      <Property key="Accession1" value="AT2G05830.1" />
      <Property key="Gene" value="AT2G05830" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_21540433" />
    </DataNode>
