    <DataNode elementId="AT5G53850-MONOMER" textLabel="dehydratase-enolase-phosphatase" type="Protein">
      <Xref identifier="AT5G53850-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="750" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup, PMN, dreher">DEP1 is a multifunctional enzyme in |FRAME: ORG-5993 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; col|. Based on functional complementation experiments, it appears to carry out three separate reactions that are catalyzed by a total of two or three individual proteins in other species |CITS: [21540433]|. This is supported by sequence analyses that show that the N-terminal portion of the protein has similarity to known methylthioribulose-1-phosphate dehydratases (|FRAME: R145-RXN 4.2.1.109|) whereas the C-terminal portion of DPE1 resembles the enolase/phosphatases (|FRAME: R82-RXN 5.3.2.5| / |FRAME: R83-RXN 3.1.3.87|) identified in other species |CITS: [21540433]|.</Comment>
      <Property key="UniqueID" value="AT5G53850-MONOMER" />
      <Property key="Synonym_1" value="dehydratase-enolase-phosphatase complex 1" />
      <Property key="Catalyzes" value="RXN-21714, RXN-21713, RXN-21712" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT5G53850.5" />
      <Property key="Gene" value="AT5G53850" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightKd" value="56.5" />
      <Property key="MolecularWeightSeq" value="56.5" />
      <Property key="Species" value="ORG-5993" />
      <CitationRef elementRef="citation_PUB_21540433" />
    </DataNode>
