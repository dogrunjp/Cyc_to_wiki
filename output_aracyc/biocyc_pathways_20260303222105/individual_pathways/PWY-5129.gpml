    <DataNode elementId="CPD3DJ-82" textLabel="a dihydroceramide" type="Metabolite">
      <Xref identifier="16755624" dataSource="PubChem-compound" />
      <Graphics centerX="350" centerY="820" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang">|FRAME: Ceramides &quot;A ceramide&quot;| is a lipid molecule that is composed of the sphingoid base |FRAME: SPHINGOSINE| and |FRAME: Fatty-Acids|. |FRAME: CPD3DJ-82 &quot;A dihydroceramide&quot;| is composed of the sphingoid base |FRAME: CPD-13612| (where the double bond in the |FRAME: SPHINGOSINE| tail has been reduced) and a fatty acid. |FRAME: CPD3DJ-82 &quot;Dihydroceramides&quot;| are also known as &quot;plant ceramide (I)&quot;.</Comment>
      <Property key="UniqueID" value="CPD3DJ-82" />
      <Property key="AlternativeId_ReactomeCpd" value="428126" />
