      <CitationRef elementRef="citation_PUB_17894783" />
      <CitationRef elementRef="citation_PUB_20202167" />
    </DataNode>
    <DataNode elementId="AT3G58740-MONOMER" textLabel="Citrate synthase 1, peroxisomal" type="Protein">
