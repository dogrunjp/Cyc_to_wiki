      <Property key="Synonym_2" value="All-trans-nonaprenyl-diphosphate synthase 2" />
      <Property key="Synonym_3" value="geranylgeranyl-diphosphate specific)" />
      <Property key="Catalyzes" value="RXN-12898, RXN-12897, RXN-12896, RXN-12895, RXN-12894, RXN-17876, RXN-ARA-232, RXN-9618" />
