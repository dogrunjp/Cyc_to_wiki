    <DataNode elementId="AT3G07270-MONOMER" textLabel="GTP cyclohydrolase I" type="Protein" groupRef="AT3G07270-CPLX">
      <Xref identifier="Q9SFV7" dataSource="uniprot" />
      <Graphics centerX="150.0" centerY="275" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
