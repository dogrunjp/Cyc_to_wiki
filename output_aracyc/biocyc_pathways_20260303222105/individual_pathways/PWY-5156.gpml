    <DataNode elementId="AT1G35290-MONOMER" textLabel="acyl-lipid thioesterase 1" type="Protein">
      <Xref identifier="Q9C715" dataSource="uniprot" />
      <Graphics centerX="750" centerY="755" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
