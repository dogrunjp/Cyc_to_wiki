    <DataNode elementId="AT2G22570-MONOMER" textLabel="Nicotinamidase 1" type="Protein">
      <Xref identifier="AT2G22570-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="455" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA encoding nicotinamidase has been identified and characterized from &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. The molecular function of converting nicotinamide to nicotinic acid under release of ammonia has been confirmed by recombinant expression of the protein in &lt;i&gt;E. coli&lt;/i&gt;. In addition, the involvement of the enzyme in the pyridine nucleotide salvage pathway was demonstrated in a nicotinamidase deficient mutant (nic1-1) which was unable to convert nicotinamide and had lower levels of NAD and NADP under normal growth conditions. The mutant was oversensitive towards abscisic acid (ABA) indicating a connection between NAD biosynthesis and pyridine nucleotide salvage pathway through the corresponding signaling pathway |CITS: [17335512]|.</Comment>
      <Property key="UniqueID" value="AT2G22570-MONOMER" />
      <Property key="Synonym_1" value="AtNIC1" />
      <Property key="Synonym_2" value="Nicotinamide deamidase 1" />
      <Property key="Catalyzes" value="RXN-9532" />
      <Property key="Accession1" value="AT2G22570.1" />
      <Property key="Gene" value="AT2G22570" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Species" value="ARA" />
      <CitationRef elementRef="citation_PUB_17335512" />
    </DataNode>
