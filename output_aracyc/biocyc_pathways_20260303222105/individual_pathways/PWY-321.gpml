    <DataNode elementId="AT1G69500-MONOMER" textLabel="AT1G69500-MONOMER" type="Protein">
      <Xref identifier="Q8GWJ5" dataSource="uniprot" />
      <Graphics centerX="300" centerY="635" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="THE-ARABIDOPSIS-INFORMATION-RESOURCE, zhang">The cDNA of |FRAME: AT1G69500 CYP704B1| was expressed in yeast cells. The enzyme activity was demonstrated in an &lt;i&gt;in vitro&lt;/i&gt; enzyme assay, where |FRAME: PALMITATE palmitate| was transformed to |FRAME: 16-HYDROXYPALMITATE 16-hydroxypalmitate|. In addition to |FRAME: PALMITATE palmitate|, |FRAME: AT1G69500 CYP704B1| also acted on |FRAME: OLEATE-CPD oleate|, |FRAME: LINOLEIC_ACID linoleate|, |FRAME: LINOLENIC_ACID &amp;alpha;-linolenate| and |FRAME: CPD-10514 9,10-epoxystearate|. Laurate was a poor substrate. Phenolics such as cinnamate, p-coumarate, ferulate, sinapate and p-coumaroyl shikimate were not metabolized |CITS: [19700560]|. |FRAME: AT1G69500 CYP704B1| had an anther-specific expression pattern and is highly coexpressed with CYP703A2, an in-chain fatty acid hydroxylase also involved in exine biosynthesis. CYP704B1 mutant plants have impaired pollen walls that lack a normal exine layer |CITS: [19700560]|.</Comment>
      <Property key="UniqueID" value="AT1G69500-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G69500.1" />
      <Property key="AlternativeId_Prints" value="PR00385" />
      <Property key="AlternativeId_Interpro" value="IPR002401" />
      <Property key="AlternativeId_Pfam" value="PF00067" />
      <Property key="AlternativeId_Smr" value="Q9C788" />
      <Property key="AlternativeId_Pride" value="Q9C788" />
      <Property key="AlternativeId_Uniprot" value="Q8GWJ5" />
      <Property key="Synonym_1" value="CYP704B1" />
      <Property key="Catalyzes" value="RXN-33656, RXN-23601, RXN-23602, RXN-23603, RXN-18793" />
      <Property key="CatalyzesCount" value="5" />
      <Property key="Accession1" value="AT1G69500.1" />
      <Property key="EnzymeNotUsedIn" value="PWY-1121" />
      <Property key="Gene" value="AT1G69500" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_19700560" />
    </DataNode>
