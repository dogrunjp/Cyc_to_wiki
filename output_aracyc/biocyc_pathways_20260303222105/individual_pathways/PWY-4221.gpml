    <DataNode elementId="AT1G12350-MONOMER" textLabel="AT1G12350-MONOMER" type="Protein">
      <Xref identifier="Q8GXR5" dataSource="uniprot" />
      <Graphics centerX="150" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The cDNA encoding the phosphopantothenoylcysteine synthetase (PPC synthetase) was isolated from &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; and recombinantly expressed in &lt;i&gt;E. coli&lt;/i&gt;. The molecular function was shown to add cysteine forming (R)-4&apos;-phospho-N-pantothenoylcysteine (PPC) |CITS: [12860978]|. This reaction is thought to be a key reaction because it forms the peptide bond between 4-phosphopantothenate and cysteine introducing (after decarboxylation) the reactive cysteamine residue of coenzyme A. Like the mammalian enzyme, and unlike the bacterial enzyme, the plant enzyme uses ATP to drive the reaction |CITS: [12860978]|.</Comment>
      <Property key="UniqueID" value="AT1G12350-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G12350.1" />
      <Property key="AlternativeId_Uniprot" value="Q8GXR5" />
      <Property key="AlternativeId_Pride" value="Q8GXR5" />
      <Property key="AlternativeId_Smr" value="Q8GXR5" />
      <Property key="AlternativeId_Pfam" value="PF04127" />
      <Property key="AlternativeId_Interpro" value="IPR035929" />
      <Property key="AlternativeId_Pid" value="BAC42714" />
      <Property key="Synonym_1" value="phosphopantothenate-cysteine ligase" />
      <Property key="Catalyzes" value="RXN-12674" />
      <Property key="Accession1" value="AT1G12350.1" />
      <Property key="Gene" value="AT1G12350" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_12860978" />
    </DataNode>
