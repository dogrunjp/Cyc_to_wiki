    <DataNode elementId="AT5G19550-MONOMER" textLabel="Aspartate aminotransferase, cytoplasmic isozyme 1" type="Protein">
      <Xref identifier="AT5G19550-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="450" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Two genes, ASP2 and ASP4, encode cytosolic aspartate aminotransferase (AAT). ASP2 encodes the major cytosolic isoform. ASP2 mutants have less than 6% cytosolic AAT activity. One of the ASP2 mutants, aat2-2, shows a reduction of aspartate level in light-grown plants, and a reduction of aspartate-derived asparagine level in dark-grown plants. It supports the model that ASP2 is responsible for synthesizing the bulk of aspartate in the light, which supplies the precursor for asparagine synthesis in the dark. In addition, the aat2-2 mutant has a dramatic decrease in aspartate and asparagine levels in siliques, indicating it is also responsible for aspartate and asparagine synthesis for seed storage.</Comment>
      <Property key="UniqueID" value="AT5G19550-MONOMER" />
      <Property key="Synonym_1" value="Transaminase A" />
      <Property key="Catalyzes" value="RXN-6793" />
      <Property key="GOTerms" value="GO:0005829" />
      <Property key="Accession1" value="AT5G19550.1" />
      <Property key="Gene" value="AT5G19550" />
      <Property key="^citations" value="12068109" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCI-CYTOSOL-PL" />
