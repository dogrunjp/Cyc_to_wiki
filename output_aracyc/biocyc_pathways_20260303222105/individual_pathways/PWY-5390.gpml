    <DataNode elementId="AT3G21750-MONOMER" textLabel="UDP-glycosyltransferase 71B1" type="Protein">
      <Xref identifier="Q9LSY9" dataSource="uniprot" />
      <Graphics centerX="450" centerY="755" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">UGT71B1 is a glucosyltransferase that can attach glucose to a number of hydroxylated phenolic compounds |CITS: [11641410]| as well as quercetins |CITS: [15352060 ]| &lt;i&gt;in vitro&lt;/i&gt;. To date, the subcellular location of this protein has not been identified and its biological role has not been established &lt;i&gt;in vivo&lt;/i&gt;. Nevertheless, its &lt;i&gt;in vitro&lt;/i&gt; ability to target |FRAME: CPD-633 gentisate|, a derivative of |FRAME: CPD-110 salicylate|, as well |FRAME: CPD-520 quercetin| indicates that it could potentially play a role in plant defense |CITS: [11641410][15352060]|.</Comment>
      <Property key="UniqueID" value="AT3G21750-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G21750.1" />
      <Property key="AlternativeId_Uniprot" value="Q9LSY9" />
      <Property key="Synonym_1" value="Flavonol 3-O-glucosyltransferase UGT71B1" />
      <Property key="Catalyzes" value="RXN-33329, RXN-33328, RXN-18269, RXN-12559" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT3G21750.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT3G21750" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_11641410" />
    </DataNode>
    <DataNode elementId="AT2G36790-MONOMER" textLabel="UDP-glucose:flavonol-3-O-glycoside-7-O-glucosyltransferase" type="Protein">
      <Xref identifier="AT2G36790-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="600" centerY="755" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">Using a functional genomics approach to identify candidate genes in mutant lines of Arabidopsis lacking the commonly found flavonol-3-&lt;i&gt;O&lt;/i&gt;-rhamnoside-7-&lt;i&gt;O&lt;/i&gt;-rhamnosides, the cDNA encoding UDP-glucose:flavonol-3-&lt;i&gt;O&lt;/i&gt;-glycoside-7-&lt;i&gt;O&lt;/i&gt;-glucosyltransferase (UGT73C6) was isolated from &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;. Its molecular function of attaching a glucosyl residue to the 7-&lt;i&gt;O&lt;/i&gt;-position of the flavonols kaempferol, quercetin and their 3-&lt;i&gt;O&lt;/i&gt;-glycoside derivatives was confirmed by expressing and characterizing the recombinant protein in &lt;i&gt;E. coli&lt;/i&gt;. UGT73C6 expressed a 10 time higher specific activity towards kaempferol/quercetin 3-&lt;i&gt;O&lt;/i&gt;-rhamnoside in comparison to the corresponding aglycones. The glycosylation pattern obtained from UGT78D1 mutants and the preference of the 7-&lt;i&gt;O&lt;/i&gt;-glucosyltransferase (UGT73C6) for glycosides indicates that the 7-&lt;i&gt;O&lt;/i&gt;-glucosylation is the second step in forming the predominant flavonol diglycosides (flavonol 3-&lt;i&gt;O&lt;/i&gt;-rhamnoside-7-&lt;i&gt;O&lt;/i&gt;-rhamnoside, flavonol 3-&lt;i&gt;O&lt;/i&gt;-rhamnoside-7-&lt;i&gt;O&lt;/i&gt;-glucoside) present in Arabidopsis|CITS: [12900416]|.</Comment>
      <Property key="UniqueID" value="AT2G36790-MONOMER" />
      <Property key="Catalyzes" value="RXN-33744, RXN-33743, RXN-12578, RXN-12557, RXN-15423, RXN-15425, RXN-15430, RXN-15444, RXN-15450, RXN-15436, RXN-13122, RXN-13120" />
      <Property key="CatalyzesCount" value="12" />
      <Property key="Accession1" value="AT2G36790.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT2G36790" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="80." />
      <Property key="MolecularWeightKd" value="80." />
      <CitationRef elementRef="citation_PUB_12900416" />
    </DataNode>
