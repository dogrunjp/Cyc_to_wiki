    <DataNode elementId="AT2G29740-MONOMER" textLabel="UDP-glycosyltransferase 71C2" type="Protein">
      <Xref identifier="AT2G29740-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="900" centerY="595" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
