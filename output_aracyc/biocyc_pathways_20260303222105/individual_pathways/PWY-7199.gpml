    <DataNode elementId="AT3G07800-MONOMER" textLabel="Thymidine kinase a" type="Protein">
      <Xref identifier="Q9S750" dataSource="uniprot" />
      <Graphics centerX="750" centerY="775" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The |FRAME: TAX-3702 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;| genome contains two genes predicted to encode an enzyme similar to the |FRAME: CPLX66-354 mammalian cytosolic thymidine kinase&quot;|, |FRAME: AT3G07800 TK1a| and |FRAME: AT5G23070 TK1b|. The amino acid identity between the two proteins is 62%, and the N-terminal of the TK1b protein is extended and contains a putative organelle localization signal. T-DNA insertion lines of |FRAME: AT3G07800 TK1a| and |FRAME: AT5G23070 TK1b| mutant genes had normal growth, but double mutants died at an early stage, indicating that the genes encode proteins that catalyze redundant reactions |CITS: [22897443]|. The two genes were subcloned as glutathione Stransferase-fusions, over-expressed in |FRAME:TAX-562 &lt;i&gt;Escherichia coli&lt;/i&gt;| and purified. The two enzymes have the same substrate specificity, and phosphorylated |FRAME: DEOXYURIDINE 2&apos;-deoxyuridine|, |FRAME: THYMIDINE thymidine| and the antiviral drug |FRAME: CPD-15110 3&apos;-azido-3&apos;-deoxythymidine| |CITS: [22897443]|.</Comment>
      <Property key="UniqueID" value="AT3G07800-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G07800.1" />
      <Property key="AlternativeId_Phylomedb" value="Q9S750" />
      <Property key="AlternativeId_Prosite" value="PS00603" />
      <Property key="AlternativeId_Panther" value="PTHR11441" />
      <Property key="AlternativeId_Smr" value="Q9S750" />
      <Property key="AlternativeId_Pfam" value="PF00265" />
      <Property key="AlternativeId_Interpro" value="IPR027417" />
      <Property key="AlternativeId_Mint" value="MINT-8411755" />
      <Property key="AlternativeId_Pride" value="Q9S750" />
      <Property key="AlternativeId_Uniprot" value="Q9S750" />
      <Property key="Synonym_1" value="AtTK1a" />
      <Property key="Catalyzes" value="RXN-33783, RXN-16912" />
