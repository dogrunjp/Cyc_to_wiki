    <DataNode elementId="AT1G72040-MONOMER" textLabel="phosphotransferase, alcohol group as acceptor" type="Protein">
      <Xref identifier="Q501D4" dataSource="uniprot" />
      <Graphics centerX="600" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The |FRAME: TAX-3702 &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;| genome contains a gene (|FRAME: AT1G72040 DNK|) predicted to encode an enzyme similar to the mammalian |FRAME: CPLX-8618 deoxycytidine kinase| (|FRAME: HS08100 DCK|) and the mitochondrial thymidine kinase (|FRAME: HS09420 TK2|). Sequence analysis suggests that this plant enzyme could be a &quot;living fossil&quot; resembling the progenitor of several related mammalian enzymes. The gene was cloned and overexpressed in |FRAME:TAX-562 &lt;i&gt;Escherichia coli&lt;/i&gt;|, and the recombinant protein was purified. While the enzyme could not phosphorylate |FRAME: THYMIDINE thymidine|, it could phosphorylate |FRAME: DEOXYADENOSINE 2&apos;-deoxyadenosine|, |FRAME: DEOXYGUANOSINE 2&apos;-deoxyguanosine|, |FRAME: DEOXYCYTIDINE 2&apos;-deoxycytidine|, and |FRAME: DEOXYURIDINE 2&apos;-deoxyuridine|. The enzyme has a substrate range almost as broad as the insect |FRAME: MONOMER-17889 deoxynucleoside kinase| (|FRAME: EC-2.7.1.145 &quot;EC 2.7.1.145&quot;|) |CITS: [18776467]|. In a subsequent study the recombinant enzyme was characterized for its kinetic parameters. It was shown that the Km for |FRAME: DEOXYURIDINE 2&apos;-deoxyuridine| was much higher (561 &amp;mu;M) than for the other three substrates (Kms in the range 14-26 &amp;mu;M) |CITS: [22897443]|.</Comment>
      <Property key="UniqueID" value="AT1G72040-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT1G72040.1" />
      <Property key="AlternativeId_Phylomedb" value="Q501D4" />
      <Property key="AlternativeId_Panther" value="PTHR10513" />
      <Property key="AlternativeId_Pride" value="Q501D4" />
      <Property key="AlternativeId_Smr" value="Q501D4" />
      <Property key="AlternativeId_Pfam" value="PF01712" />
      <Property key="AlternativeId_Interpro" value="IPR031314" />
      <Property key="AlternativeId_Uniprot" value="Q501D4" />
      <Property key="Catalyzes" value="RXN-33662, RXN-17616, RXN-21359, RXN-21362, RXN-21358" />
      <Property key="CatalyzesCount" value="5" />
      <Property key="Accession1" value="AT1G72040.1" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="AT1G72040" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_18776467" />
      <CitationRef elementRef="citation_PUB_22897443" />
    </DataNode>
