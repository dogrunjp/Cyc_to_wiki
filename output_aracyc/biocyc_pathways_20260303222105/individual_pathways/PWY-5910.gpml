    <DataNode elementId="AT2G23800-MONOMER" textLabel="Heterodimeric geranylgeranyl pyrophosphate synthase large subunit 2" type="Protein">
      <Xref identifier="O04046" dataSource="uniprot" />
      <Graphics centerX="450" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;GGPS2&lt;/i&gt; when expressed in recombinant &lt;i&gt;E.coli&lt;/i&gt; was shown to encode for a protein catalyzing the condensation of farnesyl pyrophosphate (FPP) and isopentenyl pyrophosphate (IPP) to produce geranylgeranyl diphosphate (GGPP) |CITS:[9150607]|. In the same study, &lt;i&gt;Arabidopsis GGPS2&lt;/i&gt; was expressed in a strain of &lt;i&gt;E.coli&lt;/i&gt; containing all the metabolic &lt;i&gt;E. uredovora&lt;/i&gt; genes required for the biosynthesis of carotenoids from GGPP. This systems uses a visible screen (yellow color) to determine the expression of a protein with geranylgeranyl pyrophosphate synthase activity such as AtGGPS2 |CITS:[9150607]|. &lt;i&gt;In planta&lt;/i&gt;, the protein was shown to be localized in the endoplasmic reticulum of epidermal cells and leaf guard cells, most likely in its membrane |CITS:[10759500]|.</Comment>
      <Property key="UniqueID" value="AT2G23800-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G23800.1" />
      <Property key="AlternativeId_Pid" value="NP_179960" />
      <Property key="AlternativeId_Uniprot" value="O04046" />
      <Property key="Synonym_1" value="GGPP synthase 2" />
      <Property key="Synonym_2" value="GGPS2" />
      <Property key="Synonym_3" value="(2E,6E)-farnesyl diphosphate synthase 2" />
      <Property key="Synonym_4" value="Dimethylallyltranstransferase 2" />
      <Property key="Synonym_5" value="Farnesyl diphosphate synthase 2" />
      <Property key="Synonym_6" value="Farnesyltranstransferase 2" />
      <Property key="Synonym_7" value="Geranyltranstransferase 2" />
      <Property key="Catalyzes" value="RXN-33251, RXN-33250, RXN-12012" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT2G23800.1" />
      <Property key="Gene" value="AT2G23800" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_10759500" />
      <CitationRef elementRef="citation_PUB_9150607" />
    </DataNode>
    <DataNode elementId="AT2G34630-MONOMER" textLabel="dimethylallyltranstransferase" type="Protein">
      <Xref identifier="O64684" dataSource="uniprot" />
      <Graphics centerX="600" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; protein encoded by the &lt;i&gt;GPPS&lt;/i&gt; gene was expressed in &lt;i&gt;E. coli&lt;/i&gt;. Extracts of the bacteria recombinantly expressing the heterologous protein were shown to catalyze the condensation of DMAPP and IPP into GPP |CITS:[11069698]|. The protein fused to the reporter GFP was shown to localize in the chloroplasts of &lt;i&gt;Arabidopsis&lt;/i&gt; leaves. The enzyme was not able to accept any other allylic diphosphate substrates (GPP, FPP, GGPP) for prenyl condensation |CITS:[11069698]|.</Comment>
      <Property key="UniqueID" value="AT2G34630-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT2G34630.2" />
      <Property key="AlternativeId_Uniprot" value="O64684" />
      <Property key="AlternativeId_Pid" value="NP_850234" />
