      <CitationRef elementRef="citation_PUB_18303110" />
    </DataNode>
    <DataNode elementId="AT4G36810-MONOMER" textLabel="Heterodimeric geranylgeranyl pyrophosphate synthase large subunit 1, chloroplastic" type="Protein">
      <Xref identifier="P34802" dataSource="uniprot" />
      <Graphics centerX="150" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; gene &lt;i&gt;GGPS1&lt;/i&gt; when expressed in recombinant &lt;i&gt;E.coli&lt;/i&gt; was shown to encode for a protein catalyzing the condensation of farnesyl pyrophosphate (FPP) and isopentenyl pyrophosphate (IPP) to produce geranylgeranyl diphosphate (GGPP) |CITS:[10759500]|. &lt;i&gt;In planta&lt;/i&gt;, the protein was shown to be localized in the chloroplasts of epidermal cells and leaf guard cells, and in the etioplasts of roots |CITS:[10759500]|.</Comment>
      <Property key="UniqueID" value="AT4G36810-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G36810.1" />
      <Property key="AlternativeId_Pid" value="NP_195399" />
      <Property key="AlternativeId_Uniprot" value="P34802" />
      <Property key="Synonym_1" value="GGPP synthase 1" />
      <Property key="Synonym_2" value="GGPS1" />
      <Property key="Synonym_3" value="(2E,6E)-farnesyl diphosphate synthase 1" />
      <Property key="Synonym_4" value="Dimethylallyltranstransferase 1" />
      <Property key="Synonym_5" value="Farnesyl diphosphate synthase 1" />
      <Property key="Synonym_6" value="Farnesyltranstransferase 1" />
      <Property key="Synonym_7" value="Geranyltranstransferase 1" />
      <Property key="Catalyzes" value="RXN-33464, RXN-33463, RXN-12011" />
      <Property key="CatalyzesCount" value="3" />
      <Property key="Accession1" value="AT4G36810.1" />
      <Property key="Gene" value="AT4G36810" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="MolecularWeightExp" value="34." />
      <Property key="MolecularWeightKd" value="34." />
      <CitationRef elementRef="citation_PUB_10759500" />
      <CitationRef elementRef="citation_PUB_8016276" />
    </DataNode>
    <DataNode elementId="AT1G31910.2" textLabel="AT1G31910.2" type="Protein">
      <Xref identifier="AT1G31910.2" dataSource="plantcyc" />
      <Graphics centerX="300" centerY="535" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
