    </DataNode>
    <DataNode elementId="AT4G11820-MONOMER" textLabel="AT4G11820-MONOMER" type="Protein">
      <Xref identifier="P54873" dataSource="uniprot" />
      <Graphics centerX="300" centerY="695" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;Arabidopsis thaliana BAP1&lt;/i&gt; gene was heterologously expressed in the &lt;i&gt;Saccharomyces cerevisiae erg11&lt;/i&gt; (deficient in hydroxymethylglutaryl-CoA synthase (HMGS) activity) and &lt;i&gt;erg10&lt;/i&gt; (deficient in acetyl-CoA C-acetyltransferase (AACT) activity). The &lt;i&gt;Arabidopsis&lt;/i&gt; gene was only able to complement the &lt;i&gt;erg11&lt;/i&gt; mutation and is therefore thought to only have HMGS activity |CITS:[8566777]|, although it had been previously postulated that in plants both reactions were catalyzed by a single enzyme |CITS:[8123686]| |CITS: [1685759]|. The isolation and characterization of hydroxymethylglutaryl-CoA synthase from &lt;i&gt;Brassica juncea&lt;/i&gt; demonstrates that the two consecutive steps are carried out by two independent proteins |CITS: [15233626]|.</Comment>
      <Property key="UniqueID" value="AT4G11820-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT4G11820.2" />
      <Property key="AlternativeId_Pid" value="CAA58763" />
      <Property key="AlternativeId_Uniprot" value="P54873" />
      <Property key="Catalyzes" value="RXN-12482" />
      <Property key="Accession1" value="AT4G11820.2" />
      <Property key="Gene" value="AT4G11820" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_8566777" />
      <CitationRef elementRef="citation_PUB_1685759" />
      <CitationRef elementRef="citation_PUB_8123686" />
