      <Property key="Synonym_2" value="GPP synthase" />
      <Property key="Catalyzes" value="RXN-33278, RXN-12514" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="AT2G34630.2" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
