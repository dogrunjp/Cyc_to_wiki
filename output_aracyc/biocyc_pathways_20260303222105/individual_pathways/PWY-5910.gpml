      <Property key="Synonym_1" value="farnesyltranstransferase" />
      <Property key="Synonym_2" value="ATGGPS3" />
      <Property key="Catalyzes" value="RXN-33317, RXN-33316, RXN-33315, RXN-12018" />
      <Property key="CatalyzesCount" value="4" />
      <Property key="Accession1" value="AT3G14550.1" />
