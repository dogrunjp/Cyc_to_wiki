    <DataNode elementId="AT3G53130-MONOMER" textLabel="AT3G53130-MONOMER" type="Protein">
      <Xref identifier="Q6TBX7" dataSource="uniprot" />
      <Graphics centerX="450" centerY="335" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">A number of &lt;i&gt;Arabidopsis thaliana&lt;/i&gt; mutants affected in the &lt;i&gt;LUT1&lt;/i&gt; gene were shown to be defective in the production of lutein from zeinoxanthin, indicating that the enzyme encoded by this gene possesses &amp;epsilon;-hydroxylase activity |CITS:[14709673],[8837513]|. The enzyme has not been purified and characterized.</Comment>
      <Property key="UniqueID" value="AT3G53130-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G53130.1" />
      <Property key="AlternativeId_Pid" value="NP_190881" />
      <Property key="AlternativeId_Uniprot" value="Q6TBX7" />
      <Property key="AlternativeId_Swissmodel" value="Q6TBX7" />
      <Property key="AlternativeId_Modbase" value="Q6TBX7" />
