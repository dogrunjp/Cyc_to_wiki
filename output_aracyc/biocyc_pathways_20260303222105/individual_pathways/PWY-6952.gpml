    <DataNode elementId="AT3G10370-MONOMER" textLabel="glycerol-3-phosphate dehydrogenase" type="Protein">
      <Xref identifier="Q9SS48" dataSource="uniprot" />
      <Graphics centerX="600" centerY="475" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">SDP6 is a mitochondrial form of glycerol-3-phosphate dehydrogenase that is used to oxidize glycerol-3-phosphate to DHAP and to use the electrons to reduce the mitochondrial ubiquinone pool. The highest gene expression was detected in germinating seeds consistent with its role in storage lipid catabolism and glycerol dissimilation.</Comment>
      <Property key="UniqueID" value="AT3G10370-MONOMER" />
      <Property key="AlternativeId_Araport" value="AT3G10370.1" />
      <Property key="AlternativeId_Uniprot" value="Q9SS48" />
      <Property key="Catalyzes" value="RXN-33787, RXN-33786, RXN-10512, RXN-10502, RXN-7378, RXN-5433" />
