    <DataNode elementId="Glycerolipid-vernolate" textLabel="a [glycerolipid]-vernolate" type="Metabolite">
      <Xref identifier="MNXM148749" dataSource="MetaNetX" />
      <Graphics centerX="204.140380859375" centerY="593.3756713867188" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang, SRI, caspi">|FRAME: Vernolates Vernolate| (vernolic acid) is a fatty acid with an 18-carbon chain that contains a &lt;i&gt;cis&lt;/i&gt; double bond at position 9 and an epoxy group at positions 12-13. Like other fatty acids, |FRAME: Vernolates| is rarely found in its free form. It is usually found |FRAME: Glycerolipid-vernolate &quot;incorporated into a lipid&quot;|.</Comment>
      <Property key="UniqueID" value="Glycerolipid-vernolate" />
      <Property key="AlternativeId_Metanetx" value="MNXM148749" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NonStandardInchi" value="InChI=1S/C18H32O2/c1-2-3-11-14-17-18(20-17)15-12-9-7-5-4-6-8-10-13-16-19/h9,12,16-18H,2-8,10-11,13-15H2,1H3/b12-9-" />
      <Property key="Smiles" value="CCCCCC1(OC1C\C=C/CCCCCCCC(=O)[a glycerolipid])" />
    </DataNode>
