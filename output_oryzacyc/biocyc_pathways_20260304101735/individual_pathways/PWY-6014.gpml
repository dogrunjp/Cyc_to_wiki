      <Property key="Synonym_3" value="a [glycerolipid]-9,12-linoleic acid" />
      <Property key="Synonym_4" value="a [glycerolipid]-9-cis,12-cis-octadecadienoate" />
      <Property key="Synonym_5" value="a linoleoyl-[glycerolipid]" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
