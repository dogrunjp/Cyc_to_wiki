    <DataNode elementId="CPD-463" textLabel="L-nicotianamine" type="Metabolite">
      <Xref identifier="KRGPXXHMOXVMMM-CIUDSAMLSA-N" dataSource="InChIKey" />
      <Graphics centerX="888.373291015625" centerY="873.42333984375" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, nilo-poyanco, SRI, caspi">Nicotianamine is an unusual amino acid that is ubiquitous throughout the plant kingdom. It is a chelator of several divalent transition metals, and is believed to be involved in the transport of heavy metals such as iron and manganese.</Comment>
      <Property key="UniqueID" value="CPD-463" />
      <Property key="AlternativeId_Seed" value="cpd03158" />
      <Property key="AlternativeId_Metanetx" value="MNXM2055" />
