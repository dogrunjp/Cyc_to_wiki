      <Graphics centerX="853.0275268554688" centerY="759.06396484375" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="xue, PMN, nilo-poyanco, brito">&apos;Heme&apos; is usually understood as any tetrapyrrolic chelate of iron. The terms &apos;ferroheme&apos; and &apos;ferriheme&apos; refer to the Fe(II) and Fe(III) oxidation states in heme (even though Fe(IV) is found as a catalytic intermediate in some systems). |FRAME: Heme-b &quot;Heme &lt;i&gt;b&lt;/i&gt;&quot;|, whose |FRAME: PROTOHEME &quot;ferrous form&quot;| is known as protoheme IX, is the immediate product of the heme biosynthesis pathways (by ferro-chelation of |FRAME: PROTOPORPHYRIN_IX|) and the most abundant heme form. It is found in common proteins such as hemoglobin and myoglobin. Heme &lt;i&gt;b&lt;/i&gt; is part of |FRAME: Cytochromes-B &quot;&lt;i&gt;b&lt;/i&gt;-type cytochromes&quot;|.</Comment>
      <Property key="UniqueID" value="PROTOHEME" />
      <Property key="AlternativeId_Metanetx" value="MNXM249" />
      <Property key="AlternativeId_Refmet" value="Heme" />
      <Property key="AlternativeId_Bigg" value="pheme" />
      <Property key="Synonym_1" value="protoheme IX" />
      <Property key="Synonym_2" value="ferroprotoporphyrin IX" />
      <Property key="Synonym_3" value="ferroheme &lt;i&gt;b&lt;/i&gt;" />
      <Property key="ChemicalFormula" value="(C 34) (H 30) (N 4) (O 4) (FE 1)" />
      <Property key="AtomCharges" value="(43 -2), (41 -1), (39 -1), (37 1), (36 1)" />
