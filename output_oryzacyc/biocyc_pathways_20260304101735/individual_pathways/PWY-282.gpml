    <DataNode elementId="LONG-CHAIN-KETONE" textLabel="a ketone" type="Metabolite">
      <Xref identifier="17087" dataSource="ChEBI" />
      <Graphics centerX="1080.492431640625" centerY="844.4578247070312" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="SRI, caspi">A ketone is a compound with the structure RC(=O)R&apos;, where R and R&apos; can be a variety of atoms and groups of atoms. It features a carbonyl group (C=O) bonded to two other carbon atoms. Ketones differ from |FRAME: Aldehydes aldehydes| in that the carbonyl is placed between two carbons rather than at the end of a carbon skeleton.</Comment>
      <Property key="UniqueID" value="LONG-CHAIN-KETONE" />
      <Property key="AlternativeId_Metanetx" value="MNXM839" />
      <Property key="AlternativeId_Chebi" value="17087" />
