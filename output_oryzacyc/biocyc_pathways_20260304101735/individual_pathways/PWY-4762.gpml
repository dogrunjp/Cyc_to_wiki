      <Property key="Synonym_5" value="a diacyl-glycerol-3P" />
      <Property key="Synonym_6" value="a diacylglycerol-3-phosphate" />
      <Property key="Synonym_7" value="a phosphatidic acid" />
      <Property key="Synonym_8" value="an L-phosphatidate" />
