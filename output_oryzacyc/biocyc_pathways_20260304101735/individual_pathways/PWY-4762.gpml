      <Property key="AlternativeId_Chebi" value="16110" />
      <Property key="AlternativeId_Cas" value="8002-43-5" />
      <Property key="Synonym_1" value="a (3-&lt;i&gt;sn&lt;/i&gt;-phosphatidyl)choline" />
      <Property key="Synonym_2" value="a 1,2-diacyl-&lt;i&gt;sn&lt;/i&gt;-glycero-3-phosphocholine" />
      <Property key="Synonym_3" value="a choline phosphatide" />
      <Property key="Synonym_4" value="an L-alpha-phosphatidylcholine" />
      <Property key="Synonym_5" value="lecithin" />
      <Property key="Synonym_6" value="a phosphatidyl-&lt;i&gt;N&lt;/i&gt;-trimethylethanolamine" />
      <Property key="AbbrevName" value="PC" />
      <Property key="AtomCharges" value="(15 -1), (11 1)" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NonStandardInchi" value="InChI=1S/C10H20NO8P/c1-11(2,3)4-5-18-20(14,15)19-7-10(17-9-13)6-16-8-12/h8-10H,4-7H2,1-3H3/t10-/m1/s1" />
