      <Property key="Synonym_3" value="1,2-dihydroxy-3-keto-5-methylthiopentene" />
      <Property key="Synonym_4" value="acireductone" />
      <Property key="Synonym_5" value="1,2-dihydroxy-5-(methylthio)pent-1-en-3-one" />
