      <CitationRef elementRef="citation_PUB_21175892" />
      <CitationRef elementRef="citation_PUB_SHIMURA07" />
    </DataNode>
    <DataNode elementId="DTC2-MONOMER" textLabel="DTC2-MONOMER" type="Protein">
      <Xref identifier="Q6BDZ9" dataSource="uniprot" />
      <Graphics centerX="824.8209228515625" centerY="706.6649169921875" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;OsDTC2&lt;/i&gt; gene isolated from &lt;i&gt;Oryza sativa&lt;/i&gt; encodes an stemar-13-ene synthase |CITS:[15280039]|. This recombinant enzyme expressed as a GST-fusion in &lt;i&gt;E.coli&lt;/i&gt; was shown to convert &lt;i&gt;syn&lt;/i&gt;-copalyl diphosphate into stemar-13-ene, a putative diterpene hydrocarbon precursor of the phytoalexin oryzalexin S. Stemar-13-ene was shown to accumulate in chitin-elicited rice cells and UV-irradiated rice leaves, in good accordance with the observed increase of &lt;i&gt;OsDTC2&lt;/i&gt; mRNA levels under those stress conditions |CITS:[15280039]|.</Comment>
      <Property key="UniqueID" value="DTC2-MONOMER" />
      <Property key="AlternativeId_Modbase" value="Q6BDZ9" />
      <Property key="AlternativeId_Swissmodel" value="Q6BDZ9" />
      <Property key="AlternativeId_Pid" value="BAD34478" />
      <Property key="AlternativeId_Uniprot" value="Q6BDZ9" />
      <Property key="Synonym_1" value="diterpene cyclase" />
      <Property key="Synonym_2" value="OsDTC2" />
      <Property key="Catalyzes" value="RXN-6601" />
      <Property key="GOTerms" value="GO:0009536" />
      <Property key="Gene" value="DTC2" />
      <Property key="^citations" value="15280039" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <Property key="Locations" value="CCO-PLASTID" />
      <CitationRef elementRef="citation_PUB_15280039" />
    </DataNode>
    <DataNode elementId="OS04T0180400-01" textLabel="Os04t0180400-01" type="Protein">
      <Xref identifier="OS04T0180400-01" dataSource="plantcyc" />
      <Graphics centerX="544.7575073242188" centerY="1163.6982421875" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
