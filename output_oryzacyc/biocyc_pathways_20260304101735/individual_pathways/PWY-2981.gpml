    <DataNode elementId="DTC1-MONOMER" textLabel="DTC1-MONOMER" type="Protein">
      <Xref identifier="Q852S2" dataSource="uniprot" />
      <Graphics centerX="1269.4351806640625" centerY="615.6831665039062" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;OsDTC1&lt;/i&gt; gene isolated from &lt;i&gt;Oryza sativa&lt;/i&gt; encodes an &lt;i&gt;ent&lt;/i&gt;-cassa-12,15-diene synthase |CITS:[14675427]|. This recombinant enzyme expressed as a GST-fusion in &lt;i&gt;E.coli&lt;/i&gt; was shown to convert &lt;i&gt;ent&lt;/i&gt;-copalyl diphosphate into &lt;i&gt;ent&lt;/i&gt;-cassa-12,15-diene, a putative diterpene hydrocarbon precursor of the phytoalexin (-)-phytocassanes.</Comment>
      <Property key="UniqueID" value="DTC1-MONOMER" />
      <Property key="AlternativeId_Phytozome" value="Os02t0570400-01" />
      <Property key="AlternativeId_Modbase" value="Q852S2" />
      <Property key="AlternativeId_Swissmodel" value="Q852S2" />
      <Property key="AlternativeId_Pid" value="BAC56714" />
      <Property key="AlternativeId_Uniprot" value="Q852S2" />
      <Property key="Synonym_1" value="diterpene cyclase" />
      <Property key="Synonym_2" value="OsDTC1" />
      <Property key="Catalyzes" value="RXN-N7F-69395, RXN-6602" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="GOTerms" value="GO:0009536" />
