    <DataNode elementId="GN7F-16055-MONOMER" textLabel="Os12t0491800-01" type="Protein">
      <Xref identifier="GN7F-16055-MONOMER" dataSource="plantcyc" />
      <Graphics centerX="1212.3406982421875" centerY="1445.950927734375" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The enzyme ent-sandaracopimaradiene synthase catalyzes the conversion of ent-copalyl diphosphate (ent-CDP) into ent-Sandaraco-primaradiene, an intermediate in the Oryzalexin A-F type of diterpene phytoalexin metabolism. Initially identified as a putative type-A diterpene cyclase gene, the &lt;i&gt;Oryza sativa&lt;/i&gt; gene &lt;i&gt;KS10&lt;/i&gt; was heterologously expressed and functionally characterized. The enzyme was shown to catalyze the cyclization of &lt;i&gt;ent&lt;/i&gt;-copalyl diphosphate (&lt;i&gt;ent&lt;/i&gt;-CDP) into &lt;i&gt;ent&lt;/i&gt;-sandaracopimaradiene primarily with minor traces of &lt;i&gt;ent&lt;/i&gt;-pimara-8(14),15-diene which, due to its low abundance, is unlikely to be a hydrocarbon precursor of well-characterized rice phytoalexins |CITS:[15388982]|. The enzyme did not catalyze the cyclization of &lt;i&gt;syn&lt;/i&gt;-CDP.</Comment>
      <Property key="UniqueID" value="GN7F-16055-MONOMER" />
      <Property key="Synonym_1" value="LOC_Os12g30824.1" />
      <Property key="Synonym_2" value="ent-sandaracopimaradiene synthase" />
      <Property key="Catalyzes" value="RXN-N7F-32001, RXN-4KF-1969" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="Os12t0491800-01" />
      <Property key="FunctionalAssignmentStatus" value=":PROBABLE-ENZYME" />
      <Property key="Gene" value="GN7F-16055" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_SHIMURA07" />
      <CitationRef elementRef="citation_PUB_KANNO06" />
      <CitationRef elementRef="citation_PUB_OTOMO04" />
      <CitationRef elementRef="citation_PUB_15388982" />
    </DataNode>
