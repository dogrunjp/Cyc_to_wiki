    </DataNode>
    <DataNode elementId="CYC2-MONOMER" textLabel="CYC2-MONOMER" type="Protein">
      <Xref identifier="Q68CL9" dataSource="uniprot" />
      <Graphics centerX="1284.037109375" centerY="1029.152587890625" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="pmngroup">The &lt;i&gt;OsCyc2&lt;/i&gt; gene isolated from &lt;i&gt;Oryza sativa&lt;/i&gt; encodes an &lt;i&gt;ent&lt;/i&gt;-copalyl diphosphate synthase (&lt;i&gt;ent&lt;/i&gt;-CPD synthase) |CITS:[15341631]|. This recombinant enzyme expressed as a GST-fusion in &lt;i&gt;E.coli&lt;/i&gt; was shown to convert geranylgeranyl diphosphate (GGDP) into &lt;i&gt;ent&lt;/i&gt;-copalyl diphosphate. Unlike the other |FRAME:MONOMER-7941 &lt;i&gt;ent&lt;/i&gt;-copalyl diphosphate synthase| encoded by OsCPS1, which is apparently involved in gibberellins biosynthesis, OsCyc2 is involved in phytoalexins biosynthesis |CITS:[15341631]|.</Comment>
      <Property key="UniqueID" value="CYC2-MONOMER" />
      <Property key="AlternativeId_Phytozome" value="Os02t0571100-01" />
      <Property key="AlternativeId_Interpro" value="IPR008949" />
      <Property key="AlternativeId_Pfam" value="PF03936" />
      <Property key="AlternativeId_Uniprot" value="Q68CL9" />
      <Property key="AlternativeId_Modbase" value="Q68CL9" />
      <Property key="AlternativeId_Swissmodel" value="Q68CL9" />
      <Property key="AlternativeId_Refseq" value="BAD42452" />
      <Property key="Synonym_1" value="&lt;i&gt;ent&lt;/i&gt;-CDP synthase" />
      <Property key="Catalyzes" value="RXN-6621" />
      <Property key="Accession1" value="Os02t0571100-01" />
