    <DataNode elementId="_5-HYDROXY-TRYPTOPHAN" textLabel="5-hydroxy-L-tryptophan" type="Metabolite">
      <Xref identifier="LDCYZAJDBXYCGN-VIFPVBQESA-N" dataSource="InChIKey" />
      <Graphics centerX="851.67529296875" centerY="837.3486328125" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, nilo-poyanco">5-hydroxy-L-tryptophan is the direct precusor of |FRAME: SEROTONIN|, and is sold as a dietary supplement.</Comment>
