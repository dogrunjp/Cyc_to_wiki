      <Property key="AlternativeId_Pubchem" value="25202940" />
      <Property key="AlternativeId_LigandCpd" value="C03541" />
      <Property key="Synonym_1" value="tetrahydropteroyl polyglutamate" />
      <Property key="Synonym_2" value="THF(glu)&lt;sub&gt;n&lt;/sub&gt;" />
      <Property key="Synonym_3" value="H&lt;sub&gt;4&lt;/sub&gt;PteGlu&lt;sub&gt;n&lt;/sub&gt;" />
