      <Property key="Synonym_2" value="a (4E)-sphing-4-enine ceramide" />
      <Property key="Synonym_3" value="a sphingosine ceramide" />
      <Property key="Synonym_4" value="an &lt;i&gt;N&lt;/i&gt;-acylsphing-4-enine" />
