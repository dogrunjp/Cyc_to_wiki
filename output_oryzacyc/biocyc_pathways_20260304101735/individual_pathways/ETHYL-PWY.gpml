      <Property key="MolecularWeight" value="173.102" />
      <Property key="MonoisotopicMw" value="174.0164379252" />
      <Property key="NonStandardInchi" value="InChI=1S/C6H6O6/c7-1-2(8)5-3(9)4(10)6(11)12-5/h2,5,7-8H,1H2/t2-,5+/m0/s1" />
