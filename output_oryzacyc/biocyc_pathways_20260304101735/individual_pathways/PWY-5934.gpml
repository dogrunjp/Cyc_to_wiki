    <DataNode elementId="Fe3-siderophores" textLabel="a siderophore-bound Fe(III)" type="Metabolite">
      <Xref identifier="5975" dataSource="ChEBI" />
      <Graphics centerX="1448.2218017578125" centerY="624.7098999023438" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang, SRI, caspi">This entry stands for siderophores-bound |FRAME: FE+3| cation(s). Siderophores are small, high-affinity iron chelating compounds secreted by microorganisms. Once outside the cell, siderophores bind |FRAME: FE+3| with high affinity, and the iron-siderophore complexes are imported back into the cell by active-transport mechanisms. Siderophores are very common in pathogenic bacteria, since iron in the host organism is usually tightly bound to proteins, resulting in an extremely low concentration of free iron in the blood. Most siderophores belong to one of three major groups: the |FRAME: Catecholate-siderophores &quot;catechols&quot;|, |FRAME: Hydroxamate-siderophores &quot;hydroxamates&quot;| and |FRAME: Thiazoline-siderophores &quot;thiazolines&quot;|. Some grasses are known to make siderophores as well. These |FRAME: Phytosiderophores &quot;phytosiderophores&quot;| are also known as mugineic acids.</Comment>
      <Property key="UniqueID" value="Fe3-siderophores" />
      <Property key="AlternativeId_Seed" value="cpd12891" />
      <Property key="AlternativeId_Metanetx" value="MNXM57745" />
      <Property key="AlternativeId_Chebi" value="5975" />
      <Property key="AlternativeId_LigandCpd" value="C06704" />
      <Property key="Synonym_1" value="an iron(III) chelate" />
      <Property key="Synonym_2" value="an Fe&lt;sup&gt;3+&lt;/sup&gt;-siderophore" />
      <Property key="Synonym_3" value="a ferric-siderophore complex" />
      <Property key="AtomCharges" value="(1 2)" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NonStandardInchi" value="InChI=1S/Fe.H/q+3;" />
      <Property key="Smiles" value="[Fe+2][a siderophore]" />
    </DataNode>
    <DataNode elementId="Fe2-siderophores" textLabel="a siderophore-bound Fe(II)" type="Metabolite">
      <Xref identifier="MNXM147434" dataSource="MetaNetX" />
      <Graphics centerX="886.9102783203125" centerY="703.9298095703125" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang, SRI, caspi">This entry stands for siderophores-bound |FRAME: FE+2| cation(s). Siderophores are small, high-affinity iron chelating compounds secreted by microorganisms. Once outside the cell, siderophores bind |FRAME: FE+3| with high affinity, and the iron-siderophore complexes are imported back into the cell by active-transport mechanisms. Siderophores are very common in pathogenic bacteria, since iron in the host organism is usually tightly bound to proteins, resulting in an extremely low concentration of free iron in the blood. Most siderophores belong to one of three major groups: the |FRAME: Catecholate-siderophores &quot;catechols&quot;|, |FRAME: Hydroxamate-siderophores &quot;hydroxamates&quot;| and |FRAME: Thiazoline-siderophores &quot;thiazolines&quot;|. Some grasses are known to make siderophores as well. These |FRAME: Phytosiderophores &quot;phytosiderophores&quot;| are also known as mugineic acids.</Comment>
      <Property key="UniqueID" value="Fe2-siderophores" />
