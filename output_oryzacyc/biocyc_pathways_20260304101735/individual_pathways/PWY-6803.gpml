      <Property key="N1Name" value="a fatty acid&lt;sub&gt;n-1&lt;/sub&gt;" />
      <Property key="NonStandardInchi" value="InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)/p-1" />
      <Property key="Smiles" value="C([R])([O-])=O" />
    </DataNode>
