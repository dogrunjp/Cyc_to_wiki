    <DataNode elementId="Omega-Hydroxy-long-Chain-Fatty-Acid" textLabel="an ω-hydroxy long-chain fatty acid" type="Metabolite">
      <Xref identifier="MNXM148065" dataSource="MetaNetX" />
      <Graphics centerX="200" centerY="680" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang, SRI, caspi">An &amp;omega;-hydroxy fatty acid is |FRAME: Fatty-Acids| with a hydroxy group at the end of the chain that is farthest from the carboxylated end. Fatty acids are often classified into four groups by their lengths: |FRAME: Short-chain-fatty-acids &quot;Short-chain fatty acids&quot;| (SCFA) are fatty acids with aliphatic chains of fewer than six carbons. |FRAME: Medium-chain-fatty-acids &quot;Medium-chain fatty acids&quot;| (MCFA) are fatty acids with aliphatic chain of 6-12 carbons. |FRAME: Long-Chain-Fatty-Acids &quot;Long-chain fatty acids&quot;| (LCFA) are fatty acids with aliphatic chains of 13-22 carbons. |FRAME: Very-long-chain-fatty-acids &quot;Very-long-chain fatty acids&quot;| (VLCFA) are fatty acids with aliphatic chains of 23 carbons or longer.</Comment>
      <Property key="UniqueID" value="Omega-Hydroxy-long-Chain-Fatty-Acid" />
      <Property key="AlternativeId_Metanetx" value="MNXM148065" />
      <Property key="AtomCharges" value="(4 -1)" />
      <Property key="HasNoStructure?" value="T" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NonStandardInchi" value="InChI=1S/C2H5O3/c3-1-6-2(4)5/h3H,1H2,(H,4,5)/p-1" />
      <Property key="Smiles" value="C(O)[R]C([O-])=O" />
    </DataNode>
