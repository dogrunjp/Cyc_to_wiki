    <DataNode elementId="CPD6666-1" textLabel="oleamide" type="Metabolite">
      <Xref identifier="FATBGEAMYMYZAF-KTKRTIGZSA-N" dataSource="InChIKey" />
      <Graphics centerX="500" centerY="400" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang">Oleamide is a sleep-inducing fatty acid amide produced from |FRAME: CPD-22243|. It accumulate in the cerebrospinal fluid during sleep deprivation |CITS: [7770779]|.</Comment>
