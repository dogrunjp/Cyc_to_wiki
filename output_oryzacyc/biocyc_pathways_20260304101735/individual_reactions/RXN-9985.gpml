    <DataNode elementId="Glycosides" textLabel="a glycoside" type="Metabolite">
      <Xref identifier="24400" dataSource="ChEBI" />
      <Graphics centerX="200" centerY="920" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="SRI, caspi">A glycoside is any molecule in which a sugar group is bonded through its anomeric carbon to a non-acyl group via a glycosidic bond. Glycosides can be linked by a C-O bond (an O-glycoside), C-N bond (a glycosylamine), C-S bond (a thioglycoside) or a C-C bond (a C-glycoside). When the sugar is bound to a non-carbohydrate moiety, the sugar group is known as the glycone and the non-sugar group as the aglycone or genin part of the glycoside.</Comment>
      <Property key="UniqueID" value="Glycosides" />
      <Property key="AlternativeId_Hmdb" value="HMDB31448" />
      <Property key="AlternativeId_Chebi" value="24400" />
      <Property key="AlternativeId_Metanetx" value="MNXM55409" />
      <Property key="HasNoStructure?" value="T" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
    </DataNode>
