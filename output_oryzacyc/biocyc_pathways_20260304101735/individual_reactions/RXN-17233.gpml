      <Property key="Synonym_1" value="(3R,4S,9R,11R)-27-(4-hydroxyphenyl)-3-methoxy-4-methylheptacosane-9,11-diol" />
      <Property key="ChemicalFormula" value="(C 35) (H 64) (O 4)" />
