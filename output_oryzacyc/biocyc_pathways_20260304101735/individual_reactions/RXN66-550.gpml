      <Property key="AlternativeId_Metanetx" value="MNXM176" />
      <Property key="AlternativeId_LigandCpd" value="C00399" />
      <Property key="AlternativeId_Chebi" value="16389" />
      <Property key="Synonym_1" value="coenzyme-Q&lt;SUB&gt;n&lt;/SUB&gt;" />
      <Property key="Synonym_2" value="ubiquinone" />
      <Property key="Synonym_3" value="Q" />
      <Property key="AbbrevName" value="UQ" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NonStandardInchi" value="InChI=1S/C14H18O4/c1-8(2)6-7-10-9(3)11(15)13(17-4)14(18-5)12(10)16/h6H,7H2,1-5H3" />
      <Property key="Smiles" value="C([R])C(\C)=C/CC1(\C(=O)C(\OC)=C(C(=O)C(/C)=1)\OC)" />
      <CitationRef elementRef="citation_PUB_16233343" />
    </DataNode>
