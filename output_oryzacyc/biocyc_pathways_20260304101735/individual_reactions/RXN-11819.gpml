      <Property key="AlternativeId_Seed" value="cpd00057" />
      <Property key="AlternativeId_Metanetx" value="MNXM94381" />
      <Property key="AlternativeId_Chebi" value="30879" />
      <Property key="AlternativeId_LigandCpd" value="C00069" />
      <Property key="Synonym_1" value="alcohol" />
      <Property key="Synonym_2" value="ROH" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NName" value="ROH" />
      <Property key="NonStandardInchi" value="InChI=1S/H2O/h1H2" />
