    <DataNode elementId="NEDD8-Activating-Enzyme-E1-L-cys" textLabel="an [E1 NEDD8-activating enzyme]-L-cysteine" type="Metabolite">
      <Graphics centerX="200" centerY="400" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, zhang, SRI, caspi">NEDD8-activating enzymes, also known as E1 enzymes, catalyze the first step in the neddylation process. The E1 enzyme, which is a herodimeric complex, binds ATP-Mg&lt;sup&gt;2+&lt;/sup&gt; and |FRAME: NEDD8| and catalyzes C-terminal acyl adenylation of NEDD8. A catalytic L-cysteine residue of the E1 enzyme then attacks the NEDD8-AMP complex through acyl substitution, creating a thioester bond and an AMP leaving group. This active form of NEDD8, bound to the E1 enzyme, is transferred to |FRAME: NEDD8-carrier-proteins-E2| through a transthioesterification reaction, in which an E2 catalytic L-cysteine attacks the backside of the E1-NEDD8 complex.</Comment>
      <Property key="UniqueID" value="NEDD8-Activating-Enzyme-E1-L-cys" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NName" value="protein cysteines" />
      <Property key="NonStandardInchi" value="InChI=1S/C3H7NOS/c4-3(1-5)2-6/h1,3,6H,2,4H2/t3-/m1/s1" />
      <Property key="Smiles" value="C(=O)([an [E1 NEDD8-activating enzyme]])[C@@H](N[an [E1 NEDD8-activating enzyme]])CS" />
    </DataNode>
    <DataNode elementId="S-NEDD8-yl-NEDD8-E1-L-cysteine" textLabel="an [E1 NEDD8-activating enzyme]-S-[NEDD8 protein]-yl-L-cysteine" type="Metabolite">
      <Graphics centerX="350" centerY="400" width="90.0" height="25.0" textColor="3955e7" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="3955e7" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="PMN, hawkins, SRI, caspi">NEDD8-activating enzymes, also known as E1 enzymes, catalyze the first step in the neddylation process. The E1 enzyme, which is a herodimeric complex, binds ATP-Mg&lt;sup&gt;2+&lt;/sup&gt; and |FRAME: NEDD8| and catalyzes C-terminal acyl adenylation of NEDD8. A catalytic L-cysteine residue of the E1 enzyme then attacks the NEDD8-AMP complex through acyl substitution, creating a thioester bond and an AMP leaving group. This active form of NEDD8, bound to the E1 enzyme, is transferred to |FRAME: NEDD8-carrier-proteins-E2| through a transthioesterification reaction, in which an E2 catalytic L-cysteine attacks the backside of the E1-NEDD8 complex.</Comment>
      <Property key="UniqueID" value="S-NEDD8-yl-NEDD8-E1-L-cysteine" />
      <Property key="InstanceNameTemplate" value="CPD-*" />
      <Property key="NName" value="protein cysteines" />
      <Property key="NonStandardInchi" value="InChI=1S/C5H10N2O2S/c6-1-5(9)10-3-4(7)2-8/h2,4H,1,3,6-7H2/t4-/m1/s1" />
      <Property key="Smiles" value="C(N[a NEDD8 protein])C(=O)SC[C@@H](C(=O)[an [E1 NEDD8-activating enzyme]])N[an [E1 NEDD8-activating enzyme]]" />
