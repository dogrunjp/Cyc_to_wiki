      <Property key="AlternativeId_Cas" value="70-18-8" />
      <Property key="Synonym_1" value="L-&amp;gamma;-glutamyl-L-cysteinylglycine" />
      <Property key="Synonym_2" value="GSH" />
      <Property key="Synonym_3" value="reduced glutathione" />
