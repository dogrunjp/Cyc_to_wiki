      <Property key="Synonym_3" value="{[(5aR,8R,9aR)-2-amino-4-oxo-6,7-di(sulfanyl-&amp;kappa;&lt;i&gt;S&lt;/i&gt;)-1,5,5a,8,9a,10-hexahydro-4H-pyrano[3,2-g]pteridin-8-yl]methyl dihydrogenato(2-) phosphate}(dioxo)molybdate" />
      <Property key="Synonym_4" value="MoO&lt;sub&gt;2&lt;/sub&gt;-molybdopterin cofactor" />
