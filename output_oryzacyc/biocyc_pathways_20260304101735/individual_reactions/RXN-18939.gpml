    <DataNode elementId="MONOMER-18621" textLabel="ent-isokaurene-C2-hydroxylase" type="Protein">
      <Xref identifier="A3A871" dataSource="uniprot" />
      <Graphics centerX="150" centerY="675" width="90.0" height="25.0" textColor="000000" fontName="Arial" fontWeight="Normal" fontStyle="Normal" fontDecoration="Normal" fontStrikethru="Normal" fontSize="12" hAlign="Center" vAlign="Middle" borderColor="000000" borderStyle="Solid" borderWidth="1.0" fillColor="FFFFFF" shapeType="Rectangle" />
      <Comment source="O-28, hartmut">The cDNA for a diterpene olefin 2&amp;alpha;-hydroxylase from &lt;i&gt;Oryza sativa&lt;/i&gt; has been codon optimized, N-terminally modified and expressed in &lt;i&gt;E. coli&lt;/i&gt;. The cytochrome P450 dependent monooxygenase (CYP71Z6) very specifically hydroxylates |FRAME:CPD-11534 &lt;i&gt;ent&lt;/i&gt;-isokaurene| at C-2&amp;alpha; forming the respective |FRAME:CPD-13920 &lt;i&gt;ent&lt;/i&gt;-2&amp;alpha;-hydroxyisokaurene| which is an presumed intermediate in |FRAME:PWY-7481 oryzalide A biosynthesis|. CYP71Z6 is considered an original gene recruited into the chromosome 2 biosynthetic gene cluster |CITS:[21985968]|. The proposed involvement of the gene in |FRAME:PWY-7481 oryzalide A biosynthesis| is supported by its co-regulation with the kaurene-synthase-like KSL6 which produces the precursor substrate for CYP71Z6 |CITS:[17634747]|.</Comment>
      <Property key="UniqueID" value="MONOMER-18621" />
      <Property key="AlternativeId_Phytozome" value="Os02t0570500-01" />
      <Property key="AlternativeId_Prosite" value="PS00086" />
      <Property key="AlternativeId_Prints" value="PR00463" />
      <Property key="AlternativeId_Pfam" value="PF00067" />
      <Property key="AlternativeId_Interpro" value="IPR001128" />
      <Property key="AlternativeId_Gene3D" value="1.10.630.10" />
      <Property key="AlternativeId_Uniprot" value="A3A871" />
      <Property key="AlternativeId_Pid" value="NP_001047187.1" />
      <Property key="Catalyzes" value="RXN-N7F-69378, RXN-22732" />
      <Property key="CatalyzesCount" value="2" />
      <Property key="Accession1" value="Os02t0570500-01" />
      <Property key="Gene" value="G-18086" />
      <Property key="InstanceNameTemplate" value="MONOMER-*" />
      <CitationRef elementRef="citation_PUB_21985968" />
